---
import Button from "../ui/Button.astro";
import { countries, statesByCountry, priorityCountryCodes } from "../../data/geo";

// Turnstile is optional at build time: without a site key the widget isn't
// rendered and the server skips verification, so local dev and preview deploys
// keep working before the Cloudflare keys exist.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";

// One form, four entry points. `interest` is what distinguishes an MDC1
// enrolment from an MDC3 one or a consultation booking: it is posted with the
// submission, shown to the visitor so they can see what they are signing up
// for, and put in the owner notification's subject line so enquiries can be
// triaged without opening them.
//
// Left undefined (the general /join/ page) the visitor picks from a select
// instead, so no one is ever forced to guess which form they landed on.
interface Props {
  interest?: "MDC1" | "MDC2" | "MDC3" | "CONSULTATION";
  /** Overrides the default submit-button text. */
  submitLabel?: string;
  /** Small print under the submit button. */
  footnote?: string;
}
const { interest, submitLabel, footnote } = Astro.props;

const INTEREST_LABELS: Record<string, string> = {
  MDC1: "MDC1 — Foundation Trader",
  MDC2: "MDC2 — Professional Trader",
  MDC3: "MDC3 — Elite Master Trader",
  CONSULTATION: "Free 1-hour consultation",
};
const interestLabel = interest ? INTEREST_LABELS[interest] : undefined;

const priority = priorityCountryCodes
  .map((code) => countries.find((c) => c.code === code))
  .filter(Boolean) as typeof countries;
const rest = countries.filter((c) => !priorityCountryCodes.includes(c.code));

const statesJson = JSON.stringify(statesByCountry);
---

<div id="register-root" class="flex flex-col gap-6">
  {/* Success panel, swapped in on a 200. The form is hidden rather than
      destroyed so it could be restored if a later step failed. */}
  <div id="register-success" class="hidden">
    <div class="surface-card-warm flex flex-col items-start gap-4 p-[clamp(1.5rem,3vw,2.5rem)]">
      <span class="flex h-14 w-14 items-center justify-center rounded-full bg-gold-500 text-ink-950">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="m5 12.5 4.5 4.5L19 7.5"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
      <h3 class="font-display text-[clamp(1.5rem,1.2rem+1.2vw,2.25rem)] font-medium leading-tight text-paper">
        You're registered
      </h3>
      <p class="max-w-md text-sm leading-relaxed text-paper/65">
        Check your inbox — we've sent a confirmation with what happens next. If it isn't there in
        a few minutes, look in your spam folder and mark it as safe so you don't miss our replies.
      </p>
    </div>
  </div>

  <form id="register-form" class="flex flex-col gap-4" novalidate>
    {/* Honeypot. Bots fill every field in the DOM; a person never sees this.
        Kept out of the accessibility tree and out of tab order.
        Named `mdfx_ref` rather than anything address-shaped — "company",
        "website" and "url" are textbook autofill-profile fields in Chrome,
        Safari, LastPass, 1Password and Dashlane, all of which ignore
        `autocomplete="off"` by design. A visitor with a saved "Company" value
        could have had it silently written into this field on page load,
        which flips isBot() true: they saw the success panel, but nothing was
        ever stored or emailed — indistinguishable from a broken form for
        anyone reporting it before the record was checked. */}
    <div class="absolute h-0 w-0 overflow-hidden" aria-hidden="true">
      <label>
        Leave this field blank
        <input type="text" name="mdfx_ref" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    {/* What this submission is for. A fixed hidden value on the dedicated
        MDC/consultation pages, a visible choice on the general one. */}
    {
      interest ? (
        <>
          <input type="hidden" name="interest" value={interest} />
          <div class="interest-banner">
            <span class="eyebrow text-gold-500">You're registering for</span>
            <p class="interest-banner__value">{interestLabel}</p>
          </div>
        </>
      ) : (
        <div class="field-row">
          <label class="field-label" for="rf-interest">
            What are you interested in? <span class="field-req">*</span>
          </label>
          <select id="rf-interest" name="interest" required class="field">
            <option value="CONSULTATION">Free 1-hour consultation</option>
            <option value="MDC1">MDC1 — Foundation Trader</option>
            <option value="MDC2">MDC2 — Professional Trader</option>
            <option value="MDC3">MDC3 — Elite Master Trader</option>
            <option value="GENERAL">Something else</option>
          </select>
          <span class="field-error hidden"></span>
        </div>
      )
    }

    {/* Step 1 — who you are.
        Labels sit above their field rather than floating inside it: with eight
        controls, a floating label leaves every empty field looking identical
        and the form reads as a wall of grey boxes. */}
    <fieldset class="form-step">
      <legend class="form-step__legend">
        <span class="form-step__num">01</span>
        Your details
      </legend>

      <div class="grid gap-x-5 gap-y-4 sm:grid-cols-2">
        <div class="field-row">
          <label class="field-label" for="rf-name">Full name <span class="field-req">*</span></label>
          <input type="text" id="rf-name" name="fullName" autocomplete="name" required
            class="field" placeholder="Your full name" />
          <span class="field-error hidden"></span>
        </div>

        <div class="field-row">
          <label class="field-label" for="rf-email">Email <span class="field-req">*</span></label>
          <input type="email" id="rf-email" name="email" autocomplete="email" required
            class="field" placeholder="you@example.com" />
          <span class="field-error hidden"></span>
        </div>

        <div class="field-row sm:col-span-2">
          <label class="field-label" for="rf-phone">
            Phone / WhatsApp <span class="field-req">*</span>
          </label>
          <input type="tel" id="rf-phone" name="phone" autocomplete="tel" required
            class="field" placeholder="+91 XXXXX XXXXX" />
          <span class="field-hint">We'll use this to reach you about your program.</span>
          <span class="field-error hidden"></span>
        </div>
      </div>
    </fieldset>

    {/* Step 2 — where you are. Drives session-time suggestions, so it's framed
        as useful rather than as bureaucratic data collection. */}
    <fieldset class="form-step">
      <legend class="form-step__legend">
        <span class="form-step__num">02</span>
        Where you're based
      </legend>

      <div class="grid gap-x-5 gap-y-4 sm:grid-cols-2">
        {/* Country — custom listbox over a real <select>. */}
        <div class="field-row">
          <label class="field-label" for="register-country">
            Country <span class="field-req">*</span>
          </label>
          <div class="select-shell" data-select data-searchable="true">
            <select class="select-native field" id="register-country" name="country" required>
              <option value="">Select your country</option>
              <optgroup label="Most common">
                {priority.map((c) => <option value={c.code}>{c.name}</option>)}
              </optgroup>
              <optgroup label="All countries">
                {rest.map((c) => <option value={c.code}>{c.name}</option>)}
              </optgroup>
            </select>
            <button type="button" class="select-button field" data-placeholder="true"
              aria-haspopup="listbox" aria-expanded="false">
              <span data-select-label>Select your country</span>
              <svg class="select-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.6"
                  stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
            {/* data-lenis-prevent: Lenis smooth-scroll captures every wheel event on
                the document, so without this the mouse wheel scrolled the page
                behind the open country list instead of the list itself — the list
                could only be moved by dragging its scrollbar. */}
            <div class="select-menu" role="listbox" tabindex="-1" data-lenis-prevent></div>
          </div>
          <span class="field-error hidden"></span>
        </div>

        <div class="field-row">
          <label class="field-label" for="register-state">
            State / Region <span class="field-req">*</span>
          </label>
          {/* Two controls, one shown at a time: the listbox for countries with a
              known subdivision list, a text input for the rest. Swapping to text
              keeps the real answer instead of discarding it as "Other". */}
          <div class="select-shell" data-select data-searchable="true" id="register-state-shell">
            <select class="select-native field" id="register-state" name="state" required disabled>
              <option value="">Select a country first</option>
            </select>
            <button type="button" class="select-button field" data-placeholder="true"
              aria-haspopup="listbox" aria-expanded="false" disabled>
              <span data-select-label>Select a country first</span>
              <svg class="select-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.6"
                  stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
            {/* data-lenis-prevent: Lenis smooth-scroll captures every wheel event on
                the document, so without this the mouse wheel scrolled the page
                behind the open country list instead of the list itself — the list
                could only be moved by dragging its scrollbar. */}
            <div class="select-menu" role="listbox" tabindex="-1" data-lenis-prevent></div>
          </div>
          <div class="hidden" id="register-state-text-group">
            <input type="text" id="rf-state-text" name="stateText" class="field"
              placeholder="Your state or region" />
          </div>
          <span class="field-error hidden"></span>
        </div>

        <div class="field-row sm:col-span-2">
          <label class="field-label" for="rf-city">City <span class="field-req">*</span></label>
          <input type="text" id="rf-city" name="city" autocomplete="address-level2" required
            class="field" placeholder="Your city" />
          <span class="field-error hidden"></span>
        </div>
      </div>
    </fieldset>

    {/* Consent — visually separated so it reads as a deliberate choice rather
        than another field to tab past. Required under the DPDP Act. */}
    <div class="consent-box">
      <label class="flex items-start gap-3 text-sm">
        <input type="checkbox" name="consent" value="yes" required class="checkbox mt-0.5" />
        {/* Explicit {" "} around the link: Astro collapses the surrounding
            newlines, which otherwise renders "thePrivacy Policyand". */}
        <span class="leading-relaxed text-paper/70">
          I agree that Money Door FX Academy may store the details above and contact me about its
          programs. I've read the{" "}
          <a href="/privacy-policy/" class="text-gold-400 underline underline-offset-2 hover:text-gold-300">
            Privacy Policy
          </a>{" "}
          and understand I can ask for my data to be deleted at any time.
          <span class="field-req">*</span>
        </span>
      </label>
      <span id="consent-error" class="field-error hidden"></span>
    </div>

    {turnstileSiteKey && (
      <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark" data-callback="mdfxTurnstileOk"></div>
    )}

    <p id="register-error" class="hidden text-sm leading-relaxed text-market-down" role="alert"></p>

    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6">
      <Button id="register-submit" type="submit" size="lg" class="w-full sm:w-auto" arrow>
        <span id="register-submit-label">{submitLabel ?? "Join Now"}</span>
      </Button>
      <p class="text-xs leading-relaxed text-paper/40">
        {footnote ?? "Free to join. No trading account is opened and no payment is taken."}
      </p>
    </div>
  </form>
</div>

{turnstileSiteKey && (
  <script is:inline async src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>
)}

<script define:vars={{ statesByCountry: JSON.parse(statesJson) }}>
  (function () {
    const form = document.getElementById("register-form");
    if (!form || form.dataset.bound) return;
    form.dataset.bound = "1";

    /* ---------------------------------------------------------------
       Custom select: an ARIA listbox layered over a real <select>.
       The <select> stays the source of truth — it's what the browser
       validates and what the form reads — so this only mirrors state.
       ---------------------------------------------------------------*/
    function initSelect(shell) {
      const native = shell.querySelector(".select-native");
      const button = shell.querySelector(".select-button");
      const menu = shell.querySelector(".select-menu");
      const labelEl = shell.querySelector("[data-select-label]");
      const searchable = shell.dataset.searchable === "true";
      let activeIndex = -1;
      let options = [];

      function currentPlaceholder() {
        return native.options[0]?.textContent || "Select";
      }

      // Rebuilt from the <select> each time it opens, so repopulating the
      // native element (as the country change does) needs no extra wiring.
      function buildMenu(filter) {
        const q = (filter || "").trim().toLowerCase();
        menu.innerHTML = "";
        options = [];

        if (searchable && native.options.length > 12) {
          const wrap = document.createElement("div");
          wrap.className = "select-search";
          const input = document.createElement("input");
          input.type = "text";
          input.className = "field";
          input.placeholder = "Type to filter…";
          input.value = filter || "";
          input.addEventListener("input", () => {
            buildMenu(input.value);
            const fresh = menu.querySelector(".select-search input");
            if (fresh) { fresh.focus(); fresh.setSelectionRange(fresh.value.length, fresh.value.length); }
          });
          input.addEventListener("keydown", (e) => {
            if (e.key === "ArrowDown") { e.preventDefault(); setActive(0); menu.focus(); }
            else if (e.key === "Escape") { e.preventDefault(); close(); button.focus(); }
            else if (e.key === "Enter") { e.preventDefault(); if (options.length) choose(options[0]); }
          });
          wrap.appendChild(input);
          menu.appendChild(wrap);
        }

        const addOption = (opt) => {
          if (!opt.value) return; // skip the placeholder entry
          if (q && !opt.textContent.toLowerCase().includes(q)) return;
          const b = document.createElement("button");
          b.type = "button";
          b.className = "select-option";
          b.role = "option";
          b.dataset.value = opt.value;
          b.textContent = opt.textContent;
          b.setAttribute("aria-selected", String(opt.value === native.value));
          b.addEventListener("click", () => choose(b));
          menu.appendChild(b);
          options.push(b);
        };

        Array.from(native.children).forEach((child) => {
          if (child.tagName === "OPTGROUP") {
            const before = options.length;
            const label = document.createElement("div");
            label.className = "select-group-label";
            label.textContent = child.label;
            menu.appendChild(label);
            Array.from(child.children).forEach(addOption);
            // Drop a group heading that filtered down to nothing.
            if (options.length === before) label.remove();
          } else {
            addOption(child);
          }
        });

        if (!options.length) {
          const empty = document.createElement("div");
          empty.className = "select-empty";
          empty.textContent = "No matches";
          menu.appendChild(empty);
        }
        activeIndex = -1;
      }

      function setActive(i) {
        options.forEach((o) => o.classList.remove("is-active"));
        if (i < 0 || i >= options.length) { activeIndex = -1; return; }
        activeIndex = i;
        options[i].classList.add("is-active");
        options[i].scrollIntoView({ block: "nearest" });
      }

      function syncLabel() {
        const has = !!native.value;
        labelEl.textContent = has
          ? native.options[native.selectedIndex].textContent
          : currentPlaceholder();
        button.dataset.placeholder = String(!has);
      }

      function choose(optEl) {
        native.value = optEl.dataset.value;
        // Programmatic .value assignment doesn't fire input events, and the
        // country→state wiring listens for `change`.
        native.dispatchEvent(new Event("change", { bubbles: true }));
        syncLabel();
        close();
        button.focus();
      }

      function open() {
        if (button.disabled) return;
        position();
        buildMenu("");
        shell.classList.add("is-open");
        button.setAttribute("aria-expanded", "true");
        const search = menu.querySelector(".select-search input");
        // Focusing the search box raises the on-screen keyboard, which halves
        // the visual viewport the menu was just measured against and buries
        // most of the list. On touch the list is browsable by thumb, so the
        // keyboard only appears if the user taps the search box themselves.
        const coarse = window.matchMedia("(pointer: coarse)").matches;
        if (search && !coarse) search.focus();
        else { menu.focus(); const sel = options.findIndex((o) => o.getAttribute("aria-selected") === "true"); setActive(sel >= 0 ? sel : 0); }
      }

      // Decides which way the menu opens and how tall it may be.
      //
      // The old version compared only `innerHeight - button.bottom` against a
      // hardcoded 300 and left the height at a fixed 17rem. Neither knows about
      // the sticky header, so flipping upward pushed the top of the list
      // underneath it — 19px on a phone at rest, and 94px once the keyboard was
      // up, all of it unreachable because the menu scrolls internally and the
      // header eats the drag. Measure both gaps for real and cap to whichever
      // side we open into.
      function position() {
        const r = button.getBoundingClientRect();
        const header = document.getElementById("site-header");
        const ceiling = header ? header.getBoundingClientRect().bottom : 0;
        const GAP = 12;
        const below = window.innerHeight - r.bottom - GAP;
        const above = r.top - ceiling - GAP;
        // Prefer opening downward while there's a reasonable amount of room;
        // only flip when the other side is genuinely roomier.
        const up = below < 220 && above > below;
        shell.classList.toggle("is-up", up);
        const space = Math.floor(up ? above : below);
        // Never exceed the space actually measured. An earlier version floored
        // this at 160px, which quietly reintroduced the original bug: with the
        // keyboard up there can be less than that on either side, and forcing
        // the height pushed the top of the list back under the header.
        // A short list that fits beats a tall one you can't reach.
        menu.style.maxHeight = Math.max(72, space) + "px";
      }

      // The keyboard appearing, an orientation change or the sticky header
      // condensing all move the goalposts while the menu is open. If the field
      // the menu is anchored to has itself been pushed out of the visible band,
      // no amount of repositioning helps — the menu is orphaned, so close it
      // rather than leave a list floating next to nothing.
      const reposition = () => {
        if (!shell.classList.contains("is-open")) return;
        const r = button.getBoundingClientRect();
        // Only when the field has left the viewport entirely. "Tucked under the
        // sticky header" is not orphaned — position() handles that by opening
        // downward instead, and closing on it would slam the menu shut during
        // ordinary scrolling.
        if (r.bottom < 0 || r.top > window.innerHeight) { close(); return; }
        position();
      };
      window.addEventListener("resize", reposition);
      window.addEventListener("scroll", reposition, { passive: true });
      if (window.visualViewport) window.visualViewport.addEventListener("resize", reposition);

      function close() {
        shell.classList.remove("is-open");
        button.setAttribute("aria-expanded", "false");
      }

      button.addEventListener("click", () => (shell.classList.contains("is-open") ? close() : open()));

      menu.addEventListener("keydown", (e) => {
        if (e.key === "ArrowDown") { e.preventDefault(); setActive(Math.min(activeIndex + 1, options.length - 1)); }
        else if (e.key === "ArrowUp") { e.preventDefault(); setActive(Math.max(activeIndex - 1, 0)); }
        else if (e.key === "Enter" || e.key === " ") { e.preventDefault(); if (activeIndex >= 0) choose(options[activeIndex]); }
        else if (e.key === "Escape") { e.preventDefault(); close(); button.focus(); }
        else if (e.key === "Home") { e.preventDefault(); setActive(0); }
        else if (e.key === "End") { e.preventDefault(); setActive(options.length - 1); }
      });

      button.addEventListener("keydown", (e) => {
        if (e.key === "ArrowDown" || e.key === "Enter" || e.key === " ") { e.preventDefault(); open(); }
      });

      // Escape handled on the shell so it works wherever focus sits inside —
      // the search input, the menu, or an option — rather than needing a
      // duplicate handler on each.
      shell.addEventListener("keydown", (e) => {
        if (e.key !== "Escape" || !shell.classList.contains("is-open")) return;
        e.preventDefault();
        e.stopPropagation();
        close();
        button.focus();
      });

      document.addEventListener("click", (e) => {
        if (!shell.contains(e.target)) close();
      });

      shell.__sync = syncLabel;
      syncLabel();
    }

    document.querySelectorAll("[data-select]").forEach(initSelect);

    /* ---- Country → state ------------------------------------------------ */
    const countrySel = document.getElementById("register-country");
    const stateSel = document.getElementById("register-state");
    const stateShell = document.getElementById("register-state-shell");
    const stateTextGroup = document.getElementById("register-state-text-group");
    const stateText = document.getElementById("rf-state-text");
    const stateBtn = stateShell.querySelector(".select-button");

    function syncStates() {
      const list = statesByCountry[countrySel.value];
      if (list && list.length) {
        stateSel.innerHTML =
          '<option value="">Select your state</option>' +
          list.map((s) => `<option value="${s}">${s}</option>`).join("");
        stateSel.disabled = false;
        stateSel.required = true;
        stateBtn.disabled = false;
        stateShell.classList.remove("hidden");
        stateTextGroup.classList.add("hidden");
        stateText.required = false;
        stateText.value = "";
      } else if (countrySel.value) {
        // No fixed list for this country — collect it as free text.
        stateSel.value = "";
        stateSel.disabled = true;
        stateSel.required = false;
        stateShell.classList.add("hidden");
        stateTextGroup.classList.remove("hidden");
        stateText.required = true;
      } else {
        stateSel.innerHTML = '<option value="">Select a country first</option>';
        stateSel.disabled = true;
        stateSel.required = true;
        stateBtn.disabled = true;
        stateShell.classList.remove("hidden");
        stateTextGroup.classList.add("hidden");
        stateText.required = false;
      }
      stateShell.__sync?.();
    }
    countrySel.addEventListener("change", syncStates);
    syncStates();

    /* ---- Errors --------------------------------------------------------- */
    const submit = document.getElementById("register-submit");
    const submitLabel = document.getElementById("register-submit-label");
    const formError = document.getElementById("register-error");
    const consentError = document.getElementById("consent-error");
    const successPanel = document.getElementById("register-success");

    function clearErrors() {
      form.querySelectorAll(".field-error").forEach((el) => {
        el.textContent = "";
        el.classList.add("hidden");
      });
      form.querySelectorAll('[aria-invalid="true"]').forEach((el) => el.removeAttribute("aria-invalid"));
      formError.textContent = "";
      formError.classList.add("hidden");
    }

    function showFieldError(name, message) {
      if (name === "consent") {
        consentError.textContent = message;
        consentError.classList.remove("hidden");
        return;
      }
      const field = form.querySelector(`[name="${name}"]`);
      if (!field) {
        formError.textContent = message;
        formError.classList.remove("hidden");
        return;
      }
      field.setAttribute("aria-invalid", "true");
      // Every control now lives in a .field-row that owns its own error slot,
      // so this is a single hop rather than the previous parentElement walk.
      const holder = field.closest(".field-row")?.querySelector(".field-error");
      if (holder) {
        holder.textContent = message;
        holder.classList.remove("hidden");
      } else {
        formError.textContent = message;
        formError.classList.remove("hidden");
      }
    }

    // Captured once at init, not hardcoded to "Join Now" — the per-program
    // pages (/join/mdc2/, etc.) render a custom label like "Enrol in MDC2 —
    // $300", and setBusy() was overwriting it back to the generic default on
    // every submit attempt, so a validation error on one of those pages
    // permanently lost the price-specific button text for that page view.
    const idleLabel = submitLabel.textContent;
    function setBusy(busy) {
      submit.disabled = busy;
      submit.setAttribute("aria-busy", String(busy));
      submitLabel.textContent = busy ? "Joining…" : idleLabel;
    }

    const turnstileConfigured = !!document.querySelector(".cf-turnstile[data-sitekey]");
    // Turnstile calls this once it has a token. Not required for the guard
    // above to work (it re-reads the hidden input directly), but keeps a
    // console-visible signal during setup/debugging.
    window.mdfxTurnstileOk = () => {};

    /* ---- Submit --------------------------------------------------------- */
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      clearErrors();

      // If the Turnstile widget is configured but hasn't produced a token —
      // script blocked by an ad blocker, still loading, or a site-key/secret-key
      // mismatch on the Cloudflare dashboard meaning the widget never renders —
      // the old code posted anyway and only found out from a vague server
      // error after the visitor had filled the whole form. Checking here turns
      // that into an immediate, specific, retryable message.
      if (turnstileConfigured) {
        const token = form.querySelector('[name="cf-turnstile-response"]')?.value;
        if (!token) {
          formError.textContent =
            "The security check hasn't finished loading yet. Please wait a moment and try again — if this keeps happening, disable any ad blocker for this site.";
          formError.classList.remove("hidden");
          return;
        }
      }

      setBusy(true);

      const fd = new FormData(form);
      const usingText = !stateTextGroup.classList.contains("hidden");
      const state = usingText ? String(fd.get("stateText") || "") : String(fd.get("state") || "");

      const payload = {
        interest: String(fd.get("interest") || "GENERAL"),
        fullName: String(fd.get("fullName") || "").trim(),
        email: String(fd.get("email") || "").trim(),
        phone: String(fd.get("phone") || "").trim(),
        country: String(fd.get("country") || ""),
        state: state.trim(),
        city: String(fd.get("city") || "").trim(),
        consent: fd.get("consent") === "yes",
        turnstileToken: String(fd.get("cf-turnstile-response") || ""),
        mdfx_ref: String(fd.get("mdfx_ref") || ""),
      };

      try {
        const res = await fetch("/api/register", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));

        if (res.ok && data.ok) {
          form.classList.add("hidden");
          successPanel.classList.remove("hidden");
          successPanel.scrollIntoView({ behavior: "smooth", block: "center" });
          return;
        }

        // Field errors render against their inputs; entered values are never
        // cleared, so nothing has to be retyped.
        if (data.fieldErrors && typeof data.fieldErrors === "object") {
          Object.entries(data.fieldErrors).forEach(([k, v]) => showFieldError(k, String(v)));
        }
        formError.textContent =
          data.message || "We couldn't complete your registration. Please check the form and try again.";
        formError.classList.remove("hidden");

        if (window.turnstile) window.turnstile.reset();
      } catch {
        formError.textContent =
          "We couldn't reach the server. Check your connection and try again — your details are still here.";
        formError.classList.remove("hidden");
      } finally {
        // Always runs, so the button can never be stranded mid-load.
        setBusy(false);
      }
    });
  })();
</script>
