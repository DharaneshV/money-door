---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";

const features = [
  { icon: "graduation-cap" as const, label: "Expert Training" },
  { icon: "chart-bar" as const, label: "Proven Strategies" },
  { icon: "video" as const, label: "Live Market Analysis" },
  { icon: "shield-check" as const, label: "Risk Management" },
];

// Candlestick bars for the decorative chart graphic — hand-set, not real data.
const candles = [
  { h: 38, up: false },
  { h: 58, up: true },
  { h: 46, up: false },
  { h: 72, up: true },
  { h: 64, up: true },
  { h: 88, up: true },
  { h: 76, up: true },
];
---

<section class="relative overflow-hidden border-b border-ink-700">
  <div
    class="pointer-events-none absolute -right-40 -top-40 h-[36rem] w-[36rem] rounded-full bg-gold-500/10 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <Container class="relative grid gap-14 py-16 lg:grid-cols-2 lg:items-center lg:py-24">
    <div class="flex flex-col gap-6">
      <span class="font-heading text-xs font-semibold uppercase tracking-[0.25em] text-gold-500">
        India's Trusted Gold &amp; Forex Trading Academy
      </span>
      <h1 class="font-heading text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl">
        Master Gold Trading with <span class="text-gold-500">Confidence</span>
      </h1>
      <p class="max-w-xl text-lg text-paper/70">
        Professional Gold (XAU/USD) &amp; Forex trading education designed to help traders develop
        discipline, manage risk, and build long-term consistency through structured learning and
        live market mentorship.
      </p>

      <div class="grid grid-cols-2 gap-4 pt-2 sm:grid-cols-4">
        {
          features.map((f) => (
            <div class="flex flex-col items-start gap-2">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-gold-500/10 text-gold-500">
                <Icon name={f.icon} class="h-5 w-5" />
              </span>
              <span class="text-xs font-medium text-paper/70">{f.label}</span>
            </div>
          ))
        }
      </div>

      <div class="flex flex-col gap-3 pt-4 sm:flex-row">
        <Button href="/courses/" size="lg" arrow>Explore Courses</Button>
        <Button href="/contact/" size="lg" variant="secondary">Book Free Consultation</Button>
      </div>
    </div>

    <div class="relative">
      <div
        class="relative flex h-72 items-end justify-center gap-3 rounded-3xl border border-ink-700 bg-ink-900 px-8 pb-8 pt-12 sm:h-96"
      >
        <span
          class="absolute left-6 top-6 font-heading text-xs font-semibold uppercase tracking-[0.2em] text-paper/40"
        >
          XAU/USD · Gold
        </span>
        {
          candles.map((c) => (
            <div
              class:list={[
                "w-6 rounded-sm sm:w-8",
                c.up ? "bg-market-up/80" : "bg-market-down/70",
              ]}
              style={`height: ${c.h}%`}
            />
          ))
        }
        <svg
          class="pointer-events-none absolute inset-x-6 bottom-10 top-14 h-auto w-[calc(100%-3rem)]"
          viewBox="0 0 300 160"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path
            d="M0 130 L45 108 L90 118 L135 70 L180 82 L225 34 L270 18"
            fill="none"
            stroke="#D6A31E"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </div>
      <div
        class="absolute -bottom-6 -left-6 rounded-2xl border border-gold-500/30 bg-ink-950 px-5 py-4 shadow-xl shadow-black/40"
      >
        <p class="font-heading text-2xl font-bold text-gold-400">18+ Yrs</p>
        <p class="text-xs text-paper/60">Chief Trainer's Market Experience</p>
      </div>
    </div>
  </Container>
</section>
