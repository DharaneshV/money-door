---
import { Image } from "astro:assets";
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import heroBull from "../../assets/brand/hero-gold-bull.png";
import { whatsappChannelUrl } from "../../data/site";

const features = [
  { icon: "graduation-cap" as const, label: "Expert Training" },
  { icon: "chart-bar" as const, label: "Proven Strategies" },
  { icon: "video" as const, label: "Live Market Analysis" },
  { icon: "shield-check" as const, label: "Risk Management" },
];
---

<section class="relative overflow-hidden border-b border-paper/12">
  <div
    class="pointer-events-none absolute -right-40 -top-40 h-[min(36rem,90vw)] w-[min(36rem,90vw)] rounded-full bg-gold-500/10 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <Container class="relative grid items-center gap-x-12 gap-y-12 py-16 lg:grid-cols-[1fr_1.05fr] lg:py-24">
    <div class="flex flex-col gap-6">
      <span class="font-heading text-xs font-semibold uppercase tracking-[0.25em] text-gold-500">
        India's Trusted
      </span>
      <h1 class="font-heading text-4xl font-bold leading-[1.1] sm:text-5xl lg:text-6xl">
        <span class="text-gold-500">Gold &amp; Forex</span><br />
        Trading Academy
      </h1>
      <p class="max-w-xl text-lg text-paper/70">
        Learn professional trading the smart way. Understand the market. Manage risk. Trade with
        confidence. Grow consistently.
      </p>

      <div class="grid grid-cols-2 gap-4 pt-2 sm:grid-cols-4">
        {
          features.map((f) => (
            <div class="flex flex-col items-start gap-2">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-gold-500/10 text-gold-500">
                <Icon name={f.icon} class="h-5 w-5" />
              </span>
              <span class="text-xs font-medium text-paper/70">{f.label}</span>
            </div>
          ))
        }
      </div>

      <div class="flex flex-col gap-3 pt-4 sm:flex-row">
        <Button href="/courses/" size="lg" arrow>Explore Courses</Button>
        <Button href={whatsappChannelUrl} target="_blank" size="lg" variant="secondary">
          Join WhatsApp
        </Button>
      </div>
    </div>

    <div class="hero-bull relative">
      <Image
        src={heroBull}
        alt="Gold bull statue set against a rising Gold (XAU/USD) candlestick chart"
        width={1530}
        height={990}
        sizes="(min-width: 1024px) 52vw, 92vw"
        class="h-auto w-full"
        loading="eager"
      />
      {/* No stat badge here on purpose — it overlapped the bull, and the
          TrustBar immediately below already carries "18+ Years". */}
    </div>
  </Container>
</section>

<style>
  /* The bull's own backdrop is near-black, so a soft radial mask melts its
     edges into the page instead of showing a hard rectangular seam. */
  .hero-bull :global(img) {
    -webkit-mask-image: radial-gradient(ellipse 68% 72% at 53% 50%, #000 40%, transparent 92%);
    mask-image: radial-gradient(ellipse 68% 72% at 53% 50%, #000 40%, transparent 92%);
  }
</style>
