---
import Container from "../ui/Container.astro";
import Pill from "../ui/Pill.astro";
import { heroBull, heroBullAlt } from "../../lib/heroBull";

// Restored from the client's approved mockup.
//
// COMPLIANCE: methodology/format only — never a return, win-rate or profit
// figure (see Pill.astro). "Structured Strategies" is used in place of the
// mockup's "Proven Strategies": "proven" asserts efficacy, which is the one
// claim this brand's own risk disclaimer explicitly refuses to make.
const pills = [
  { icon: "graduation-cap" as const, label: "Expert Training" },
  { icon: "target" as const, label: "Structured Strategies" },
  { icon: "chart-bar" as const, label: "Live Market Analysis" },
  { icon: "shield-check" as const, label: "Risk Management" },
];
---

<section
  {/* min-h subtracts the in-flow header (announce strip + gap + pill) so the
      first screen still fits without pushing the stats row below the fold. */}
  class="relative isolate flex min-h-[calc(96svh-7.5rem)] flex-col justify-between overflow-hidden border-b border-paper/12 pb-10 pt-[clamp(2rem,5vh,3.5rem)]"
>
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_at_62%_48%,rgba(214,163,30,0.13),transparent_62%)]"
    >
    </div>
  </div>

  <Container width="wide" class="relative">
    <p class="eyebrow text-gold-500" data-reveal>India's Trusted</p>
  </Container>

  <Container
    width="wide"
    class="relative grid flex-1 items-center gap-x-[clamp(1.5rem,4vw,4rem)] gap-y-8 py-[clamp(1.5rem,3vh,3rem)] lg:grid-cols-[1fr_1.1fr]"
  >
    <div class="flex flex-col">
      {/* Column-scoped size: the full `display` tier is built for full-bleed
          headings and wraps to four lines inside a two-column hero. */}
      <h1
        class="font-display text-[clamp(2.5rem,1.5rem+4.2vw,5.25rem)] font-medium leading-[0.98] tracking-[-0.015em] text-paper"
        data-reveal-lines
      >
        <span class="reveal-line"><span class="text-gold-500">Gold &amp; Forex</span></span>
        <span class="reveal-line"><span>Trading Academy</span></span>
      </h1>
      <p class="mt-8 max-w-lg text-base leading-relaxed text-paper/60 sm:text-lg" data-reveal>
        Learn professional trading the smart way. Understand the market. Manage risk. Trade with
        confidence. Grow consistently.
      </p>

      <div class="mt-8 flex flex-wrap gap-2" data-reveal-stagger>
        {pills.map((p) => <Pill icon={p.icon}>{p.label}</Pill>)}
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-x-10 gap-y-4" data-reveal>
        <a
          href="/courses/"
          class="group inline-flex items-center gap-3 border border-gold-500 px-8 py-4 font-heading text-xs font-semibold uppercase tracking-[0.18em] text-gold-400 transition-colors duration-300 hover:bg-gold-500 hover:text-ink-950"
        >
          Explore Courses
          <svg
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            class="transition-transform duration-500 group-hover:translate-x-1.5"
            aria-hidden="true"
          >
            <path
              d="M3.5 8h9M8.5 3.5 13 8l-4.5 4.5"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
        <a
          href="/join/"
          class="inline-flex items-center font-heading text-xs font-semibold uppercase tracking-[0.18em] text-paper transition-colors hover:text-gold-400"
        >
          <span class="link-underline">Book Free Consultation</span>
        </a>
      </div>
    </div>

    <div class="hero-bull relative order-first lg:order-none">
      {/* Plain <img> off the shared resolved asset rather than <Image>, so the
          intro overlay and the hero request the exact same URL — one download,
          and the intro's preload doubles as the hero's. */}
      <img
        src={heroBull.src}
        width={heroBull.attributes.width}
        height={heroBull.attributes.height}
        alt={heroBullAlt}
        class="hero-bull__img h-auto w-full"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </Container>

  <Container width="wide" class="relative">
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-8">
      <div class="hidden items-center gap-4 sm:flex" data-reveal>
        <span class="scroll-cue__line" aria-hidden="true"></span>
        <span class="eyebrow text-paper/40">Scroll to explore</span>
      </div>
      {/* pr-* keeps the last stat clear of the floating WhatsApp button, which
          sits fixed in the bottom-right corner across the whole site. */}
      <dl
        class="flex w-full items-end justify-between gap-x-[clamp(1rem,3vw,3rem)] sm:w-auto sm:justify-end sm:pr-20"
        data-reveal-stagger
      >
        {
          [
            { to: 18, suffix: "+", label: "Years" },
            { to: 2500, suffix: "+", label: "Students" },
            { to: 3, suffix: "", label: "Programs" },
          ].map((s) => (
            <div class="sm:text-right">
              <dt class="font-display text-[clamp(1.4rem,1rem+1.5vw,2.25rem)] font-medium leading-none tabular-nums text-gold-400">
                <span data-count-to={s.to} data-count-suffix={s.suffix}>
                  0
                </span>
              </dt>
              <dd class="eyebrow mt-2 whitespace-nowrap text-paper/40">{s.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Container>
</section>

<style>
  /* The bull's own backdrop is near-black, so a soft radial mask melts its
     edges into the page instead of showing a hard rectangular seam. */
  .hero-bull :global(.hero-bull__img) {
    -webkit-mask-image: radial-gradient(ellipse 68% 72% at 53% 50%, #000 40%, transparent 92%);
    mask-image: radial-gradient(ellipse 68% 72% at 53% 50%, #000 40%, transparent 92%);
  }

  /* Lift-up entrance: the bull rises into frame and settles, then breathes with
     a slow float so the hero never feels completely static. Two nested elements
     would be needed to run both at once on `transform`, so the entrance runs on
     the wrapper and the idle float on the image itself. */
  .js .hero-bull {
    animation: bull-lift 1.5s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
  }
  @keyframes bull-lift {
    from {
      opacity: 0;
      transform: translateY(9%) scale(0.94);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .js .hero-bull :global(.hero-bull__img) {
    animation: bull-float 7s ease-in-out 1.7s infinite;
  }
  @keyframes bull-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-1.6%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .js .hero-bull,
    .js .hero-bull :global(.hero-bull__img) {
      animation: none;
    }
  }
</style>
