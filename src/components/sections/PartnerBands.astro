---
import Container from "../ui/Container.astro";
import PartnerLogo from "../ui/PartnerLogo.astro";
import { partnerDisclosure, type Partner } from "../../data/site";

// Full-width alternating partner bands, separated by a hairline gradient rule
// rather than card borders — a grid of equal cards is exactly what makes a
// page like this read as templated.
//
// Shared by /partnerships/ (all partners, grouped under headings) and each
// /partnerships/<group>/ page (one group, no heading). Extracted so the CTA
// markup — which carries the rel="sponsored" and the FTC disclosure — exists
// in exactly one place and can't drift between the two.
interface Props {
  /** Groups to render. A single-entry array with `showHeading` off gives the
      filtered category pages. */
  groups: { label: string; items: Partner[] }[];
  showHeadings?: boolean;
}
const { groups, showHeadings = true } = Astro.props;
---

<section class="surface-ink">
  {(() => {
    // The left/right alternation runs continuously across the whole page
    // rather than resetting at each group boundary.
    let globalIndex = -1;
    return groups.map(({ label, items }) => (
      <>
        {showHeadings && (
          <Container width="wide">
            <div class="flex items-center gap-4 pt-[clamp(3rem,6vw,5rem)]" data-reveal>
              <span class="eyebrow flex-none text-gold-500">{label}</span>
              <span class="h-px flex-1 bg-paper/12" aria-hidden="true" />
            </div>
          </Container>
        )}

        {items.map((p) => {
          globalIndex++;
          const i = globalIndex;
          return (
            <article class="partner-band" data-reveal>
              <Container width="wide">
                <div class="grid items-center gap-x-[clamp(2rem,6vw,6rem)] gap-y-8 py-[clamp(3.5rem,7vw,6rem)] lg:grid-cols-[1fr_1fr]">
                  {/* Order flips on alternating rows at lg; on mobile
                      everything stacks in source order so the name always
                      precedes its copy. */}
                  <div class:list={[i % 2 === 1 && "lg:order-2"]}>
                    {/* block, so the logo drops onto its own line rather than
                        sitting inline beside the category label. */}
                    <span class="eyebrow block text-gold-500">{p.category}</span>
                    <PartnerLogo name={p.name} slug={p.slug} class="mt-6 block" />
                    <h2 class="mt-5 font-display text-[clamp(2rem,1.5rem+2.2vw,3.5rem)] font-medium leading-[1.02] tracking-[-0.015em] text-paper">
                      {p.name}
                    </h2>
                  </div>

                  <div class:list={["flex flex-col gap-7", i % 2 === 1 && "lg:order-1"]}>
                    <p class="max-w-xl text-base leading-relaxed text-paper/65 sm:text-lg">
                      {p.blurb}
                    </p>

                    <ul class="flex flex-wrap gap-2">
                      {p.pills.map((label) => (
                        <li class="pill">{label}</li>
                      ))}
                    </ul>

                    <div class="flex flex-col gap-3">
                      {/* rel="sponsored" marks this as paid placement to search
                          engines; noopener/noreferrer close the tab-nabbing
                          hole target="_blank" otherwise opens. */}
                      <a
                        href={p.href}
                        target="_blank"
                        rel="sponsored noopener noreferrer"
                        data-partner={p.name}
                        class="partner-cta btn-shine group inline-flex w-fit items-center gap-3 rounded-full border border-gold-500 px-8 py-4 font-heading text-xs font-semibold uppercase tracking-[0.18em] text-gold-400 transition-colors duration-300 hover:bg-gold-500 hover:text-ink-950"
                      >
                        Visit {p.name}
                        <svg
                          width="14"
                          height="14"
                          viewBox="0 0 16 16"
                          fill="none"
                          class="transition-transform duration-500 group-hover:translate-x-1"
                          aria-hidden="true"
                        >
                          <path
                            d="M4 12 12 4M5.5 4H12v6.5"
                            stroke="currentColor"
                            stroke-width="1.4"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                        <span class="sr-only">(opens in a new tab)</span>
                      </a>

                      {/* FTC guidance requires the disclosure to sit with the
                          link itself, not in a page footer. Most affiliate
                          terms void the payout without it. */}
                      <p class="text-xs leading-relaxed text-paper/45">{partnerDisclosure}</p>
                    </div>
                  </div>
                </div>
              </Container>
            </article>
          );
        })}
      </>
    ));
  })()}
</section>

<script>
  // Referral-click tracking. Fires `partner_click` with the partner name so the
  // owner can see which links actually convert rather than guessing.
  //
  // Deliberately provider-agnostic: it pushes to whichever of dataLayer /
  // gtag / plausible happens to be present and silently does nothing if none
  // are. No analytics vendor is installed on the site yet, so hard-wiring one
  // here would just throw on every click.
  function initPartnerTracking() {
    document.querySelectorAll<HTMLAnchorElement>(".partner-cta").forEach((el) => {
      if (el.dataset.tracked) return;
      el.dataset.tracked = "1";

      el.addEventListener("click", () => {
        const partner = el.dataset.partner || "unknown";
        const w = window as any;
        try {
          if (Array.isArray(w.dataLayer)) w.dataLayer.push({ event: "partner_click", partner });
          if (typeof w.gtag === "function") w.gtag("event", "partner_click", { partner });
          if (typeof w.plausible === "function") w.plausible("partner_click", { props: { partner } });
        } catch {
          /* tracking must never block the outbound navigation */
        }
      });
    });
  }

  initPartnerTracking();
  document.addEventListener("astro:page-load", initPartnerTracking);
</script>
