---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
---

<section class="bg-paper py-16 sm:py-20">
  <Container class="grid gap-10 lg:grid-cols-2 lg:items-center">
    <div class="flex flex-col gap-4">
      <span class="font-heading text-xs font-semibold uppercase tracking-[0.2em] text-gold-700">
        About Money Door FX Academy
      </span>
      <h2 class="font-heading text-3xl font-bold text-ink-950 sm:text-4xl">
        Trading Education Built Around Discipline
      </h2>
      <p class="text-base leading-relaxed text-ink-700">
        Money Door FX Academy is committed to helping aspiring traders build strong foundations in
        Gold and Forex trading. Our structured programs combine market knowledge, technical
        analysis, practical trading sessions, and disciplined risk management to help students
        become confident decision-makers.
      </p>
      <p class="text-base leading-relaxed text-ink-700">
        Rather than focusing on shortcuts or unrealistic expectations, we emphasize education,
        consistency, and continuous improvement.
      </p>
      <div>
        <Button href="/about/" variant="secondary-light" arrow>Read More</Button>
      </div>
    </div>

    <dl class="grid grid-cols-2 gap-4">
      {
        [
          ["18+", "Years of combined trading experience"],
          ["2,500+", "Students trained"],
          ["3", "Structured program levels — MDC1 to MDC3"],
          ["2", "Core strategies — PR & PC methodology"],
        ].map(([value, label]) => (
          <div class="rounded-2xl border border-ink-950/10 bg-white p-6 shadow-sm">
            <dt class="font-heading text-2xl font-bold text-gold-700">{value}</dt>
            <dd class="mt-1 text-sm text-ink-700">{label}</dd>
          </div>
        ))
      }
    </dl>
  </Container>
</section>
