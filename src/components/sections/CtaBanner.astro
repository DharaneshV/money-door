---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Build Your Trading Skills with Confidence",
  description = "Join Money Door FX Academy and learn professional trading through structured education, live market sessions, and disciplined risk management.",
} = Astro.props;
---

<section class="relative overflow-hidden bg-ink-900 py-16 sm:py-20">
  <div
    class="pointer-events-none absolute left-1/2 top-0 h-72 w-[42rem] -translate-x-1/2 rounded-full bg-gold-500/10 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <Container class="relative flex flex-col items-center gap-6 text-center">
    <span class="font-heading text-xs font-semibold uppercase tracking-[0.25em] text-gold-500">
      Ready to Start Your Trading Journey?
    </span>
    <h2 class="max-w-2xl font-heading text-3xl font-bold sm:text-4xl">{title}</h2>
    <p class="max-w-xl text-base text-paper/70">{description}</p>
    <div class="flex flex-col gap-3 pt-2 sm:flex-row">
      <Button href="/courses/" size="lg" arrow>Explore Courses</Button>
      <Button href="/contact/" size="lg" variant="secondary">Book Free Consultation</Button>
    </div>
  </Container>
</section>
