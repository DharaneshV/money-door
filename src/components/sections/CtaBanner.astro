---
import Container from "../ui/Container.astro";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Build Your Trading Skills with Confidence",
  description = "Join Money Door FX Academy and learn professional trading through structured education, live market sessions, and disciplined risk management.",
} = Astro.props;
---

<section class="relative isolate overflow-hidden border-t border-paper/10 bg-ink-950 py-section">
  <div
    class="pointer-events-none absolute left-1/2 top-0 h-[28rem] w-[min(60rem,120vw)] -translate-x-1/2 -translate-y-1/2 rounded-full bg-gold-500/8 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <Container width="wide" class="relative flex flex-col items-center text-center" data-reveal>
    <span class="eyebrow text-gold-500">Ready to Start?</span>
    <h2 class="display mt-8 max-w-4xl text-balance text-paper">{title}</h2>
    <p class="mt-8 max-w-xl text-base leading-relaxed text-paper/60">{description}</p>
    <div class="mt-12 flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
      <a
        href="/courses/"
        class="group inline-flex items-center gap-3 border border-gold-500 px-8 py-4 font-heading text-xs font-semibold uppercase tracking-[0.18em] text-gold-400 transition-colors duration-300 hover:bg-gold-500 hover:text-ink-950"
      >
        Explore Courses
        <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          class="transition-transform duration-500 group-hover:translate-x-1.5"
          aria-hidden="true"
        >
          <path
            d="M3.5 8h9M8.5 3.5 13 8l-4.5 4.5"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
      <a
        href="/join/"
        class="inline-flex items-center font-heading text-xs font-semibold uppercase tracking-[0.18em] text-paper transition-colors hover:text-gold-400"
      >
        <span class="link-underline">Book a Free Consultation</span>
      </a>
    </div>
  </Container>
</section>
