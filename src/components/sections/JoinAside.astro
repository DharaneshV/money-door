---
import Icon from "../ui/Icon.astro";
import { contact, whatsappHref, whatsappChannelUrl, socials } from "../../data/site";

// The contact / WhatsApp / socials column beside every enrolment form.
// Extracted from join.astro so the four dedicated program forms don't each
// carry their own copy of it — one edit to a phone number or a social handle
// now updates all five pages.
const socialIcon: Record<string, string> = {
  youtube:
    "M21.8 8.1a2.8 2.8 0 0 0-2-2C18.1 5.6 12 5.6 12 5.6s-6.1 0-7.8.5a2.8 2.8 0 0 0-2 2A29 29 0 0 0 1.7 12a29 29 0 0 0 .5 3.9 2.8 2.8 0 0 0 2 2c1.7.5 7.8.5 7.8.5s6.1 0 7.8-.5a2.8 2.8 0 0 0 2-2 29 29 0 0 0 .5-3.9 29 29 0 0 0-.5-3.9ZM9.9 15.2V8.8l5.4 3.2-5.4 3.2Z",
  instagram:
    "M12 2c2.7 0 3.06.01 4.12.06 1.06.05 1.79.22 2.43.47.66.26 1.21.6 1.76 1.15.5.5.9 1.1 1.15 1.76.25.64.42 1.37.47 2.43.05 1.06.06 1.42.06 4.12s-.01 3.06-.06 4.12c-.05 1.06-.22 1.79-.47 2.43a4.9 4.9 0 0 1-1.15 1.76 4.9 4.9 0 0 1-1.76 1.15c-.64.25-1.37.42-2.43.47-1.06.05-1.42.06-4.12.06s-3.06-.01-4.12-.06c-1.06-.05-1.79-.22-2.43-.47a4.9 4.9 0 0 1-1.76-1.15 4.9 4.9 0 0 1-1.15-1.76c-.25-.64-.42-1.37-.47-2.43C2.01 15.06 2 14.7 2 12s.01-3.06.06-4.12c.05-1.06.22-1.79.47-2.43.26-.66.6-1.21 1.15-1.76A4.9 4.9 0 0 1 5.44 2.53c.64-.25 1.37-.42 2.43-.47C8.94 2.01 9.3 2 12 2Zm0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4Zm5.2-8.4a1.17 1.17 0 1 1-2.34 0 1.17 1.17 0 0 1 2.34 0Z",
  facebook:
    "M13.5 21v-8h2.7l.4-3.1h-3.1V8c0-.9.25-1.5 1.55-1.5H16.7V3.7c-.28-.04-1.24-.12-2.36-.12-2.33 0-3.93 1.42-3.93 4.03V9.9H8v3.1h2.4v8h3.1Z",
  telegram:
    "M21.6 4.2 2.9 11.5c-1.28.5-1.27 1.2-.23 1.52l4.8 1.5 1.86 5.66c.22.6.4.85.83.85.36 0 .55-.16.8-.4l1.9-1.85 4.02 2.97c.74.41 1.27.2 1.46-.68l2.63-12.4c.28-1.16-.4-1.66-1.35-1.4Z",
  x: "M17.53 3h3.02l-6.6 7.54L21.75 21h-6.06l-4.75-6.2L5.5 21H2.47l7.06-8.07L2.25 3h6.22l4.29 5.67L17.53 3Zm-1.06 16.16h1.67L7.6 4.75H5.8l10.67 14.41Z",
  linkedin:
    "M6.94 8.5H3.56V20.4h3.38V8.5ZM5.25 3.6a1.96 1.96 0 1 0 0 3.92 1.96 1.96 0 0 0 0-3.92ZM20.45 20.4h-3.37v-6.2c0-1.48-.03-3.38-2.06-3.38-2.07 0-2.39 1.62-2.39 3.28v6.3H9.27V8.5h3.24v1.63h.05c.45-.85 1.56-1.75 3.2-1.75 3.43 0 4.06 2.26 4.06 5.19v6.83Z",
};
---

<div class="flex flex-col gap-6">
  <div class=" surface-card p-6">
    <h3 class="font-heading text-lg font-bold text-paper">Contact Details</h3>
    <div class="mt-4 flex flex-col gap-4">
      <a href={`tel:+${contact.primaryPhoneE164}`} class="flex items-start gap-3 text-sm text-paper/75 hover:text-gold-300 max-sm:min-h-11">
        <Icon name="phone" class="mt-0.5 h-5 w-5 flex-none text-gold-500" />
        <span>
          {contact.primaryPhoneDisplay}
          <br />
          {contact.secondaryPhoneDisplay}
        </span>
      </a>
      <a href={`mailto:${contact.email}`} class="flex items-start gap-3 text-sm text-paper/75 hover:text-gold-300 max-sm:min-h-11">
        <Icon name="mail" class="mt-0.5 h-5 w-5 flex-none text-gold-500" />
        <span>{contact.email}</span>
      </a>
      <div class="flex items-start gap-3 text-sm text-paper/75">
        <Icon name="map-pin" class="mt-0.5 h-5 w-5 flex-none text-gold-500" />
        <span>{contact.addressLine}</span>
      </div>
    </div>
  </div>

  <a
    href={whatsappHref}
    target="_blank"
    rel="noopener noreferrer"
    class="card-lift flex items-center gap-3  border border-[#25D366]/30 bg-[#25D366]/10 p-6 hover:border-[#25D366]/60 hover:bg-[#25D366]/15"
  >
    <span class="icon-pop flex h-11 w-11 flex-none items-center justify-center rounded-full bg-[#25D366] text-white">
      <Icon name="message-circle" class="h-5 w-5" />
    </span>
    <span>
      <span class="block font-heading text-sm font-bold text-paper">Chat on WhatsApp</span>
      <span class="block text-xs text-paper/60">Usually replies within a day</span>
    </span>
  </a>

  <a
    href={whatsappChannelUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="card-lift flex items-center gap-3  border border-gold-500/30 bg-gold-500/5 p-6 hover:border-gold-500/60 hover:bg-gold-500/10"
  >
    <span class="icon-pop flex h-11 w-11 flex-none items-center justify-center rounded-full bg-gold-500 text-ink-950">
      <Icon name="trending-up" class="h-5 w-5" />
    </span>
    <span>
      <span class="block font-heading text-sm font-bold text-paper">Join Our WhatsApp Channel</span>
      <span class="block text-xs text-paper/60">Market updates & academy announcements</span>
    </span>
  </a>

  {
    socials.some((s) => s.url) && (
      <div class=" surface-card p-6">
        <h3 class="font-heading text-lg font-bold text-paper">Follow Us</h3>
        <div class="mt-4 flex gap-3">
          {socials
            .filter((s) => s.url)
            .map((s) => (
              <a
                href={s.url as string}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.name}
                class="flex h-10 w-10 items-center justify-center rounded-full border border-paper/12 text-paper/70 hover:border-gold-500 hover:text-gold-400"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={socialIcon[s.icon]} />
                </svg>
              </a>
            ))}
        </div>
      </div>
    )
  }
</div>
