---
import Icon from "../ui/Icon.astro";
import SocialLinks from "../ui/SocialLinks.astro";
import { contact, whatsappHref, whatsappChannelUrl, socials } from "../../data/site";

// The contact / WhatsApp / socials column beside every enrolment form.
// Extracted from join.astro so the four dedicated program forms don't each
// carry their own copy of it — one edit to a phone number or a social handle
// now updates all five pages.
---

<div class="flex flex-col gap-6">
  <div class=" surface-card p-6">
    <h3 class="font-heading text-lg font-bold text-paper">Contact Details</h3>
    <div class="mt-4 flex flex-col gap-4">
      <a href={`tel:+${contact.primaryPhoneE164}`} class="flex items-start gap-3 text-sm text-paper/75 hover:text-gold-300 max-sm:min-h-11">
        <Icon name="phone" class="mt-0.5 h-5 w-5 flex-none text-gold-500" />
        <span>
          {contact.primaryPhoneDisplay}
          <br />
          {contact.secondaryPhoneDisplay}
        </span>
      </a>
      <a href={`mailto:${contact.email}`} class="flex items-start gap-3 text-sm text-paper/75 hover:text-gold-300 max-sm:min-h-11">
        <Icon name="mail" class="mt-0.5 h-5 w-5 flex-none text-gold-500" />
        <span>{contact.email}</span>
      </a>
      <a
        href={contact.mapsHref}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-start gap-3 text-sm text-paper/75 transition-colors hover:text-gold-300 max-sm:min-h-11"
      >
        <Icon name="map-pin" class="mt-0.5 h-5 w-5 flex-none text-gold-500" />
        <span>
          {contact.address.name}<br />
          {contact.address.line1}<br />
          {contact.address.line2}<br />
          {contact.address.city}, {contact.address.region} {contact.address.postalCode}
        </span>
      </a>
    </div>
  </div>

  <a
    href={whatsappHref}
    target="_blank"
    rel="noopener noreferrer"
    class="card-lift flex items-center gap-3  border border-[#25D366]/30 bg-[#25D366]/10 p-6 hover:border-[#25D366]/60 hover:bg-[#25D366]/15"
  >
    <span class="icon-pop flex h-11 w-11 flex-none items-center justify-center rounded-full bg-[#25D366] text-white">
      <Icon name="message-circle" class="h-5 w-5" />
    </span>
    <span>
      <span class="block font-heading text-sm font-bold text-paper">Chat on WhatsApp</span>
      <span class="block text-xs text-paper/60">Usually replies within a day</span>
    </span>
  </a>

  <a
    href={whatsappChannelUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="card-lift flex items-center gap-3  border border-gold-500/30 bg-gold-500/5 p-6 hover:border-gold-500/60 hover:bg-gold-500/10"
  >
    <span class="icon-pop flex h-11 w-11 flex-none items-center justify-center rounded-full bg-gold-500 text-ink-950">
      <Icon name="trending-up" class="h-5 w-5" />
    </span>
    <span>
      <span class="block font-heading text-sm font-bold text-paper">Join Our WhatsApp Channel</span>
      <span class="block text-xs text-paper/60">Market updates & academy announcements</span>
    </span>
  </a>

  {
  socials.some((s) => s.url) && (
    <div class="surface-card p-6">
      <h3 class="font-heading text-lg font-bold text-paper">Follow Us</h3>
      <div class="mt-4">
        <SocialLinks tone="brand" />
      </div>
    </div>
  )
}
</div>
