---
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Icon from "../ui/Icon.astro";

const rows = [
  ["Signal Dependency", "Independent Learning"],
  ["Random Entries", "Structured Strategies"],
  ["Emotion-Driven Trading", "Rule-Based Trading"],
  ["Profit Focus", "Process Focus"],
  ["No Risk Management", "Capital Protection"],
  ["Theory Only", "Practical Live Sessions"],
];
---

<section class="bg-ink-950 py-16 sm:py-20">
  <Container class="flex flex-col gap-10">
    <SectionHeading eyebrow="What Makes Us Different" title="Others vs. Money Door FX Academy" />

    <div class="mx-auto grid w-full max-w-3xl overflow-hidden rounded-2xl border border-ink-700">
      <div class="grid grid-cols-2 bg-ink-900">
        <div class="px-6 py-4 text-center font-heading text-sm font-semibold text-paper/50">
          Others
        </div>
        <div class="px-6 py-4 text-center font-heading text-sm font-semibold text-gold-400">
          Money Door FX Academy
        </div>
      </div>
      {
        rows.map((row, i) => (
          <div class:list={["grid grid-cols-2", i % 2 === 1 && "bg-ink-900/40"]}>
            <div class="flex items-center justify-center gap-2 px-6 py-4 text-center text-sm text-paper/50">
              <Icon name="x-circle" class="h-4 w-4 flex-none text-paper/30" />
              {row[0]}
            </div>
            <div class="flex items-center justify-center gap-2 border-l border-ink-700 px-6 py-4 text-center text-sm font-medium text-paper">
              <Icon name="check-circle" class="h-4 w-4 flex-none text-gold-500" />
              {row[1]}
            </div>
          </div>
        ))
      }
    </div>

    <p class="mx-auto max-w-2xl text-center text-base leading-relaxed text-paper/60">
      Unlike platforms that focus primarily on signals or short-term opportunities, we focus on
      helping students understand why markets move, how to identify quality trading
      opportunities, how to manage risk responsibly, and how to develop a consistent trading
      process — so they can analyze markets with confidence, independently.
    </p>
  </Container>
</section>
