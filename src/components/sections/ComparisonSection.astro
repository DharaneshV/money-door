---
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";

const rows = [
  ["Signal Dependency", "Independent Learning"],
  ["Random Entries", "Structured Strategies"],
  ["Emotion-Driven Trading", "Rule-Based Trading"],
  ["Profit Focus", "Process Focus"],
  ["No Risk Management", "Capital Protection"],
  ["Theory Only", "Practical Live Sessions"],
];
---

<section class="surface-ink py-section">
  <Container class="flex flex-col gap-[clamp(3rem,6vw,5rem)]">
    <SectionHeading
      eyebrow="What Makes Us Different"
      index="07"
      title="Others vs. Money Door FX Academy"
      align="left"
    />

    <div class="flex flex-col" data-reveal-stagger>
      <div class="flex items-baseline justify-between gap-6 pb-4">
        <span class="eyebrow text-paper/35">Elsewhere</span>
        <span class="eyebrow text-gold-500">Money Door FX Academy</span>
      </div>
      {
        rows.map((row) => (
          <div class="edit-row group flex items-baseline justify-between gap-6 py-[clamp(1.1rem,2.2vw,1.75rem)]">
            <span class="font-display text-[clamp(1rem,0.9rem+0.6vw,1.4rem)] font-medium leading-tight text-paper/35 line-through decoration-paper/20">
              {row[0]}
            </span>
            <span class="text-right font-display text-[clamp(1.1rem,0.95rem+0.8vw,1.65rem)] font-medium leading-tight text-paper transition-colors duration-500 group-hover:text-gold-300">
              {row[1]}
            </span>
          </div>
        ))
      }
    </div>

    <p class="max-w-2xl text-base leading-relaxed text-paper/60" data-reveal>
      Unlike platforms that focus primarily on signals or short-term opportunities, we focus on
      helping students understand why markets move, how to identify quality trading opportunities,
      how to manage risk responsibly, and how to develop a consistent trading process — so they
      can analyze markets with confidence, independently.
    </p>
  </Container>
</section>
