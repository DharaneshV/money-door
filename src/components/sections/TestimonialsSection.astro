---
import { getCollection } from "astro:content";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Button from "../ui/Button.astro";
import TestimonialCard from "../cards/TestimonialCard.astro";

// Gated on `published: true` — see the plan's "Open items" #2. Until real
// student testimonials are added to src/content/testimonials, this renders
// an honest empty state instead of fabricated names/quotes.
const testimonials = (await getCollection("testimonials", ({ data }) => data.published)).slice(0, 6);
---

<section class="bg-paper py-16 sm:py-20">
  <Container class="flex flex-col gap-10">
    <SectionHeading eyebrow="Student Success Stories" title="Hear From Our Students" light />

    {
      testimonials.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {testimonials.map((t) => (
            <TestimonialCard {...t.data} />
          ))}
        </div>
      ) : (
        <div class="mx-auto flex max-w-xl flex-col items-center gap-3 rounded-2xl border border-dashed border-ink-950/20 px-8 py-14 text-center">
          <p class="font-heading text-lg font-semibold text-ink-950">Student stories, coming soon</p>
          <p class="text-sm text-ink-700">
            We're collecting real feedback from our students. Rather than publish invented
            reviews, we'll add genuine stories here as they come in.
          </p>
        </div>
      )
    }

    <div class="text-center">
      <Button href="/student-reviews/" variant="ghost-light" arrow>View All Testimonials</Button>
    </div>
  </Container>
</section>
