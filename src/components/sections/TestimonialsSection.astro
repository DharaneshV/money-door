---
import { getCollection } from "astro:content";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import TestimonialCard from "../cards/TestimonialCard.astro";

// Gated on `published: true` — see the plan's "Open items" #2. Until real
// student testimonials are added to src/content/testimonials, this renders
// an honest empty state instead of fabricated names/quotes.
const testimonials = (await getCollection("testimonials", ({ data }) => data.published)).slice(0, 6);

// The grid below takes its column count from the number of published reviews:
// a fixed three-column grid left an empty third of the row while only two are
// live. Cards are boxed now rather than borderless, so the wide editorial
// gutter that used to separate them is no longer doing any work either.
---

<section class="surface-gold py-section">
  <Container class="flex flex-col gap-[clamp(3rem,6vw,5rem)]">
    <SectionHeading
      eyebrow="Student Success Stories"
      index="09"
      title="Hear From Our Students"
      align="left"
    />

    {
      testimonials.length > 0 ? (
        <div
          class:list={[
            "grid gap-[clamp(1rem,2vw,1.75rem)]",
            testimonials.length === 1 ? "max-w-2xl" : "md:grid-cols-2",
            testimonials.length >= 3 && "lg:grid-cols-3",
          ]}
          data-reveal-stagger
        >
          {testimonials.map((t) => (
            <TestimonialCard {...t.data} />
          ))}
        </div>
      ) : (
        <div class="border-t border-paper/12 py-16 text-center" data-reveal>
          <p class="font-display text-[clamp(1.35rem,1.1rem+1vw,2rem)] font-medium text-paper">
            Student stories, coming soon
          </p>
          <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-paper/70">
            We're collecting real feedback from our students. Rather than publish invented
            reviews, we'll add genuine stories here as they come in.
          </p>
        </div>
      )
    }

    <a
      href="/student-reviews/"
      class="group inline-flex w-fit items-center gap-3 font-heading text-xs font-semibold uppercase tracking-[0.18em] text-paper transition-colors hover:text-gold-300"
    >
      <span class="link-underline">View all testimonials</span>
      <svg
        width="16"
        height="16"
        viewBox="0 0 16 16"
        fill="none"
        class="transition-transform duration-500 group-hover:translate-x-1.5"
        aria-hidden="true"
      >
        <path
          d="M3.5 8h9M8.5 3.5 13 8l-4.5 4.5"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </a>
  </Container>
</section>
