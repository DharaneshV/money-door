---
import { getCollection } from "astro:content";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import ProgramCard from "../cards/ProgramCard.astro";

const programs = (await getCollection("programs")).sort((a, b) => a.data.order - b.data.order);
---

<section class="surface-ink-raised py-section">
  <Container class="flex flex-col gap-[clamp(3rem,6vw,5rem)]">
    <SectionHeading
      eyebrow="Our Learning Programs"
      index="05"
      title="Learn. Apply. Master."
      subtitle="Three levels, one continuous path — each program is the next stage of becoming a professional trader, not a separate course."
      align="left"
    />
    <div class="grid gap-x-[clamp(2rem,5vw,4rem)] gap-y-14 lg:grid-cols-3" data-reveal-stagger>
      {
        programs.map((program) => (
          <ProgramCard {...program.data} featured={program.data.code === "MDC2"} />
        ))
      }
    </div>
  </Container>
</section>
