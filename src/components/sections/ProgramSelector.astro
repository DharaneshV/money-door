---
import { getCollection } from "astro:content";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import SpecList from "../ui/SpecList.astro";
import Pill from "../ui/Pill.astro";
import Button from "../ui/Button.astro";

// Segmented plan-selector, borrowed in form from fundingpips.com and applied
// to the three MDC programs. All copy comes from the `programs` content
// collection — nothing is hardcoded here.
//
// This is the old /courses/ page's core UI. That page was folded into
// /what-we-teach/, so the selector now carries its own heading rather than
// relying on a PageHero above it.
interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  index?: string;
  /** Background tier, so the host page can keep its section alternation. */
  surface?: "ink" | "ink-raised" | "gold";
}
const {
  eyebrow,
  title,
  subtitle,
  index,
  surface = "ink",
} = Astro.props;

const programs = (await getCollection("programs")).sort((a, b) => a.data.order - b.data.order);

const specsFor = (d: (typeof programs)[number]["data"]) =>
  [
    { icon: "wallet" as const, label: "Fee", value: d.priceLabel ?? `${d.currency} ${d.price.toLocaleString("en-US")}` },
    { icon: "clock" as const, label: "Duration", value: d.duration },
    d.level ? { icon: "layers" as const, label: "Level", value: d.level } : null,
    d.format ? { icon: "users" as const, label: "Format", value: d.format } : null,
    d.mentorship ? { icon: "award" as const, label: "Mentorship", value: d.mentorship } : null,
  ].filter(Boolean) as { icon: "wallet" | "clock" | "layers" | "users" | "award"; label: string; value: string }[];
---

<section class:list={[`surface-${surface}`, "py-section"]}>
  <Container class="flex flex-col gap-[clamp(2.5rem,5vw,4rem)]">
    {title && <SectionHeading eyebrow={eyebrow} index={index} title={title} subtitle={subtitle} align="left" />}
    <div class="program-tabs" data-tabs>
      {/* Hidden entirely without JS, so the tablist never advertises a widget
          that can't work — the panels below simply render stacked instead. */}
      <div class="tablist-shell">
        <div class="tablist" role="tablist" aria-label="Learning programs">
          <span class="tab-thumb" aria-hidden="true" style="--thumb-x:0%;--thumb-w:33.333%"></span>
          {
            programs.map((p, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${p.data.code.toLowerCase()}`}
                aria-controls={`panel-${p.data.code.toLowerCase()}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
                class="tab"
              >
                {p.data.code}
              </button>
            ))
          }
        </div>
      </div>

      <div class="mt-12">
        {
          programs.map((p, i) => {
            const d = p.data;
            const slug = d.code.toLowerCase();
            return (
              <section
                role="tabpanel"
                id={`panel-${slug}`}
                aria-labelledby={`tab-${slug}`}
                tabindex="0"
                class:list={["tab-panel", i === 0 && "is-active"]}
              >
                <div class="grid gap-x-[clamp(2rem,5vw,4rem)] gap-y-10 lg:grid-cols-[1fr_1fr]">
                  <div class="flex flex-col">
                    <div class="flex flex-wrap items-center gap-3">
                      <span class="section-index text-gold-500">{d.code}</span>
                      {d.code === "MDC2" && <Pill tone="gold">Most chosen</Pill>}
                    </div>
                    <h3 class="mt-4 font-display text-[clamp(1.75rem,1.3rem+1.8vw,2.75rem)] font-medium leading-tight text-paper">
                      {d.name}
                    </h3>
                    <p class="mt-4 max-w-md text-base leading-relaxed text-paper/60">{d.tagline}</p>

                    {d.idealFor && (
                      <p class="mt-8 max-w-md text-sm leading-relaxed text-paper/50">
                        <span class="eyebrow mb-2 block text-gold-500">Ideal for</span>
                        {d.idealFor}
                      </p>
                    )}

                    <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
                      <Button href={`/courses/${slug}/`} arrow>
                        View full {d.code}
                      </Button>
                      <Button href="/join/" variant="ghost">
                        Book a free consultation
                      </Button>
                    </div>
                  </div>

                  <div class="flex flex-col">
                    <SpecList items={specsFor(d)} />
                    <div class="mt-10">
                      <span class="eyebrow text-gold-500">What you'll learn</span>
                      <ul class="mt-4 flex flex-col">
                        {d.highlights.map((h) => (
                          <li class="border-t border-paper/10 py-3 text-sm leading-snug text-paper/70">
                            {h}
                          </li>
                        ))}
                      </ul>
                    </div>
                    <blockquote class="mt-10 border-l border-gold-500 pl-5 text-sm leading-relaxed text-paper/65">
                      {d.outcome}
                    </blockquote>
                  </div>
                </div>
              </section>
            );
          })
        }
      </div>
    </div>
  </Container>
</section>

<script>
  // WAI-ARIA tabs with automatic activation. Only three lightweight panels,
  // so activating on arrow-key focus matches how a segmented control feels.
  function initProgramTabs() {
    document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((root) => {
      if (root.dataset.tabsBound) return;
      root.dataset.tabsBound = "1";

      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
      const thumb = root.querySelector<HTMLElement>(".tab-thumb");
      if (!tabs.length) return;

      function moveThumb(tab: HTMLButtonElement) {
        if (!thumb) return;
        const list = tab.parentElement;
        if (!list) return;
        thumb.style.setProperty("--thumb-w", `${tab.offsetWidth}px`);
        thumb.style.setProperty("--thumb-x", `${tab.offsetLeft - tabs[0].offsetLeft}px`);
      }

      function activate(index: number, focus = true) {
        tabs.forEach((t, i) => {
          const on = i === index;
          t.setAttribute("aria-selected", String(on));
          t.tabIndex = on ? 0 : -1;
          panels[i]?.classList.toggle("is-active", on);
        });
        moveThumb(tabs[index]);
        if (focus) tabs[index].focus();
        const id = panels[index]?.id;
        if (id) history.replaceState(null, "", `#${id}`);
      }

      root.addEventListener("click", (e) => {
        const t = (e.target as Element)?.closest<HTMLButtonElement>('[role="tab"]');
        if (t) activate(tabs.indexOf(t), false);
      });

      root.addEventListener("keydown", (e) => {
        const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
        if (i < 0) return;
        let next = -1;
        if (e.key === "ArrowRight") next = (i + 1) % tabs.length;
        else if (e.key === "ArrowLeft") next = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === "Home") next = 0;
        else if (e.key === "End") next = tabs.length - 1;
        if (next < 0) return;
        e.preventDefault();
        activate(next);
      });

      // Deep link (/courses/#mdc3) and initial thumb placement.
      const fromHash = panels.findIndex((p) => `#${p.id}` === location.hash);
      activate(fromHash >= 0 ? fromHash : 0, false);

      if ("ResizeObserver" in window) {
        new ResizeObserver(() => {
          const active = tabs.findIndex((t) => t.getAttribute("aria-selected") === "true");
          if (active >= 0) moveThumb(tabs[active]);
        }).observe(tabs[0].parentElement as Element);
      }
    });
  }
  initProgramTabs();
  document.addEventListener("astro:page-load", initProgramTabs);
</script>
