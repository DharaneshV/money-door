---
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Icon from "../ui/Icon.astro";

const items = [
  {
    icon: "target" as const,
    title: "Gold Trading Specialist",
    description: "Focused education on XAU/USD market behavior.",
  },
  {
    icon: "video" as const,
    title: "Live Market Sessions",
    description: "Learn while the market is moving.",
  },
  {
    icon: "book-open" as const,
    title: "Structured Learning",
    description: "A clear beginner-to-professional roadmap.",
  },
  {
    icon: "chart-bar" as const,
    title: "Practical Education",
    description: "Real chart analysis instead of theory.",
  },
  {
    icon: "shield-check" as const,
    title: "Risk Management",
    description: "Protecting capital is our first priority.",
  },
  {
    icon: "refresh" as const,
    title: "Lifetime Learning Mindset",
    description: "Markets evolve. Successful traders evolve too.",
  },
];
---

<section class="bg-ink-950 py-16 sm:py-20">
  <Container class="flex flex-col gap-10">
    <SectionHeading eyebrow="Why Choose Us" title="Why Thousands of Traders Choose Us" />
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((item) => (
          <div class="flex flex-col gap-3 rounded-2xl border border-ink-700 bg-ink-900 p-6 transition-colors hover:border-gold-500/40">
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-gold-500/10 text-gold-500">
              <Icon name={item.icon} class="h-5 w-5" />
            </span>
            <h3 class="font-heading text-lg font-bold text-paper">{item.title}</h3>
            <p class="text-sm text-paper/60">{item.description}</p>
          </div>
        ))
      }
    </div>
  </Container>
</section>
