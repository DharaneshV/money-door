---
import { Image } from "astro:assets";
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import trainerPhoto from "../../assets/team/venkatesh-m-portrait.jpg";
---

<section class="bg-ink-950 py-16 sm:py-20">
  <Container class="grid gap-10 lg:grid-cols-2 lg:items-center">
    <div class="relative order-2 lg:order-1">
      <div class="overflow-hidden rounded-3xl border border-ink-700">
        <Image
          src={trainerPhoto}
          alt="Venkatesh M, Chief Trainer of Money Door FX Academy, speaking at Forex Expo Dubai 2023"
          width={640}
          height={494}
          class="h-full w-full object-cover"
        />
      </div>
      <div
        class="absolute -bottom-5 -right-5 rounded-2xl border border-gold-500/30 bg-ink-900 px-5 py-3 shadow-xl shadow-black/40"
      >
        <p class="font-heading text-sm font-bold text-gold-400">Forex Expo Dubai 2023</p>
        <p class="text-xs text-paper/55">Speaker &amp; Chief Trainer</p>
      </div>
    </div>

    <div class="order-1 flex flex-col gap-4 lg:order-2">
      <span class="font-heading text-xs font-semibold uppercase tracking-[0.2em] text-gold-500">
        Meet Your Chief Trainer
      </span>
      <h2 class="font-heading text-3xl font-bold sm:text-4xl">Venkatesh M</h2>
      <p class="text-base leading-relaxed text-paper/70">
        With over 18 years of trading experience across Forex, Commodities, Equities, and
        financial markets, our Chief Trainer has helped thousands of aspiring traders understand
        market structure, improve discipline, and develop practical trading skills.
      </p>
      <p class="text-base leading-relaxed text-paper/70">
        His teaching philosophy focuses on simplifying complex market concepts into structured,
        easy-to-follow learning that students can confidently apply in real market conditions.
      </p>
      <blockquote class="border-l-2 border-gold-500 pl-4 text-sm italic text-paper/60">
        "Our goal is not just to teach trading — but to develop disciplined, consistent, and
        independent traders."
      </blockquote>
      <div>
        <Button href="/chief-trainer/" arrow>Meet the Trainer</Button>
      </div>
    </div>
  </Container>
</section>
