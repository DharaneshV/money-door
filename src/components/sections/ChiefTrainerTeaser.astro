---
import Container from "../ui/Container.astro";
import TrainerGallery from "./TrainerGallery.astro";
---

<section class="overflow-hidden bg-ink-950 py-section">
  <Container class="grid items-center gap-x-[clamp(2rem,6vw,6rem)] gap-y-12 lg:grid-cols-2">
    {/* The single static portrait that used to sit here is now the first frame
        of a self-advancing strip — same column, but it shows all four event
        photos instead of one. Falls back to nothing if the photo folder is
        empty, which is why the caption row moved inside the gallery. */}
    <div class="relative order-2 lg:order-1" data-reveal>
      <TrainerGallery bare variant="single" autoplay={4500} />
    </div>

    <div class="order-1 flex flex-col lg:order-2" data-reveal>
      <div class="mb-6 flex items-center gap-4">
        <span class="section-index text-gold-500">06</span>
        <span class="h-px w-10 bg-paper/25" aria-hidden="true"></span>
        <span class="eyebrow text-gold-500">Meet Your Chief Trainer</span>
      </div>
      {/* Sized for a half-width column rather than the full-bleed `display`
          tier — at that scale the wide tracking pushes glyphs past the column. */}
      <h2 class="font-display text-[clamp(2.25rem,1.6rem+2.6vw,4rem)] font-medium leading-[1.05] tracking-[0.04em] text-paper">
        Venkatesh M
      </h2>
      <p class="mt-8 max-w-xl text-base leading-relaxed text-paper/60">
        With over 18 years of trading experience across Forex, Commodities, Equities, and
        financial markets, our Chief Trainer has helped thousands of aspiring traders understand
        market structure, improve discipline, and develop practical trading skills.
      </p>
      <blockquote class="mt-8 border-l border-gold-500 pl-6 font-display text-lg italic leading-relaxed text-paper/75 sm:text-xl">
        "Our goal is not just to teach trading — but to develop disciplined, consistent, and
        independent traders."
      </blockquote>
      <a
        href="/chief-trainer/"
        class="group mt-10 inline-flex w-fit items-center gap-3 font-heading text-xs font-semibold uppercase tracking-[0.18em] text-paper transition-colors hover:text-gold-400"
      >
        <span class="link-underline">Meet the Trainer</span>
        <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          class="transition-transform duration-500 group-hover:translate-x-1.5"
          aria-hidden="true"
        >
          <path
            d="M3.5 8h9M8.5 3.5 13 8l-4.5 4.5"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    </div>
  </Container>
</section>
