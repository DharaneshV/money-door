---
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";

const steps = [
  "Learn the Basics",
  "Understand Market Structure",
  "Master Gold Trading",
  "Practice in Live Markets",
  "Develop Consistency",
  "Trade with Confidence",
];
---

<section class="bg-paper py-16 sm:py-20">
  <Container class="flex flex-col gap-10">
    <SectionHeading
      eyebrow="Our Learning Process"
      title="Your Journey to Becoming a Professional Trader"
      light
    />
    <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        steps.map((step, i) => (
          <li class="flex items-center gap-4 rounded-2xl border border-ink-950/10 bg-white p-5 shadow-sm">
            <span class="flex h-10 w-10 flex-none items-center justify-center rounded-full bg-ink-950 font-heading text-sm font-bold text-gold-400">
              {i + 1}
            </span>
            <span class="font-heading text-base font-semibold text-ink-950">{step}</span>
          </li>
        ))
      }
    </ol>
  </Container>
</section>
