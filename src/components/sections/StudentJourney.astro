---
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import StageConnector from "../ui/StageConnector.astro";
import Pill from "../ui/Pill.astro";

// The six original journey steps regrouped into three stages so they can be
// read as a progression at a glance. No step was dropped — each stage carries
// two of the original six as its bullets.
//
// COMPLIANCE: stage 3 must culminate in a SKILL outcome, never "get funded"
// or "get paid". The wording below mirrors MDC3's published `outcome` string,
// which deliberately says prop-firm *preparation*.
const stages = [
  {
    n: "01",
    label: "Foundation",
    title: "Learn the fundamentals",
    tilt: "-2.4deg",
    steps: ["Learn the Basics", "Understand Market Structure"],
    note: "MDC1 · 1 week · free",
    featured: false,
  },
  {
    n: "02",
    label: "Professional",
    title: "Build a repeatable process",
    tilt: "1.8deg",
    steps: ["Master Gold Trading", "Practice in Live Markets"],
    note: "MDC2 · 6 months",
    featured: false,
  },
  {
    n: "03",
    label: "Mastery",
    title: "Trade independently",
    tilt: "-1.4deg",
    steps: ["Develop Consistency", "Trade with Confidence"],
    note: "MDC3 · 12 months",
    featured: true,
  },
];
---

<section class="surface-gold py-section">
  <Container class="flex flex-col gap-[clamp(3rem,6vw,5rem)]">
    <SectionHeading
      eyebrow="Our Learning Process"
      index="05"
      title="Your Journey to Becoming a Professional Trader"
      align="left"
    />

    <ol
      class="grid items-stretch gap-y-2 lg:grid-cols-[1fr_auto_1fr_auto_1fr] lg:gap-y-0"
      data-reveal-stagger
    >
      {
        stages.map((stage, i) => (
          <>
            {/* The final stage is the emphasised one — it used to be the only
                dark card against two white ones. With an all-dark palette the
                emphasis comes from a warmer fill and a gold edge instead. */}
            <li
              class:list={[
                "tilt-card flex h-full flex-col p-7 sm:p-8",
                stage.featured ? "surface-card-warm" : "surface-card",
              ]}
              style={`--tilt:${stage.tilt}`}
            >
              <div class="flex items-baseline justify-between gap-4">
                <span
                  class:list={["section-index", stage.featured ? "text-gold-300" : "text-gold-500"]}
                >
                  {stage.n}
                </span>
                <span class="eyebrow text-paper/45">{stage.label}</span>
              </div>

              <h3 class="mt-6 font-display text-[clamp(1.35rem,1.1rem+1.1vw,2rem)] font-medium leading-tight text-paper">
                {stage.title}
              </h3>

              <ul class="mt-6 flex flex-col">
                {stage.steps.map((step) => (
                  <li class="border-t border-paper/12 py-3 text-sm leading-snug text-paper/70">
                    {step}
                  </li>
                ))}
              </ul>

              <div class="mt-auto pt-7">
                <Pill tone={stage.featured ? "gold" : "default"}>{stage.note}</Pill>
              </div>
            </li>

            {i < stages.length - 1 && (
              <li class="flex items-center justify-center py-1 lg:py-0" aria-hidden="true">
                <StageConnector orientation="v" class="lg:hidden" />
                <StageConnector orientation="h" class="hidden lg:block" />
              </li>
            )}
          </>
        ))
      }
    </ol>
  </Container>
</section>
