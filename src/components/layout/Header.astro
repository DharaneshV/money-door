---
import { Image } from "astro:assets";
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import MobileNav from "./MobileNav.astro";
import logoMark from "../../assets/brand/logo-mark.jpg";
import { primaryNav } from "../../data/site";

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-ink-700 bg-ink-950/95 backdrop-blur">
  <Container class="flex h-20 items-center justify-between gap-4">
    <a href="/" class="flex flex-none items-center gap-3">
      <Image src={logoMark} alt="Money Door FX Academy" width={44} height={44} class="rounded-full" />
      <span class="font-heading leading-tight">
        <span class="block text-sm font-bold tracking-wide sm:text-base">
          MONEY <span class="text-gold-500">DOOR</span>
        </span>
        <span class="block text-[10px] font-medium tracking-[0.25em] text-paper/55 sm:text-xs">
          FX ACADEMY
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex">
      {
        primaryNav.map((item) =>
          item.children ? (
            <div class="group relative">
              <button
                type="button"
                class:list={[
                  "flex items-center gap-1 rounded-full px-4 py-2 text-sm font-medium transition-colors",
                  isActive(item.href) ? "text-gold-400" : "text-paper/85 hover:text-gold-300",
                ]}
                aria-haspopup="true"
              >
                {item.label}
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path
                    d="m2.5 4.5 3.5 3 3.5-3"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
              <div class="invisible absolute left-0 top-full z-10 w-64 rounded-xl border border-ink-700 bg-ink-900 p-2 opacity-0 shadow-xl shadow-black/40 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class="block rounded-lg px-3 py-2 text-sm text-paper/85 hover:bg-ink-800 hover:text-gold-300"
                  >
                    <span class="block font-medium">{child.label}</span>
                    {child.description && (
                      <span class="block text-xs text-paper/50">{child.description}</span>
                    )}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class:list={[
                "rounded-full px-4 py-2 text-sm font-medium transition-colors",
                isActive(item.href) ? "text-gold-400" : "text-paper/85 hover:text-gold-300",
              ]}
            >
              {item.label}
            </a>
          )
        )
      }
    </nav>

    <div class="hidden flex-none lg:block">
      <Button href="/contact/">Join Now</Button>
    </div>

    <button
      id="mobile-menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu-panel"
      aria-label="Toggle menu"
      class="flex h-10 w-10 flex-none items-center justify-center rounded-lg text-paper lg:hidden"
    >
      <svg id="menu-icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
      <svg
        id="menu-icon-close"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        class="hidden"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>
  </Container>
  <MobileNav />
</header>
