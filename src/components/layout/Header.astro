---
import { Image } from "astro:assets";
import Container from "../ui/Container.astro";
import MobileNav from "./MobileNav.astro";
import AnnouncementBar from "./AnnouncementBar.astro";
import logoMark from "../../assets/brand/logo-mark.jpg";
import { primaryNav, joinHref } from "../../data/site";

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

{/* Sticky wrapper stays in normal flow and reserves its own height, so the
    floating pill inside can hover over content on scroll without any
    fixed-position offset maths (and no "nav overlaps the hero" class of bug).
    The gap from the viewport edges comes free from Container's gutters. */}
<header id="site-header" class="sticky top-0 z-50">
  <AnnouncementBar />
  <Container width="wide" class="pt-3">
    <div class="nav-pill flex h-[64px] items-center gap-4 px-4 xl:gap-8 xl:px-6">
    <a href="/" class="group flex flex-none items-center gap-3">
      <Image
        src={logoMark}
        alt="Money Door FX Academy"
        width={38}
        height={38}
        class="rounded-full transition-transform duration-500 group-hover:scale-105"
      />
      <span class="leading-none">
        <span class="block font-display text-base font-medium tracking-[0.12em] text-paper">
          MONEY <span class="text-gold-500">DOOR</span>
        </span>
        <span class="eyebrow mt-1.5 block text-[0.5rem] text-paper/40 sm:text-[0.55rem]">
          FX Academy
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-5 xl:flex xl:gap-7">
      {
        primaryNav.map((item) =>
          item.children ? (
            <div class="group relative">
              <button
                type="button"
                class:list={[
                  "eyebrow flex items-center gap-1.5 whitespace-nowrap py-2 transition-colors",
                  isActive(item.href) ? "text-gold-400" : "text-paper/70 hover:text-paper",
                ]}
                aria-haspopup="true"
              >
                {item.label}
                <svg
                  width="9"
                  height="9"
                  viewBox="0 0 12 12"
                  fill="none"
                  class="transition-transform duration-300 group-hover:rotate-180"
                  aria-hidden="true"
                >
                  <path
                    d="m2.5 4.5 3.5 3 3.5-3"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
              <div class="invisible absolute left-1/2 top-full z-10 w-72 -translate-x-1/2 -translate-y-1 border border-paper/10 bg-ink-950/95 p-2 opacity-0 backdrop-blur-xl transition-all duration-300 ease-out group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class="block px-4 py-3 transition-colors hover:bg-gold-500/8"
                  >
                    <span class="flex items-center gap-2 font-heading text-sm font-medium text-paper/90">
                      {child.label}
                      {child.badge && <span class="nav-badge">{child.badge}</span>}
                    </span>
                    {child.description && (
                      <span class="eyebrow mt-1.5 block text-paper/35">{child.description}</span>
                    )}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class:list={[
                "eyebrow whitespace-nowrap py-2 transition-colors",
                isActive(item.href) ? "text-gold-400" : "text-paper/70 hover:text-paper",
              ]}
            >
              {item.label}
            </a>
          )
        )
      }
    </nav>

    <div class="ml-auto flex flex-none items-center gap-5">
      <a
        href={joinHref}
        class="eyebrow hidden whitespace-nowrap rounded-full border border-gold-500/50 px-6 py-3 text-gold-400 transition-colors duration-300 hover:bg-gold-500 hover:text-ink-950 xl:inline-block"
      >
        Join Now
      </a>

      <button
        id="mobile-menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu-panel"
        aria-label="Toggle menu"
        class="flex h-11 w-11 flex-none items-center justify-center text-paper xl:hidden"
      >
        <svg id="menu-icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M3 8h18M3 16h18" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
        </svg>
        <svg
          id="menu-icon-close"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          class="hidden"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
        </svg>
      </button>
    </div>
    </div>
    <MobileNav />
  </Container>
</header>

<style>
  /* Compact nav band (1280–1599px).
     ------------------------------------------------------------------
     The desktop nav turns on at `xl` (1280px) and now carries eight
     long uppercase labels — several of them client-specified, so they
     can't be shortened. At the comfortable `2xl` spacing that row is
     ~290px too wide for a 1280px viewport: the pill is a nowrap flex
     row, so the excess didn't push the page wider (the layout uses
     `overflow-x: clip`, which is why the route audit never flagged it)
     — it simply pushed the "Join Now" CTA off the right edge, entirely
     invisible at 1280, 1366 and 1440px, the three commonest laptop
     widths. Tightening tracking and gaps in this band brings the whole
     row back inside the pill; 1600px and up keeps the roomier spacing. */
  @media (min-width: 1280px) and (max-width: 1599px) {
    .nav-pill {
      gap: 1rem;
      padding-inline: 1rem;
    }
    .nav-pill nav {
      gap: 0.75rem;
    }
    /* `.eyebrow` sets 0.28em tracking — luxurious for a standalone
       label, ruinous across ~79 characters of navigation. */
    .nav-pill nav :global(.eyebrow) {
      letter-spacing: 0.11em;
    }
    .nav-pill > :global(a[href="/join-now/"]),
    .nav-pill > :global(a.eyebrow:last-of-type) {
      padding-inline: 1.15rem;
      letter-spacing: 0.11em;
    }
  }
</style>
