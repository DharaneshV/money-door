---
import { primaryNav, whatsappHref, joinHref } from "../../data/site";
import Button from "../ui/Button.astro";
---

{/* Detached panel sitting below the floating pill, inside the same Container
    so it shares the pill's gutters and edge gap. */}
<div
  id="mobile-menu-panel"
  class="mt-2 rounded-[1.75rem] border border-paper/12 bg-ink-950/95 backdrop-blur-xl xl:hidden"
>
  <div class="px-4 py-4">
    <nav class="flex flex-col gap-1">
      {
        primaryNav.map((item) => (
          <div>
            <a
              href={item.href}
              class="block  px-3 py-3 text-base font-medium text-paper/90 transition-colors hover:bg-ink-800 hover:text-gold-300"
            >
              {item.label}
            </a>
            {item.children && (
              /* Drop only children that point at the parent's own href — the
                 parent link above already covers those. Previously this was a
                 blind `.slice(1)`, which assumed the first child was always
                 that duplicate; when Courses' "All Courses" entry was removed
                 the slice silently ate MDC1 instead, leaving no way to reach it
                 on mobile. */
              <div class="ml-3 flex flex-col gap-1 border-l border-paper/12 pl-3">
                {item.children
                  .filter((child) => child.href !== item.href)
                  .map((child) => (
                  <a
                    href={child.href}
                    class="block  px-3 py-2 text-sm text-paper/70 transition-colors hover:text-gold-300"
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))
      }
    </nav>
    <div class="mt-4 flex flex-col gap-2">
      <Button href={joinHref} class="w-full">Join Now</Button>
      <Button href={whatsappHref} target="_blank" variant="secondary" class="w-full">
        Chat on WhatsApp
      </Button>
    </div>
  </div>
</div>

<script>
  // Elements are looked up on every page load, never captured once into
  // module scope.
  //
  // This previously bound `toggle` at module-execution time. Module scripts
  // run once per document, but ClientRouter replaces the header node on a
  // view transition — so after the first navigation the listener belonged to
  // a discarded node and the button did nothing. On a phone the burger IS the
  // only navigation, so that stranded the visitor on whatever page they
  // landed on. Every other script here already re-inits on `astro:page-load`;
  // this one didn't.
  function els() {
    return {
      toggle: document.getElementById("mobile-menu-toggle"),
      panel: document.getElementById("mobile-menu-panel"),
      openIcon: document.getElementById("menu-icon-open"),
      closeIcon: document.getElementById("menu-icon-close"),
    };
  }

  function closeMenu() {
    const { toggle, panel, openIcon, closeIcon } = els();
    panel?.classList.remove("is-open");
    toggle?.setAttribute("aria-expanded", "false");
    openIcon?.classList.remove("hidden");
    closeIcon?.classList.add("hidden");
  }

  function openMenu() {
    const { toggle, panel, openIcon, closeIcon } = els();
    panel?.classList.add("is-open");
    toggle?.setAttribute("aria-expanded", "true");
    openIcon?.classList.add("hidden");
    closeIcon?.classList.remove("hidden");
  }

  function initMobileNav() {
    const { toggle, panel } = els();
    if (!toggle || !panel) return;
    // Per-element guard: if this exact node is already wired, a second bind
    // would toggle twice per click and the menu would appear dead again.
    if (toggle.dataset.navBound) return;
    toggle.dataset.navBound = "1";

    toggle.addEventListener("click", () => {
      if (toggle.getAttribute("aria-expanded") === "true") closeMenu();
      else openMenu();
    });

    panel.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeMenu));
  }

  // Document-level listeners survive view transitions, so they are bound once
  // for the lifetime of the tab rather than per page load — re-adding them on
  // every navigation would stack duplicates.
  if (!(window as any).__mdMobileNavDocBound) {
    (window as any).__mdMobileNavDocBound = true;
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeMenu();
    });
    // Close on navigation rather than leaving the panel open over the new page.
    document.addEventListener("astro:before-preparation", closeMenu);
  }

  initMobileNav();
  document.addEventListener("astro:page-load", initMobileNav);
</script>
