---
import { primaryNav, whatsappHref } from "../../data/site";
import Button from "../ui/Button.astro";
---

<div id="mobile-menu-panel" class="border-t border-paper/12 bg-ink-950 lg:hidden">
  <div class="px-4 py-4">
    <nav class="flex flex-col gap-1">
      {
        primaryNav.map((item) => (
          <div>
            <a
              href={item.href}
              class="block  px-3 py-3 text-base font-medium text-paper/90 transition-colors hover:bg-ink-800 hover:text-gold-300"
            >
              {item.label}
            </a>
            {item.children && (
              <div class="ml-3 flex flex-col gap-1 border-l border-paper/12 pl-3">
                {item.children.slice(1).map((child) => (
                  <a
                    href={child.href}
                    class="block  px-3 py-2 text-sm text-paper/70 transition-colors hover:text-gold-300"
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))
      }
    </nav>
    <div class="mt-4 flex flex-col gap-2">
      <Button href="/contact/" class="w-full">Join Now</Button>
      <Button href={whatsappHref} target="_blank" variant="secondary" class="w-full">
        Chat on WhatsApp
      </Button>
    </div>
  </div>
</div>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const panel = document.getElementById("mobile-menu-panel");
  const openIcon = document.getElementById("menu-icon-open");
  const closeIcon = document.getElementById("menu-icon-close");

  function closeMenu() {
    panel?.classList.remove("is-open");
    toggle?.setAttribute("aria-expanded", "false");
    openIcon?.classList.remove("hidden");
    closeIcon?.classList.add("hidden");
  }
  function openMenu() {
    panel?.classList.add("is-open");
    toggle?.setAttribute("aria-expanded", "true");
    openIcon?.classList.add("hidden");
    closeIcon?.classList.remove("hidden");
  }

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    if (isOpen) closeMenu();
    else openMenu();
  });

  panel?.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeMenu));

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMenu();
  });

  // Header persists across page transitions (transition:persist), so close
  // the menu on navigation rather than leaving it open over the new page.
  document.addEventListener("astro:before-preparation", closeMenu);
</script>
