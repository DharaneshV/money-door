---
import { Image } from "astro:assets";
import Container from "../ui/Container.astro";
import SocialLinks from "../ui/SocialLinks.astro";
import logoMark from "../../assets/brand/logo-mark.jpg";
import {
  siteConfig,
  contact,
  socials,
  footerColumns,
  riskDisclaimerShort,
  whatsappChannelUrl,
} from "../../data/site";

const year = new Date().getFullYear();

const whatsappIconPath =
  "M16.004 3C9.377 3 4 8.373 4 15c0 2.34.653 4.527 1.785 6.392L4 29l7.81-1.75A11.94 11.94 0 0 0 16.004 27C22.63 27 28 21.627 28 15S22.63 3 16.004 3Zm6.98 17.02c-.298.837-1.47 1.54-2.415 1.744-.643.137-1.482.246-4.31-.926-3.617-1.498-5.945-5.156-6.128-5.395-.176-.238-1.463-1.948-1.463-3.716 0-1.768.914-2.635 1.24-2.997.298-.33.65-.412.867-.412.216 0 .434.002.624.012.2.01.468-.076.732.558.298.716.99 2.484 1.076 2.665.087.18.145.393.028.632-.116.238-.174.386-.348.594-.174.207-.365.462-.522.622-.174.176-.356.366-.153.72.203.354.906 1.494 1.947 2.42 1.338 1.193 2.466 1.563 2.82 1.74.354.176.56.148.767-.09.207-.24.877-1.022 1.11-1.373.232-.35.464-.29.783-.174.319.116 2.02.953 2.366 1.126.348.174.58.26.665.404.087.146.087.844-.211 1.68Z";

// Simple, dependency-free social glyphs — swap in real ones once real handles exist.
---

<footer class="border-t border-paper/12 bg-ink-950">
  <Container class="grid grid-cols-2 gap-x-8 gap-y-10 py-16 lg:grid-cols-6">
    <div class="col-span-2 flex flex-col gap-4 lg:col-span-2">
      <a href="/" class="flex items-center gap-3">
        <Image src={logoMark} alt={siteConfig.name} width={44} height={44} class="rounded-full" />
        <span class="font-heading text-sm font-bold leading-tight">
          MONEY <span class="text-gold-500">DOOR</span><br />
          <span class="text-[10px] font-medium tracking-[0.25em] text-paper/55">FX ACADEMY</span>
        </span>
      </a>
      <p class="max-w-xs text-sm leading-relaxed text-paper/60">
        Empowering traders through knowledge, discipline, and practical experience.
      </p>
      <div class="flex gap-3 pt-1">
        <a
          href={whatsappChannelUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Join our WhatsApp Channel"
          class="flex h-11 w-11 items-center justify-center rounded-full border border-paper/12 text-paper/55 transition-colors hover:border-[#25D366]/45 hover:bg-[#25D366]/10 hover:text-[#25D366] sm:h-9 sm:w-9"
        >
          <svg width="16" height="16" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
            <path d={whatsappIconPath} />
          </svg>
        </a>
        <SocialLinks tone="muted" size="sm" />
      </div>
    </div>

    {
      footerColumns.map((col) => (
        <div class="flex flex-col gap-3">
          <h3 class="font-heading text-sm font-semibold text-paper">{col.heading}</h3>
          <ul class="flex flex-col gap-2">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-paper/60 transition-colors hover:text-gold-300">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <div class="col-span-2 flex flex-col gap-3 lg:col-span-1">
      <h3 class="font-heading text-sm font-semibold text-paper">Contact Us</h3>
      <a href={`tel:+${contact.primaryPhoneE164}`} class="text-sm text-paper/60 hover:text-gold-300 max-sm:flex max-sm:min-h-11 max-sm:items-center">
        {contact.primaryPhoneDisplay}
      </a>
      {/* The address is longer than this column is wide, so it has to wrap.
          `break-all` broke it mid-word ("gmail.co / m"); a <wbr> after the "@"
          gives the browser the one break point a reader expects instead. */}
      <a
        href={`mailto:${contact.email}`}
        class="text-sm text-paper/60 transition-colors hover:text-gold-300 max-sm:flex max-sm:min-h-11 max-sm:items-center"
      >
        {contact.email.split("@")[0]}@<wbr />{contact.email.split("@")[1]}
      </a>
      <a
        href={contact.mapsHref}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-paper/60 transition-colors hover:text-gold-300"
      >
        {contact.address.line1}<br />
        {contact.address.line2}<br />
        {contact.address.city}, {contact.address.region} {contact.address.postalCode}
      </a>
      <a
        href={whatsappChannelUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-medium text-gold-400 transition-colors hover:text-gold-300 max-sm:flex max-sm:min-h-11 max-sm:items-center"
      >
        Join our WhatsApp Channel&nbsp;→
      </a>
    </div>
  </Container>

  <div class="border-t border-paper/12">
    <Container class="py-6">
      <p class="text-xs leading-relaxed text-paper/45">
        <strong class="font-semibold text-paper/70">Risk Disclaimer:</strong> {riskDisclaimerShort}
      </p>
    </Container>
  </div>

  <div class="border-t border-paper/12">
    <Container class="flex flex-col items-center justify-between gap-2 py-5 text-xs text-paper/45 sm:flex-row">
      <p>© {year} {siteConfig.name}. All Rights Reserved.</p>
      <p>Educational purposes only. No investment advice.</p>
    </Container>
  </div>
</footer>
