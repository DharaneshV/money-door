  LinkedIn:
    "M6.94 8.5H3.56V20.4h3.38V8.5ZM5.25 3.6a1.96 1.96 0 1 0 0 3.92 1.96 1.96 0 0 0 0-3.92ZM20.45 20.4h-3.37v-6.2c0-1.48-.03-3.38-2.06-3.38-2.07 0-2.39 1.62-2.39 3.28v6.3H9.27V8.5h3.24v1.63h.05c.45-.85 1.56-1.75 3.2-1.75 3.43 0 4.06 2.26 4.06 5.19v6.83Z",
};
---

<footer class="border-t border-paper/12 bg-ink-950">
  <Container class="grid grid-cols-2 gap-x-8 gap-y-10 py-16 lg:grid-cols-6">
    <div class="col-span-2 flex flex-col gap-4 lg:col-span-2">
      <a href="/" class="flex items-center gap-3">
        <Image src={logoMark} alt={siteConfig.name} width={44} height={44} class="rounded-full" />
        <span class="font-heading text-sm font-bold leading-tight">
          MONEY <span class="text-gold-500">DOOR</span><br />
          <span class="text-[10px] font-medium tracking-[0.25em] text-paper/55">FX ACADEMY</span>
        </span>
      </a>
      <p class="max-w-xs text-sm leading-relaxed text-paper/60">
        Empowering traders through knowledge, discipline, and practical experience.
      </p>
      <div class="flex gap-3 pt-1">
        <a
          href={whatsappChannelUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Join our WhatsApp Channel"
          class="flex h-9 w-9 items-center justify-center rounded-full border border-paper/12 text-paper/70 transition-colors hover:border-gold-500 hover:text-gold-400"
        >
          <svg width="16" height="16" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
            <path d={whatsappIconPath} />
          </svg>
        </a>
        {
          socials
            .filter((s) => s.url)
            .map((s) => (
              <a
                href={s.url as string}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.name}
                class="flex h-9 w-9 items-center justify-center rounded-full border border-paper/12 text-paper/70 transition-colors hover:border-gold-500 hover:text-gold-400"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={socialIcon[s.name]} />
                </svg>
              </a>
            ))
        }
      </div>
    </div>

    {
      footerColumns.map((col) => (
        <div class="flex flex-col gap-3">
          <h3 class="font-heading text-sm font-semibold text-paper">{col.heading}</h3>
          <ul class="flex flex-col gap-2">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-paper/60 transition-colors hover:text-gold-300">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <div class="col-span-2 flex flex-col gap-3 lg:col-span-1">
      <h3 class="font-heading text-sm font-semibold text-paper">Contact Us</h3>
      <a href={`tel:+${contact.primaryPhoneE164}`} class="text-sm text-paper/60 hover:text-gold-300">
        {contact.primaryPhoneDisplay}
      </a>
      {/* break-all so the long address wraps inside the narrow footer column
          instead of being clipped at the edge. */}
      <a
        href={`mailto:${contact.email}`}
        class="break-all text-sm text-paper/60 transition-colors hover:text-gold-300"
      >
        {contact.email}
      </a>
      <p class="text-sm text-paper/60">{contact.addressLine}</p>
      <a
        href={whatsappChannelUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-medium text-gold-400 transition-colors hover:text-gold-300"
      >
        Join our WhatsApp Channel →
      </a>
    </div>
  </Container>

  <div class="border-t border-paper/12">
    <Container class="py-6">
      <p class="text-xs leading-relaxed text-paper/45">{riskDisclaimerShort}</p>
    </Container>
  </div>

  <div class="border-t border-paper/12">
    <Container class="flex flex-col items-center justify-between gap-2 py-5 text-xs text-paper/45 sm:flex-row">
      <p>© {year} {siteConfig.name}. All Rights Reserved.</p>
      <p>Educational purposes only. No investment advice.</p>
    </Container>
  </div>
</footer>
