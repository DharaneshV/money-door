---
import { Image } from "astro:assets";
import Container from "../ui/Container.astro";
import logoMark from "../../assets/brand/logo-mark.jpg";
import {
  siteConfig,
  contact,
  socials,
  footerColumns,
  riskDisclaimerShort,
  whatsappChannelUrl,
} from "../../data/site";

