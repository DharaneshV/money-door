---
interface Props {
  title: string;
  description: string;
  publishDate: Date;
  category: string;
  slug: string;
}
const { title, description, publishDate, category, slug } = Astro.props;
const dateLabel = publishDate.toLocaleDateString("en-IN", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<a
  href={`/blog/${slug}/`}
  class="group flex flex-col gap-3 rounded-2xl border border-ink-700 bg-ink-900 p-6 transition-colors hover:border-gold-500/40"
>
  <span class="w-fit rounded-full bg-gold-500/10 px-3 py-1 text-xs font-semibold text-gold-400">
    {category}
  </span>
  <h3 class="font-heading text-lg font-bold text-paper group-hover:text-gold-300">{title}</h3>
  <p class="text-sm text-paper/60">{description}</p>
  <time class="mt-auto pt-2 text-xs text-paper/40" datetime={publishDate.toISOString()}>
    {dateLabel}
  </time>
</a>
