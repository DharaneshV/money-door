---
interface Props {
  title: string;
  description: string;
  publishDate: Date;
  category: string;
  slug: string;
  /** Reading time in minutes, derived from the post body by the caller. */
  readingMinutes?: number;
}
const { title, description, publishDate, category, slug, readingMinutes } = Astro.props;
const dateLabel = publishDate.toLocaleDateString("en-IN", {
  day: "numeric",
  month: "short",
  year: "numeric",
});

// Each category gets a stable accent so the grid reads as a set of distinct
// topics at a glance rather than eight identical rectangles. Falls back to gold
// for a category added later without a colour here.
const ACCENT: Record<string, string> = {
  "Risk Management": "#E4574C",
  "Trading Psychology": "#B98BE8",
  "Beginner Guides": "#4CA5E4",
  "Gold Market Analysis": "var(--color-gold-500)",
  Strategy: "#3FBF8F",
};
const accent = ACCENT[category] ?? "var(--color-gold-500)";
---

<a href={`/blog/${slug}/`} class="ptile" style={`--accent:${accent}`}>
  {/* Accent bloom, revealed on hover — the tile is all type, so this is what
      gives it something to respond with. */}
  <span class="ptile__glow" aria-hidden="true"></span>

  <div class="ptile__head">
    <span class="ptile__cat">{category}</span>
    <span class="ptile__meta">
      <time datetime={publishDate.toISOString()}>{dateLabel}</time>
      {readingMinutes && <span class="ptile__dot" aria-hidden="true">·</span>}
      {readingMinutes && <span>{readingMinutes} min read</span>}
    </span>
  </div>

  <h3 class="ptile__title">{title}</h3>
  <p class="ptile__desc">{description}</p>

  <span class="ptile__cta">
    <span class="ptile__cta-text">Read article</span>
    <span class="ptile__arrow" aria-hidden="true">
      <svg width="15" height="15" viewBox="0 0 16 16" fill="none">
        <path
          d="M3.5 8h9M8.5 3.5 13 8l-4.5 4.5"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
  </span>
</a>

<style>
  .ptile {
    position: relative;
    display: flex;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-card);
    padding: clamp(1.5rem, 2.6vw, 2.25rem);
    background-image: linear-gradient(180deg, var(--color-ink-900), var(--color-ink-950));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-paper) 9%, transparent);
    transition:
      box-shadow 0.45s ease,
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ptile:hover {
    transform: translateY(-4px);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--accent) 45%, transparent),
      0 22px 45px -25px rgb(0 0 0 / 0.9);
  }
  .ptile:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* Accent spine down the left edge, growing on hover. */
  .ptile::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--accent);
    transform: scaleY(0.25);
    transform-origin: top;
    transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ptile:hover::before {
    transform: scaleY(1);
  }

  /* Soft accent bloom in the top-right, revealed on hover. */
  .ptile__glow {
    position: absolute;
    top: -35%;
    right: -25%;
    height: 16rem;
    width: 16rem;
    border-radius: 9999px;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 40%, transparent), transparent 68%);
    opacity: 0;
    transition: opacity 0.55s ease;
    pointer-events: none;
  }
  .ptile:hover .ptile__glow {
    opacity: 0.55;
  }

  .ptile__head {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .ptile__cat {
    border-radius: 9999px;
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 35%, transparent);
    padding: 0.3rem 0.7rem;
    font-family: var(--font-heading);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .ptile__meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-heading);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--color-paper) 38%, transparent);
  }

  .ptile__title {
    position: relative;
    margin-top: 1.4rem;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1.1rem + 0.85vw, 1.85rem);
    font-weight: 500;
    line-height: 1.18;
    color: var(--color-paper);
    transition: color 0.4s ease;
  }
  .ptile:hover .ptile__title {
    color: var(--accent);
  }
  .ptile__desc {
    position: relative;
    margin-top: 0.9rem;
    font-size: 0.9rem;
    line-height: 1.65;
    color: color-mix(in srgb, var(--color-paper) 60%, transparent);
  }

  .ptile__cta {
    position: relative;
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding-top: 1.75rem;
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-paper) 75%, transparent);
    transition: color 0.4s ease;
  }
  .ptile:hover .ptile__cta {
    color: var(--accent);
  }
  .ptile__arrow {
    display: flex;
    height: 1.9rem;
    width: 1.9rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-paper) 20%, transparent);
    transition:
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.4s ease,
      background-color 0.4s ease;
  }
  .ptile:hover .ptile__arrow {
    transform: translateX(4px);
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 55%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .ptile,
    .ptile::before,
    .ptile__glow,
    .ptile__arrow,
    .ptile__title,
    .ptile__cta {
      transition: none;
    }
    .ptile:hover {
      transform: none;
    }
    .ptile::before {
      transform: scaleY(1);
    }
    .ptile:hover .ptile__arrow {
      transform: none;
    }
  }
</style>
