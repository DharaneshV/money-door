---
interface Props {
  title: string;
  description: string;
  publishDate: Date;
  category: string;
  slug: string;
}
// The former `light` prop is gone with the off-white sections it existed for.
const { title, description, publishDate, category, slug } = Astro.props;
const dateLabel = publishDate.toLocaleDateString("en-IN", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<a
  href={`/blog/${slug}/`}
  class="group flex h-full flex-col border-t border-paper/15 pt-8 transition-colors duration-500 hover:border-gold-500"
>
  <div class="flex items-baseline justify-between gap-4">
    <span class="eyebrow text-gold-500">{category}</span>
    <time class="eyebrow text-paper/35" datetime={publishDate.toISOString()}>
      {dateLabel}
    </time>
  </div>
  <h3 class="mt-6 font-display text-[clamp(1.25rem,1.05rem+0.9vw,1.75rem)] font-medium leading-tight text-paper transition-colors duration-500 group-hover:text-gold-300">
    {title}
  </h3>
  <p class="mt-4 text-sm leading-relaxed text-paper/55">
    {description}
  </p>
  <span class="mt-auto inline-flex items-center gap-3 pt-8 font-heading text-xs font-semibold uppercase tracking-[0.18em] text-paper">
    <span class="link-underline">Read</span>
    <svg
      width="16"
      height="16"
      viewBox="0 0 16 16"
      fill="none"
      class="transition-transform duration-500 group-hover:translate-x-1.5"
      aria-hidden="true"
    >
      <path
        d="M3.5 8h9M8.5 3.5 13 8l-4.5 4.5"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </span>
</a>
