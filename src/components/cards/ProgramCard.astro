---
interface Props {
  code: string;
  name: string;
  tagline: string;
  duration: string;
  price: number;
  currency: string;
  priceLabel?: string;
  highlights: string[];
  featured?: boolean;
}
const { code, name, tagline, duration, price, currency, priceLabel, highlights, featured = false } =
  Astro.props;

const priceDisplay = priceLabel ?? `${currency} ${price.toLocaleString("en-US")}`;
const href = `/courses/${code.toLowerCase()}/`;
---

<a
  href={href}
  class:list={[
    "group flex h-full flex-col border-t pt-8 transition-colors duration-500",
    featured ? "border-gold-500" : "border-paper/15 hover:border-paper/40",
  ]}
>
  <div class="flex items-baseline justify-between gap-4">
    <span class:list={["section-index", featured ? "text-gold-400" : "text-paper/45"]}>{code}</span>
    {featured && <span class="eyebrow text-gold-400">Most Popular</span>}
  </div>

  <h3 class="mt-6 font-display text-[clamp(1.75rem,1.3rem+1.8vw,2.75rem)] font-medium leading-none text-paper transition-colors duration-500 group-hover:text-gold-300">
    {name}
  </h3>
  <p class="mt-3 text-sm leading-relaxed text-paper/55">{tagline}</p>

  <div class="mt-8 flex items-baseline gap-3">
    <span class="font-display text-[clamp(1.5rem,1.2rem+1.2vw,2.25rem)] font-medium leading-none tabular-nums text-gold-400">
      {priceDisplay}
    </span>
    <span class="eyebrow text-paper/40">{duration}</span>
  </div>

  <ul class="mt-8 flex flex-col">
    {
      highlights.map((h) => (
        <li class="border-t border-paper/8 py-3 text-sm leading-snug text-paper/70">{h}</li>
      ))
    }
  </ul>

  <span class="mt-auto inline-flex items-center gap-3 pt-8 font-heading text-xs font-semibold uppercase tracking-[0.18em] text-paper">
    <span class="link-underline">Explore {code}</span>
    <svg
      width="16"
      height="16"
      viewBox="0 0 16 16"
      fill="none"
      class="transition-transform duration-500 group-hover:translate-x-1.5"
      aria-hidden="true"
    >
      <path
        d="M3.5 8h9M8.5 3.5 13 8l-4.5 4.5"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </span>
</a>
