---
interface Props {
  studentName: string;
  quote: string;
  rating: number;
}
const { studentName, quote, rating } = Astro.props;
---

<figure class="flex h-full flex-col border-t border-paper/12 pt-8">
  <div class="eyebrow text-gold-500" aria-label={`${rating} out of 5`}>
    {"★".repeat(rating)}<span class="text-paper/20">{"★".repeat(5 - rating)}</span>
  </div>
  <blockquote class="mt-6 flex-1 font-display text-lg italic leading-relaxed text-paper sm:text-xl">
    "{quote}"
  </blockquote>
  <figcaption class="eyebrow mt-8 text-paper/55">{studentName}</figcaption>
</figure>
