---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  studentName: string;
  role?: string;
  photo?: string;
  quote: string;
  rating: number;
}
const { studentName, role, photo, quote, rating } = Astro.props;

// Photos are resolved through a glob rather than a direct import, so a
// testimonial naming a file that hasn't been supplied yet still renders —
// with the student's initials — instead of failing the build. That keeps a
// real review publishable the moment it arrives, without waiting on a picture.
const files = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/testimonials/*.{jpg,jpeg,png,webp,avif}",
  { eager: true }
);
const match = photo
  ? Object.entries(files).find(([path]) => path.endsWith(`/${photo}`))?.[1].default
  : undefined;

const initials = studentName
  .split(/\s+/)
  .slice(0, 2)
  .map((w) => w[0])
  .join("")
  .toUpperCase();
---

<figure class="tcard">
  <div class="tcard__stars" aria-label={`Rated ${rating} out of 5`}>
    <span aria-hidden="true">
      {"★".repeat(rating)}<span class="tcard__stars-off">{"★".repeat(5 - rating)}</span>
    </span>
  </div>

  <blockquote class="tcard__quote">{quote}</blockquote>

  <figcaption class="tcard__foot">
    {
      match ? (
        <Image
          src={match}
          alt={`${studentName}, Money Door FX Academy student`}
          width={112}
          height={112}
          class="tcard__photo"
          loading="lazy"
        />
      ) : (
        <span class="tcard__initials" aria-hidden="true">
          {initials}
        </span>
      )
    }
    <span class="tcard__who">
      <span class="tcard__name">{studentName}</span>
      {role && <span class="tcard__role">{role}</span>}
    </span>
  </figcaption>
</figure>

<style>
  .tcard {
    display: flex;
    height: 100%;
    flex-direction: column;
    border-radius: var(--radius-card);
    padding: clamp(1.5rem, 2.6vw, 2.25rem);
    background-image: linear-gradient(180deg, var(--color-ink-900), var(--color-ink-950));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-paper) 9%, transparent);
    transition:
      box-shadow 0.45s ease,
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .tcard:hover {
    transform: translateY(-3px);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-gold-500) 30%, transparent);
  }

  .tcard__stars {
    font-size: 0.95rem;
    letter-spacing: 0.15em;
    color: var(--color-gold-500);
  }
  .tcard__stars-off {
    color: color-mix(in srgb, var(--color-paper) 18%, transparent);
  }

  /* Not italic: these run long, and a full paragraph of italic display type is
     markedly harder to read than the one-liners this card used to hold. */
  .tcard__quote {
    margin-top: 1.25rem;
    flex: 1;
    font-size: 0.95rem;
    line-height: 1.7;
    color: color-mix(in srgb, var(--color-paper) 78%, transparent);
  }
  .tcard__quote::before {
    content: "“";
  }
  .tcard__quote::after {
    content: "”";
  }

  .tcard__foot {
    margin-top: 1.75rem;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    border-top: 1px solid color-mix(in srgb, var(--color-paper) 10%, transparent);
    padding-top: 1.25rem;
  }
  .tcard__photo,
  .tcard__initials {
    height: 3rem;
    width: 3rem;
    flex: none;
    border-radius: 9999px;
    object-fit: cover;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-gold-500) 40%, transparent);
  }
  .tcard__initials {
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--color-gold-500) 14%, transparent);
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-gold-300);
  }
  .tcard__who {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }
  .tcard__name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.2;
    color: var(--color-paper);
  }
  .tcard__role {
    margin-top: 0.2rem;
    font-family: var(--font-heading);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold-500);
  }

  @media (prefers-reduced-motion: reduce) {
    .tcard {
      transition: none;
    }
    .tcard:hover {
      transform: none;
    }
  }
</style>
