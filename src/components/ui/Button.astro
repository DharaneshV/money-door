---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost" | "secondary-light" | "ghost-light";
  size?: "md" | "lg";
  class?: string;
  arrow?: boolean;
  target?: "_blank";
  type?: "button" | "submit";
}
const {
  href,
  variant = "primary",
  size = "md",
  class: className = "",
  arrow = false,
  target,
  type = "button",
} = Astro.props;

// Editorial button language: squared-off, hairline-bordered, wide-tracked
// uppercase. No pills, no drop shadows — the fill inverts on hover instead.
const base =
  "group inline-flex items-center justify-center gap-3 font-heading text-xs font-semibold uppercase tracking-[0.18em] transition-colors duration-300 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold-500";

// The -light variants exist because gold-300/paper text fails WCAG contrast on
// the light `bg-paper` sections — use them for any button on a light background.
const variants = {
  primary: "border border-gold-500 text-gold-400 hover:bg-gold-500 hover:text-ink-950",
  secondary: "border border-paper/25 text-paper hover:border-paper hover:bg-paper hover:text-ink-950",
  ghost: "text-gold-400 hover:text-gold-300",
  "secondary-light":
    "border border-ink-950/25 text-ink-950 hover:border-ink-950 hover:bg-ink-950 hover:text-paper",
  "ghost-light": "text-gold-700 hover:text-gold-600",
};

const isGhost = variant === "ghost" || variant === "ghost-light";
const sizes = {
  md: isGhost ? "" : "px-7 py-3.5",
  lg: isGhost ? "" : "px-9 py-4.5",
};

const classes = [base, variants[variant], sizes[size], className].join(" ");
const rel = target === "_blank" ? "noopener noreferrer" : undefined;
---

{
  href ? (
    <a href={href} class={classes} target={target} rel={rel}>
      <span class:list={[isGhost && "link-underline"]}>
        <slot />
      </span>
      {arrow && (
        <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          class="transition-transform duration-500 group-hover:translate-x-1.5"
          aria-hidden="true"
        >
          <path
            d="M3.5 8h9M8.5 3.5 13 8l-4.5 4.5"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      )}
    </a>
  ) : (
    <button type={type} class={classes}>
      <span class:list={[isGhost && "link-underline"]}>
        <slot />
      </span>
      {arrow && (
        <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          class="transition-transform duration-500 group-hover:translate-x-1.5"
          aria-hidden="true"
        >
          <path
            d="M3.5 8h9M8.5 3.5 13 8l-4.5 4.5"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      )}
    </button>
  )
}
