---
import { riskDisclaimerBanner, riskDisclaimerShort } from "../../data/site";

interface Props {
  variant?: "banner" | "full";
  class?: string;
}
const { variant = "banner", class: className = "" } = Astro.props;
---

{
  variant === "banner" ? (
    <div
      class:list={[
        "flex items-start gap-3 rounded-xl border border-gold-500/25 bg-gold-500/5 px-4 py-3 text-sm text-paper/80",
        className,
      ]}
    >
      <svg
        class="mt-0.5 h-4 w-4 flex-none text-gold-500"
        viewBox="0 0 20 20"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          fill-rule="evenodd"
          d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495ZM10 6a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 6Zm0 8a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z"
          clip-rule="evenodd"
        />
      </svg>
      <p>{riskDisclaimerBanner}</p>
    </div>
  ) : (
    <p class:list={["text-sm leading-relaxed text-paper/60", className]}>{riskDisclaimerShort}</p>
  )
}
