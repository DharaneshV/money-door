---
// Small, dependency-free line-icon set (matches the brief's "minimal gold line
// icons" design note). Built from simple primitives on purpose — reliable at
// any size, no icon-font/library dependency to load or maintain.
interface Props {
  name:
    | "graduation-cap"
    | "chart-bar"
    | "video"
    | "shield-check"
    | "users"
    | "refresh"
    | "copy"
    | "calendar"
    | "target"
    | "star"
    | "check-circle"
    | "x-circle"
    | "check"
    | "book-open"
    | "trending-up"
    | "phone"
    | "mail"
    | "map-pin"
    | "message-circle"
    | "clock"
    | "wallet"
    | "layers"
    | "award"
    | "route";
  class?: string;
}
const { name, class: className = "h-6 w-6" } = Astro.props;

const common = {
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "1.6",
  "stroke-linecap": "round" as const,
  "stroke-linejoin": "round" as const,
};
---

{
  name === "graduation-cap" && (
    <svg viewBox="0 0 24 24" class={className} {...common} aria-hidden="true">
      <path d="M12 4 2 9l10 5 10-5-10-5Z" />
      <path d="M6 11.5V17c0 1.4 2.7 2.5 6 2.5s6-1.1 6-2.5v-5.5" />
      <path d="M21 9v6" />
    </svg>
  )
}
{
  name === "chart-bar" && (
    <svg viewBox="0 0 24 24" class={className} {...common} aria-hidden="true">
      <path d="M3 21V3M3 21h18" />
      <rect x="7" y="13" width="3" height="6" />
      <rect x="12.5" y="9" width="3" height="10" />
      <rect x="18" y="5" width="3" height="14" />
    </svg>
  )
}
{
  name === "video" && (
    <svg viewBox="0 0 24 24" class={className} {...common} aria-hidden="true">
      <circle cx="12" cy="12" r="9" />
      <path d="M10 8.5v7l6-3.5-6-3.5Z" />
    </svg>
  )
}
{
  name === "shield-check" && (
    <svg viewBox="0 0 24 24" class={className} {...common} aria-hidden="true">
      <path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3Z" />
      <path d="M9 12l2 2 4-4" />
    </svg>
  )
}
{
  name === "users" && (
    <svg viewBox="0 0 24 24" class={className} {...common} aria-hidden="true">
      <circle cx="9" cy="8" r="3" />
      <path d="M3.5 19a5.7 5.7 0 0 1 11 0" />
      <circle cx="17.5" cy="9" r="2.3" />
      <path d="M14.8 19a4.8 4.8 0 0 1 5.7-4.3" />
    </svg>
  )
}
{
  name === "refresh" && (
    <svg viewBox="0 0 24 24" class={className} {...common} aria-hidden="true">
      <path d="M4 12a8 8 0 0 1 14-5.3" />
      <path d="M20 12a8 8 0 0 1-14 5.3" />
      <path d="M18 3.5v3.5h-3.5" />
      <path d="M6 20.5V17h3.5" />
    </svg>
  )
}
{
  name === "copy" && (
    <svg viewBox="0 0 24 24" class={className} {...common} aria-hidden="true">
      <rect x="9" y="9" width="11" height="11" rx="2" />
      <path d="M5 15V5a2 2 0 0 1 2-2h10" />
    </svg>
  )
}
{
  name === "calendar" && (
    <svg viewBox="0 0 24 24" class={className} {...common} aria-hidden="true">
      <rect x="3" y="5" width="18" height="16" rx="2" />
      <path d="M3 10h18M8 3v4M16 3v4" />
    </svg>
  )
}
{
  name === "target" && (
    <svg viewBox="0 0 24 24" class={className} {...common} aria-hidden="true">
      <circle cx="12" cy="12" r="8.5" />
      <circle cx="12" cy="12" r="4.5" />
      <circle cx="12" cy="12" r="1" fill="currentColor" stroke="none" />
    </svg>
  )
}
{
  name === "star" && (
    <svg viewBox="0 0 24 24" class={className} fill="currentColor" aria-hidden="true">
      <path d="M12 2.5l2.8 6.4 6.9.6-5.2 4.6 1.6 6.8L12 17.6l-6.1 3.3 1.6-6.8-5.2-4.6 6.9-.6L12 2.5Z" />
    </svg>
  )
}
{
  name === "check-circle" && (
    <svg viewBox="0 0 24 24" class={className} {...common} aria-hidden="true">
      <circle cx="12" cy="12" r="9" />
      <path d="M8.5 12.3l2.5 2.5 4.7-5" />
    </svg>
  )
}
{
  name === "x-circle" && (
    <svg viewBox="0 0 24 24" class={className} {...common} aria-hidden="true">
      <circle cx="12" cy="12" r="9" />
      <path d="M9.5 9.5l5 5M14.5 9.5l-5 5" />
    </svg>
  )
}
{
  name === "check" && (
    <svg viewBox="0 0 24 24" class={className} {...common} aria-hidden="true">
      <path d="M4.5 12.5l5 5L19.5 7" />
    </svg>
  )
}
{
  name === "book-open" && (
    <svg viewBox="0 0 24 24" class={className} {...common} aria-hidden="true">
      <path d="M4 5h6a2 2 0 0 1 2 2v13a2 2 0 0 0-2-2H4V5Z" />
      <path d="M20 5h-6a2 2 0 0 0-2 2v13a2 2 0 0 1 2-2h6V5Z" />
    </svg>
  )
}
{
  name === "trending-up" && (
    <svg viewBox="0 0 24 24" class={className} {...common} aria-hidden="true">
      <path d="M3 17l6-6 4 4 8-9" />
      <path d="M15 6h6v6" />
    </svg>
  )
}
{
  name === "phone" && (
    <svg viewBox="0 0 24 24" class={className} {...common} aria-hidden="true">
      <path d="M5 4h3.5l1.5 4.5-2 1.5a12 12 0 0 0 6 6l1.5-2 4.5 1.5V19a2 2 0 0 1-2 2C10.5 21 3 13.5 3 6a2 2 0 0 1 2-2Z" />
    </svg>
  )
}
{
  name === "mail" && (
    <svg viewBox="0 0 24 24" class={className} {...common} aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="M3.5 6.5 12 13l8.5-6.5" />
    </svg>
  )
}
{
  name === "map-pin" && (
    <svg viewBox="0 0 24 24" class={className} {...common} aria-hidden="true">
      <path d="M12 21s7-6.5 7-11.5A7 7 0 0 0 5 9.5C5 14.5 12 21 12 21Z" />
      <circle cx="12" cy="9.5" r="2.3" />
    </svg>
  )
}
{
  name === "message-circle" && (
    <svg viewBox="0 0 24 24" class={className} {...common} aria-hidden="true">
      <path d="M21 11.5a8.5 8.5 0 0 1-12.4 7.6L3 20l1.1-5.3A8.5 8.5 0 1 1 21 11.5Z" />
    </svg>
  )
}
{
  name === "clock" && (
    <svg viewBox="0 0 24 24" class={className} {...common} aria-hidden="true">
      <circle cx="12" cy="12" r="8.5" />
      <path d="M12 7.5V12l3 1.8" />
    </svg>
  )
}
{
  name === "wallet" && (
    <svg viewBox="0 0 24 24" class={className} {...common} aria-hidden="true">
      <path d="M3 7.5A2.5 2.5 0 0 1 5.5 5H18v3" />
      <rect x="3" y="7.5" width="18" height="12" rx="2" />
      <circle cx="16.5" cy="13.5" r="1.2" fill="currentColor" stroke="none" />
    </svg>
  )
}
{
  name === "layers" && (
    <svg viewBox="0 0 24 24" class={className} {...common} aria-hidden="true">
      <path d="M12 3.5 3.5 8l8.5 4.5L20.5 8 12 3.5Z" />
      <path d="M3.5 12.5 12 17l8.5-4.5" />
      <path d="M3.5 16.5 12 21l8.5-4.5" />
    </svg>
  )
}
{
  name === "award" && (
    <svg viewBox="0 0 24 24" class={className} {...common} aria-hidden="true">
      <circle cx="12" cy="9" r="5.5" />
      <path d="M8.6 13.8 7.5 21l4.5-2.4 4.5 2.4-1.1-7.2" />
    </svg>
  )
}
{
  name === "route" && (
    <svg viewBox="0 0 24 24" class={className} {...common} aria-hidden="true">
      <circle cx="6" cy="18" r="2.5" />
      <circle cx="18" cy="6" r="2.5" />
      <path d="M8.5 18h5a4 4 0 0 0 0-8h-3a4 4 0 0 1 0-8h1" />
    </svg>
  )
}
