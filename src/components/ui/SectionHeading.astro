---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: "left" | "center";
  /** Editorial section number, e.g. "01" — shown opposite the eyebrow. */
  index?: string;
}
// The former `light` prop is gone: every surface is dark since the palette was
// reduced to gold and black, so there is no longer a background that needs the
// darker gold-700 for contrast.
const { eyebrow, title, subtitle, align = "center", index } = Astro.props;

const alignClass = align === "center" ? "text-center items-center" : "text-left items-start";
---

<div class:list={["flex flex-col", alignClass]} data-reveal>
  {
    (eyebrow || index) && (
      <div
        class:list={[
          "mb-6 flex w-full items-center gap-4",
          align === "center" ? "justify-center" : "justify-start",
        ]}
      >
        {index && <span class="section-index text-gold-500">{index}</span>}
        {index && <span class="h-px w-10 bg-paper/25" aria-hidden="true" />}
        {eyebrow && <span class="eyebrow text-gold-500">{eyebrow}</span>}
      </div>
    )
  }
  <h2
    class:list={[
      "display max-w-4xl text-paper",
      align === "center" ? "text-balance" : "",
    ]}
  >
    {title}
  </h2>
  {
    subtitle && (
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-paper/60 sm:text-lg">{subtitle}</p>
    )
  }
</div>
