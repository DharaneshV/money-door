---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: "left" | "center";
  light?: boolean; // set true when this section sits on a light/paper background
}
const { eyebrow, title, subtitle, align = "center", light = false } = Astro.props;

const alignClass = align === "center" ? "text-center items-center" : "text-left items-start";
---

<div class:list={["flex flex-col gap-3", alignClass]}>
  {
    eyebrow && (
      <span
        class:list={[
          "font-heading text-xs font-semibold uppercase tracking-[0.2em]",
          light ? "text-gold-700" : "text-gold-500",
        ]}
      >
        {eyebrow}
      </span>
    )
  }
  <h2
    class:list={[
      "font-heading text-3xl font-bold sm:text-4xl",
      light ? "text-ink-950" : "text-paper",
    ]}
  >
    {title}
  </h2>
  {
    subtitle && (
      <p class:list={["max-w-2xl text-base sm:text-lg", light ? "text-ink-700" : "text-paper/70"]}>
        {subtitle}
      </p>
    )
  }
</div>
