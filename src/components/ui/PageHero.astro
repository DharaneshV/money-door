---
import Container from "./Container.astro";

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
}
const { eyebrow, title, subtitle } = Astro.props;
---

{/* No bottom border: the seam system blends this into whatever section
    follows, and a hairline would put back the hard edge it removes. */}
<section class="surface-ink relative overflow-hidden">
  <div
    class="pointer-events-none absolute right-0 top-0 h-[min(30rem,80vw)] w-[min(30rem,80vw)] translate-x-1/3 -translate-y-1/2 rounded-full bg-gold-500/8 blur-3xl"
    aria-hidden="true"
  >
  </div>
  {/* min-h keeps the hero a deliberate full screen rather than ending
      mid-content, minus the header height so the first section below still
      peeks in and signals there's more to scroll.

      Asymmetric padding on purpose: the sticky header already supplies visual
      space above, so a symmetric 9rem left a dead gap between the nav and the
      first line of text. Weight sits below the content instead. */}
  <Container
    width="wide"
    class="relative flex min-h-[calc(88svh-7.5rem)] flex-col justify-center pb-[clamp(3rem,7vw,6.5rem)] pt-[clamp(1.25rem,2.5vw,2.5rem)]"
    data-reveal
  >
    {
      eyebrow && (
        <div class="mb-8 flex items-center gap-4">
          <span class="h-px w-10 bg-gold-500/60" aria-hidden="true" />
          <span class="eyebrow text-gold-500">{eyebrow}</span>
        </div>
      )
    }
    <h1 class="display max-w-4xl text-paper">{title}</h1>
    {subtitle && <p class="mt-8 max-w-2xl text-base leading-relaxed text-paper/60 sm:text-lg">{subtitle}</p>}
  </Container>
</section>
