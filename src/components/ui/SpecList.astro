---
import Icon from "./Icon.astro";

// Hairline-separated icon + label + value rows — the spec-sheet payload used
// inside the program tabs and on the trading pages.
//
// Deliberately not built on `.edit-row`: that utility carries a hover
// background and is meant for clickable index rows. These are static data.
interface Props {
  items: {
    icon?: Parameters<typeof Icon>[0]["name"];
    label: string;
    value?: string;
  }[];
  class?: string;
}
// The former `light` prop is gone along with the off-white sections.
const { items, class: className = "" } = Astro.props;
---

<dl class:list={["flex flex-col", className]}>
  {
    items.map((item) => (
      <div class="spec-row">
        <dt class="flex items-center gap-3 text-sm text-paper/60">
          {item.icon && <Icon name={item.icon} class="h-4 w-4 flex-none text-gold-500" />}
          {item.label}
        </dt>
        {item.value && (
          <dd class="text-right font-heading text-sm font-semibold text-paper">{item.value}</dd>
        )}
      </div>
    ))
  }
</dl>
