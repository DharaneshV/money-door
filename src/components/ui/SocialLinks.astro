---
import { socials } from "../../data/site";

// The official social channels, rendered in each platform's own brand colour.
//
// Single source of truth: the icon paths and brand colours used to be
// copy-pasted into both Footer.astro and JoinAside.astro, so adding a channel
// meant editing two files and any drift between them was invisible until
// someone noticed a missing icon on one page.
//
// The brand colour is applied on hover (and always, at `tone="brand"`) rather
// than at rest in the muted variant: six saturated logos sitting in a row at
// full strength pull the eye away from the page's own black-and-gold identity,
// which is why most sites grey them out until you reach for one.
interface Props {
  /** "muted" greys the icons until hover; "brand" paints them at all times. */
  tone?: "muted" | "brand";
  /** Diameter of the tap target. Kept >= 44px on touch by the caller. */
  size?: "sm" | "md";
  class?: string;
}
const { tone = "muted", size = "md", class: className } = Astro.props;

// Official brand hexes. X is deliberately near-black — its own mark is
// monochrome, so a colour would be an invention.
const BRAND: Record<string, string> = {
  youtube: "#FF0000",
  instagram: "#E4405F",
  facebook: "#1877F2",
  telegram: "#26A5E4",
  x: "#FFFFFF",
  linkedin: "#0A66C2",
};

const PATHS: Record<string, string> = {
  youtube:
    "M21.8 8.1a2.8 2.8 0 0 0-2-2C18.1 5.6 12 5.6 12 5.6s-6.1 0-7.8.5a2.8 2.8 0 0 0-2 2A29 29 0 0 0 1.7 12a29 29 0 0 0 .5 3.9 2.8 2.8 0 0 0 2 2c1.7.5 7.8.5 7.8.5s6.1 0 7.8-.5a2.8 2.8 0 0 0 2-2 29 29 0 0 0 .5-3.9 29 29 0 0 0-.5-3.9ZM9.9 15.2V8.8l5.4 3.2-5.4 3.2Z",
  instagram:
    "M12 2c2.7 0 3.06.01 4.12.06 1.06.05 1.79.22 2.43.47.66.26 1.21.6 1.76 1.15.5.5.9 1.1 1.15 1.76.25.64.42 1.37.47 2.43.05 1.06.06 1.42.06 4.12s-.01 3.06-.06 4.12c-.05 1.06-.22 1.79-.47 2.43a4.9 4.9 0 0 1-1.15 1.76 4.9 4.9 0 0 1-1.76 1.15c-.64.25-1.37.42-2.43.47-1.06.05-1.42.06-4.12.06s-3.06-.01-4.12-.06c-1.06-.05-1.79-.22-2.43-.47a4.9 4.9 0 0 1-1.76-1.15 4.9 4.9 0 0 1-1.15-1.76c-.25-.64-.42-1.37-.47-2.43C2.01 15.06 2 14.7 2 12s.01-3.06.06-4.12c.05-1.06.22-1.79.47-2.43.26-.66.6-1.21 1.15-1.76A4.9 4.9 0 0 1 5.44 2.53c.64-.25 1.37-.42 2.43-.47C8.94 2.01 9.3 2 12 2Zm0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4Zm5.2-8.4a1.17 1.17 0 1 1-2.34 0 1.17 1.17 0 0 1 2.34 0Z",
  facebook:
    "M13.5 21v-8h2.7l.4-3.1h-3.1V8c0-.9.25-1.5 1.55-1.5H16.7V3.7c-.28-.04-1.24-.12-2.36-.12-2.33 0-3.93 1.42-3.93 4.03V9.9H8v3.1h2.4v8h3.1Z",
  telegram:
    "M21.6 4.2 2.9 11.5c-1.28.5-1.27 1.2-.23 1.52l4.8 1.5 1.86 5.66c.22.6.4.85.83.85.36 0 .55-.16.8-.4l1.9-1.85 4.02 2.97c.74.41 1.27.2 1.46-.68l2.63-12.4c.28-1.16-.4-1.66-1.35-1.4Z",
  x: "M17.53 3h3.02l-6.6 7.54L21.75 21h-6.06l-4.75-6.2L5.5 21H2.47l7.06-8.07L2.25 3h6.22l4.29 5.67L17.53 3Zm-1.06 16.16h1.67L7.6 4.75H5.8l10.67 14.41Z",
  linkedin:
    "M6.94 8.5H3.56V20.4h3.38V8.5ZM5.25 3.6a1.96 1.96 0 1 0 0 3.92 1.96 1.96 0 0 0 0-3.92ZM20.45 20.4h-3.37v-6.2c0-1.48-.03-3.38-2.06-3.38-2.07 0-2.39 1.62-2.39 3.28v6.3H9.27V8.5h3.24v1.63h.05c.45-.85 1.56-1.75 3.2-1.75 3.43 0 4.06 2.26 4.06 5.19v6.83Z",
};

const live = socials.filter((s) => s.url && PATHS[s.icon]);
const iconPx = size === "sm" ? 16 : 18;
---

{
  live.length > 0 && (
    <div class:list={["socials", `socials--${tone}`, `socials--${size}`, className]}>
      {live.map((s) => (
        <a
          href={s.url as string}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={s.name}
          class="socials__link"
          style={`--brand:${BRAND[s.icon] ?? "var(--color-gold-400)"}`}
        >
          <svg width={iconPx} height={iconPx} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={PATHS[s.icon]} />
          </svg>
        </a>
      ))}
    </div>
  )
}

<style>
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
  .socials__link {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--color-paper) 12%, transparent);
    transition:
      color 0.28s ease,
      border-color 0.28s ease,
      background-color 0.28s ease,
      transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* 44px on touch, tighter where there's a mouse. */
  .socials--md .socials__link {
    height: 2.75rem;
    width: 2.75rem;
  }
  .socials--sm .socials__link {
    height: 2.75rem;
    width: 2.75rem;
  }
  @media (pointer: fine) {
    .socials--md .socials__link {
      height: 2.35rem;
      width: 2.35rem;
    }
    .socials--sm .socials__link {
      height: 2.25rem;
      width: 2.25rem;
    }
  }

  .socials--muted .socials__link {
    color: color-mix(in srgb, var(--color-paper) 55%, transparent);
  }
  .socials--brand .socials__link {
    color: var(--brand);
    border-color: color-mix(in srgb, var(--brand) 40%, transparent);
  }

  /* Brand colour is the reward for reaching for one, not the resting state.
     Six saturated logos at full strength sat louder than anything else in the
     footer; muted until hover keeps the row quiet and still identifiable.
     The hover itself is blended toward the page rather than pure brand, since
     full-strength red and blue against near-black is a harsh jump. */
  .socials__link:hover {
    color: color-mix(in srgb, var(--brand) 82%, var(--color-paper));
    border-color: color-mix(in srgb, var(--brand) 45%, transparent);
    background: color-mix(in srgb, var(--brand) 9%, transparent);
    transform: translateY(-2px);
  }
  .socials__link:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .socials__link {
      transition: none;
    }
    .socials__link:hover {
      transform: none;
    }
  }
</style>
