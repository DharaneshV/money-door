---
import BaseLayout from "./BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";
import RiskDisclaimer from "../components/ui/RiskDisclaimer.astro";

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  category: string;
}
const { title, description, publishDate, category } = Astro.props;
const dateLabel = publishDate.toLocaleDateString("en-IN", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: publishDate.toISOString(),
  articleSection: category,
  author: { "@type": "Organization", name: "Money Door FX Academy" },
  publisher: { "@type": "Organization", name: "Money Door FX Academy" },
};
---

<BaseLayout title={title} description={description} schema={articleSchema}>
  <article>
    <header class="border-b border-ink-700 bg-ink-950 py-14">
      <Container class="mx-auto flex max-w-3xl flex-col gap-4">
        <a href="/blog/" class="text-sm text-gold-400 hover:text-gold-300">&larr; Back to Blog</a>
        <span class="w-fit rounded-full bg-gold-500/10 px-3 py-1 text-xs font-semibold text-gold-400">
          {category}
        </span>
        <h1 class="font-heading text-3xl font-bold sm:text-4xl">{title}</h1>
        <p class="text-lg text-paper/65">{description}</p>
        <time class="text-sm text-paper/40" datetime={publishDate.toISOString()}>{dateLabel}</time>
      </Container>
    </header>

    <div class="bg-ink-950 py-14">
      <Container class="mx-auto max-w-3xl">
        <div
          class="flex flex-col gap-5 text-base leading-relaxed text-paper/75 [&_h2]:mt-8 [&_h2]:font-heading [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-paper [&_h3]:mt-6 [&_h3]:font-heading [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:text-paper [&_strong]:text-paper [&_ul]:flex [&_ul]:list-disc [&_ul]:flex-col [&_ul]:gap-2 [&_ul]:pl-5 [&_ol]:flex [&_ol]:list-decimal [&_ol]:flex-col [&_ol]:gap-2 [&_ol]:pl-5 [&_hr]:my-4 [&_hr]:border-ink-700 [&_em]:text-paper/50 [&_a]:text-gold-400 [&_a]:underline"
        >
          <slot />
        </div>
        <div class="mt-10">
          <RiskDisclaimer />
        </div>
      </Container>
    </div>

    <section class="bg-ink-900 py-14">
      <Container class="flex flex-col items-center gap-5 text-center">
        <h2 class="font-heading text-2xl font-bold">Want to learn this properly?</h2>
        <p class="max-w-lg text-base text-paper/70">
          Our structured programs take you from market basics through to disciplined, independent
          trading — with live market mentorship along the way.
        </p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <Button href="/courses/" arrow>Explore Courses</Button>
          <Button href="/contact/" variant="secondary">Book Free Consultation</Button>
        </div>
      </Container>
    </section>
  </article>
</BaseLayout>
