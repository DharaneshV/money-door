---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Container from "../components/ui/Container.astro";
import TestimonialCard from "../components/cards/TestimonialCard.astro";
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon.astro";

// Only genuine, client-supplied testimonials marked `published: true` render here.
const testimonials = await getCollection("testimonials", ({ data }) => data.published);
---

<BaseLayout
  title="Student Reviews"
  description="Student feedback and success stories from Money Door FX Academy — focused on learning outcomes and skill development, not profit claims."
>
  <PageHero
    eyebrow="Student Success Stories"
    title="Hear From Our Students"
    subtitle="Real feedback from real students — focused on what they learned and how their approach changed."
  />

  <section class="surface-ink py-section">
    <Container>
      {
        testimonials.length > 0 ? (
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {testimonials.map((t) => (
              <TestimonialCard {...t.data} />
            ))}
          </div>
        ) : (
          <div class="mx-auto flex max-w-xl flex-col items-center gap-4  border border-dashed border-paper/12 px-8 py-16 text-center">
            <Icon name="message-circle" class="h-10 w-10 text-gold-500" />
            <h2 class="font-heading text-xl font-bold text-paper">Student stories, coming soon</h2>
            <p class="text-sm leading-relaxed text-paper/60">
              We're currently collecting written and video feedback from our students. Rather than
              publish invented reviews, we'll add genuine stories here as they come in — focused
              on learning outcomes and skill development rather than profit claims.
            </p>
            <p class="text-sm text-paper/60">
              Already a student? We'd love to hear from you.
            </p>
            <div class="pt-2">
              <Button href="/join/" variant="secondary" arrow>Share Your Experience</Button>
            </div>
          </div>
        )
      }
    </Container>
  </section>

  <section class="surface-ink-raised py-section">
    <Container class="mx-auto flex max-w-2xl flex-col items-center gap-4 text-center">
      <h2 class="font-heading text-2xl font-bold sm:text-3xl">A Note on Testimonials</h2>
      <p class="text-base leading-relaxed text-paper/70">
        Any student experience shared here reflects that individual's own results and is not a
        prediction or guarantee of what any other student will achieve. Trading involves risk, and
        outcomes depend on each trader's own decisions, discipline, and market conditions.
      </p>
      <div class="pt-2">
        <Button href="/courses/" arrow>Explore Our Courses</Button>
      </div>
    </Container>
  </section>
</BaseLayout>
