---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import MarqueeBand from "../components/sections/MarqueeBand.astro";
import PathCards from "../components/sections/PathCards.astro";
import WhyChooseUs from "../components/sections/WhyChooseUs.astro";
import AboutTeaser from "../components/sections/AboutTeaser.astro";
import DecisionFramework from "../components/sections/DecisionFramework.astro";
import ChiefTrainerTeaser from "../components/sections/ChiefTrainerTeaser.astro";
import ProgramsSection from "../components/sections/ProgramsSection.astro";
import StudentJourney from "../components/sections/StudentJourney.astro";
import ComparisonSection from "../components/sections/ComparisonSection.astro";
import TestimonialsSection from "../components/sections/TestimonialsSection.astro";
import BlogTeaser from "../components/sections/BlogTeaser.astro";
---

<BaseLayout
  title="Money Door FX Academy — Master Gold Trading with Confidence"
  description="India's trusted Gold (XAU/USD) & Forex trading academy. Structured courses, live market mentorship, and disciplined risk management from a Chief Trainer with 18+ years of experience."
>
  <Hero />
  <MarqueeBand />
  <PathCards />
  <AboutTeaser />
  <WhyChooseUs />
  {/* Sits directly after WhyChooseUs so the "why us" case runs as one block:
      the practical reasons first, then the methodology that backs them. */}
  <DecisionFramework index="04" />
  <ChiefTrainerTeaser />
  <ProgramsSection />
  <StudentJourney />
  <ComparisonSection />
  <MarqueeBand items={["Gold XAU/USD", "Forex Majors", "Risk Management", "Trading Psychology"]} variant="gold" />
  <TestimonialsSection />
  <BlogTeaser />
</BaseLayout>
