---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Container from "../components/ui/Container.astro";
import RiskDisclaimer from "../components/ui/RiskDisclaimer.astro";
import Button from "../components/ui/Button.astro";
import EconomicCalendarWidget from "../components/sections/EconomicCalendarWidget.astro";

// TradingView's embed reads its config from the script tag's text content.
// Passed via set:html so Astro treats it as data, not JavaScript to compile.
---

<BaseLayout
  title="Economic Calendar"
  description="Live economic calendar for Gold and Forex traders — track high-impact news releases that move XAU/USD and major currency pairs."
>
  <PageHero
    eyebrow="Economic Calendar"
    title="Economic Calendar"
    subtitle="High-impact economic releases move Gold and Forex sharply. Knowing when they land is part of managing risk."
  />

  <section class="surface-ink py-section">
    <Container class="flex flex-col gap-8">
      <div class="surface-card p-4">
        {/* Live data comes from TradingView's free embeddable widget — real market
            data from a recognized provider, rather than anything we generate. */}
        <EconomicCalendarWidget height={620} />
      </div>

      <div class="mx-auto max-w-3xl">
        <RiskDisclaimer />
        <p class="mt-4 text-center text-xs text-paper/40">
          Economic calendar data is provided by TradingView. Money Door FX Academy does not
          produce, verify, or guarantee the accuracy of this third-party data, and shares it for
          educational reference only.
        </p>
      </div>
    </Container>
  </section>

  <section class="surface-ink-raised py-section">
    <Container class="mx-auto flex max-w-3xl flex-col gap-4 text-center">
      <h2 class="font-heading text-2xl font-bold sm:text-3xl">How Traders Use This</h2>
      <p class="text-base leading-relaxed text-paper/70">
        For most students — especially beginners — the calendar isn't a tool for trading the news.
        It's a tool for knowing when <em class="text-paper/85">not</em> to be carelessly
        positioned. Spreads widen, volatility spikes, and stops can be hit by noise that has
        nothing to do with your analysis. Checking the calendar before a session is part of a
        disciplined routine.
      </p>
      <div class="pt-2">
        <Button href="/daily-market-analysis/" variant="secondary" arrow>
          See How We Analyze the Market
        </Button>
      </div>
    </Container>
  </section>
</BaseLayout>
