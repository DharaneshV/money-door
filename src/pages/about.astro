---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Container from "../components/ui/Container.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon.astro";

// Rebuilt on the site's current design system. The previous version predated
// the gold/black palette pass and still used centred `font-heading` headings,
// five-column card grids, and a `light` prop that no longer exists — plus
// `text-ink-800` (the card surface colour) as body text on a dark card, which
// rendered the entire philosophy list invisible.

const stats = [
  { to: 18, suffix: "+", label: "Years of trading experience" },
  { to: 2500, suffix: "+", label: "Students trained" },
  { to: 3, suffix: "", label: "Structured program levels" },
  { to: 6, suffix: "", label: "Named strategy models" },
];

const beliefs = [
  "Trading is a skill that can be learned.",
  "Discipline matters more than emotions.",
  "Risk management is more important than chasing profits.",
  "Consistency is built through preparation and practice.",
  "Continuous learning leads to continuous improvement.",
  "Knowledge creates confidence.",
  "Professional traders follow processes — not impulses.",
];

const expertise = [
  { icon: "target" as const, title: "Gold Trading (XAU/USD)", description: "Specialized education focused on Gold price action, market structure, and intraday trading techniques." },
  { icon: "trending-up" as const, title: "Forex Trading", description: "Comprehensive understanding of major currency pairs and market dynamics." },
  { icon: "shield-check" as const, title: "Risk Management", description: "Capital preservation through disciplined position sizing and structured risk control." },
  { icon: "chart-bar" as const, title: "Technical Analysis", description: "Price action, trend analysis, market structure, and practical chart reading." },
  { icon: "video" as const, title: "Live Market Learning", description: "Applying concepts in real-time market conditions through guided sessions." },
  { icon: "award" as const, title: "Prop Firm Education", description: "How proprietary trading firms work — evaluation models, rules and objectives, drawdown limits, account protection, and executing a strategy under funded-account conditions." },
];

const teachingSteps = [
  { title: "Learn", description: "Understand the fundamentals before entering the markets." },
  { title: "Observe", description: "Watch real market analysis and decision-making." },
  { title: "Practice", description: "Apply concepts using structured exercises and chart analysis." },
  { title: "Improve", description: "Review trades, identify mistakes, and refine your approach." },
  { title: "Grow", description: "Build the consistency and confidence of an independent trader." },
];

const values = [
  { title: "Integrity", description: "We believe honest education creates successful traders." },
  { title: "Discipline", description: "Every successful trader follows a structured process." },
  { title: "Consistency", description: "Long-term consistency is more important than short-term profits." },
  { title: "Continuous Learning", description: "Financial markets evolve every day. Traders should evolve too." },
  { title: "Professionalism", description: "We maintain the highest standards in education, communication, and student support." },
];

const audiences = [
  { title: "Beginner Traders", description: "People who want to learn trading from scratch." },
  { title: "Working Professionals", description: "Individuals looking for an additional skill or income opportunity." },
  { title: "Existing Traders", description: "Traders struggling with consistency and risk management." },
  { title: "Funded Traders", description: "Individuals preparing for prop firm evaluations and professional trading." },
  { title: "Serious Investors", description: "People who want to understand Gold and Forex markets before participating." },
];

const whyUs = [
  "Structured learning roadmap",
  "Gold trading specialization",
  "Live market sessions",
  "Practical trading education",
  "Focus on risk management",
  "One-on-one mentorship",
  "Supportive learning community",
  "Continuous skill development",
];
---

<BaseLayout
  title="About Us"
  description="Money Door FX Academy is a premium Gold (XAU/USD) & Forex trading education company. Learn about our story, mission, values, and teaching approach."
>
  <PageHero
    eyebrow="About Money Door FX Academy"
    title="Learn Trading the Right Way"
    subtitle="We believe successful trading is built on education, discipline, consistency, and continuous learning — not shortcuts or false promises."
  />

  {/* Story, set against the numbers rather than running as one centred column. */}
  <section class="surface-gold py-section">
    <Container width="wide">
      <div class="grid items-start gap-x-[clamp(2rem,6vw,6rem)] gap-y-12 lg:grid-cols-[1fr_1fr]">
        <div data-reveal>
          <SectionHeading eyebrow="Our Story" index="01" title="A Journey Built on Experience" align="left" />
          <div class="mt-8 flex max-w-xl flex-col gap-4 text-base leading-relaxed text-paper/70">
            <p>
              Money Door FX Academy was founded with a simple purpose: to help aspiring traders
              develop the knowledge, discipline, and confidence needed to navigate the financial
              markets responsibly.
            </p>
            <p>
              After more than 18 years studying and trading across Forex, Commodities, Equities and
              other financial markets, we recognised that many aspiring traders struggled — not
              because they lacked potential, but because they lacked structured education and
              proper guidance.
            </p>
            <p>
              Many beginners enter the markets with unrealistic expectations, relying on random
              tips, social media, or unverified trading signals. While some experience short-term
              success, many struggle to achieve consistency.
            </p>
            <p>
              We exist to bridge that gap — with a structured learning experience that emphasises
              market understanding, disciplined execution, and continuous improvement. Our goal is
              not simply to teach strategies, but to help students develop the mindset and habits
              of professional traders.
            </p>
          </div>
        </div>

        <dl class="flex flex-col self-center" data-reveal-stagger>
          {
            stats.map((s) => (
              <div class="edit-row flex items-baseline justify-between gap-6 py-[clamp(1.25rem,2.5vw,2rem)]">
                <dt class="font-display text-[clamp(2rem,1.4rem+2.4vw,3.5rem)] font-medium leading-none tabular-nums text-gold-500">
                  <span data-count-to={s.to} data-count-suffix={s.suffix}>0</span>
                </dt>
                <dd class="max-w-[14rem] text-right text-sm leading-snug text-paper/70">{s.label}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </Container>
  </section>

  <section class="surface-ink py-section">
    <Container width="wide" class="grid gap-[clamp(1.5rem,3vw,2.5rem)] lg:grid-cols-2" data-reveal-stagger>
      <div class="surface-card-warm card-lift flex flex-col gap-4 p-[clamp(1.75rem,3vw,2.75rem)]">
        <span class="eyebrow text-gold-400">Our Vision</span>
        <h2 class="font-display text-[clamp(1.5rem,1.2rem+1.2vw,2.1rem)] font-medium leading-tight text-paper">
          India's most trusted Gold trading academy
        </h2>
        <p class="text-base leading-relaxed text-paper/70">
          To become one of the world's leading trading education brands — empowering traders
          through knowledge, discipline and practical experience, and helping them make informed
          decisions with confidence.
        </p>
      </div>
      <div class="surface-card-warm card-lift flex flex-col gap-4 p-[clamp(1.75rem,3vw,2.75rem)]">
        <span class="eyebrow text-gold-400">Our Mission</span>
        <h2 class="font-display text-[clamp(1.5rem,1.2rem+1.2vw,2.1rem)] font-medium leading-tight text-paper">
          We build traders — not followers
        </h2>
        <p class="text-base leading-relaxed text-paper/70">
          To provide world-class trading education combining professional market knowledge, proven
          strategies, practical live market training, risk management and trading psychology.
        </p>
      </div>
    </Container>
  </section>

  {/* Beliefs as numbered editorial rows — the site's own language, and legible,
      which the previous dark-on-dark card version was not. */}
  <section class="surface-gold py-section">
    <Container width="wide" class="flex flex-col gap-[clamp(2.5rem,5vw,4rem)]">
      <SectionHeading eyebrow="Our Philosophy" index="02" title="What We Believe" align="left" />
      <div class="grid gap-x-[clamp(2rem,5vw,5rem)] md:grid-cols-2" data-reveal-stagger>
        {
          beliefs.map((b, i) => (
            <div class="edit-row group py-[clamp(1.25rem,2.5vw,1.85rem)]">
              <div class="flex items-baseline gap-6">
                <span class="section-index flex-none text-gold-500">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <p class="max-w-md font-display text-[clamp(1.05rem,0.9rem+0.6vw,1.35rem)] font-medium leading-snug text-paper transition-colors duration-500 group-hover:text-gold-300">
                  {b}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <section class="surface-ink py-section">
    <Container width="wide" class="flex flex-col gap-[clamp(2.5rem,5vw,4rem)]">
      <SectionHeading eyebrow="Our Expertise" index="03" title="Areas We Specialise In" align="left" />
      {/* Three columns, not five — five made every card a narrow sliver. */}
      <div class="grid gap-[clamp(1rem,2vw,1.75rem)] sm:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
        {
          expertise.map((e) => (
            <div class="surface-card card-lift flex flex-col gap-3 p-[clamp(1.5rem,2.5vw,2rem)]">
              <span class="icon-pop flex h-12 w-12 items-center justify-center rounded-full bg-gold-500/12 text-gold-500">
                <Icon name={e.icon} class="h-5 w-5" />
              </span>
              <h3 class="font-display text-[clamp(1.15rem,1rem+0.6vw,1.45rem)] font-medium leading-tight text-paper">
                {e.title}
              </h3>
              <p class="text-sm leading-relaxed text-paper/65">{e.description}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  {/* Teaching approach as a connected sequence rather than five loose columns. */}
  <section class="surface-gold py-section">
    <Container width="wide" class="flex flex-col gap-[clamp(2.5rem,5vw,4rem)]">
      <SectionHeading eyebrow="How We Teach" index="04" title="Learn, Observe, Practice, Improve, Grow" align="left" />
      <ol class="grid gap-[clamp(1rem,2vw,1.5rem)] sm:grid-cols-2 lg:grid-cols-5" data-reveal-stagger>
        {
          teachingSteps.map((step, i) => (
            <li class="surface-card-warm relative flex flex-col gap-3 p-[clamp(1.25rem,2.2vw,1.75rem)]">
              <span class="font-display text-[clamp(1.75rem,1.4rem+1.4vw,2.5rem)] font-medium leading-none text-gold-400/40">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3 class="font-display text-[clamp(1.15rem,1rem+0.6vw,1.4rem)] font-medium leading-tight text-paper">
                {step.title}
              </h3>
              <p class="text-sm leading-relaxed text-paper/65">{step.description}</p>
            </li>
          ))
        }
      </ol>
    </Container>
  </section>

  <section class="surface-ink py-section">
    <Container width="wide" class="flex flex-col gap-[clamp(2.5rem,5vw,4rem)]">
      <SectionHeading eyebrow="Our Core Values" index="05" title="What Guides Everything We Do" align="left" />
      <div class="flex flex-col" data-reveal-stagger>
        {
          values.map((v) => (
            <div class="edit-row group flex flex-col gap-2 py-[clamp(1.5rem,3vw,2.25rem)] md:flex-row md:items-baseline md:gap-12">
              <h3 class="w-full max-w-xs font-display text-[clamp(1.35rem,1.1rem+1.1vw,2rem)] font-medium leading-tight text-paper transition-colors duration-500 group-hover:text-gold-300">
                {v.title}
              </h3>
              <p class="max-w-xl text-base leading-relaxed text-paper/65">{v.description}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  {/* Brand promise as a full-bleed pull quote — the single most important
      sentence on the page, and the compliance stance in one line. */}
  <section class="surface-gold py-section">
    <Container width="wide" class="flex flex-col gap-8" data-reveal>
      <span class="eyebrow text-gold-500">Our Promise</span>
      <blockquote class="max-w-5xl border-l-2 border-gold-500 pl-[clamp(1.25rem,3vw,2.5rem)]">
        <p class="font-display text-[clamp(1.5rem,1.1rem+2vw,3rem)] font-medium leading-[1.15] tracking-[-0.01em] text-paper">
          We don't promise profits. We promise to teach a professional trading process that helps
          traders improve their decision-making through education, discipline, and consistent
          practice.
        </p>
      </blockquote>
    </Container>
  </section>

  <section class="surface-ink py-section">
    <Container width="wide">
      <div class="grid items-start gap-x-[clamp(2rem,6vw,6rem)] gap-y-12 lg:grid-cols-[1.15fr_0.85fr]">
        <div data-reveal>
          <SectionHeading eyebrow="Who We Help" index="06" title="Who This Academy Is For" align="left" />
          <div class="mt-8 flex flex-col">
            {
              audiences.map((a) => (
                <div class="edit-row group py-[clamp(1.1rem,2.2vw,1.6rem)]">
                  <h3 class="font-display text-[clamp(1.1rem,0.95rem+0.7vw,1.45rem)] font-medium leading-tight text-paper transition-colors duration-500 group-hover:text-gold-300">
                    {a.title}
                  </h3>
                  <p class="mt-1.5 max-w-md text-sm leading-relaxed text-paper/60">{a.description}</p>
                </div>
              ))
            }
          </div>
        </div>

        <div class="surface-card-warm p-[clamp(1.5rem,2.5vw,2rem)]" data-reveal>
          <span class="eyebrow text-gold-400">What You Get as a Student</span>
          <ul class="mt-6 flex flex-col gap-3">
            {
              whyUs.map((w) => (
                <li class="flex items-start gap-3 text-sm leading-relaxed text-paper/75">
                  <Icon name="check" class="mt-0.5 h-4 w-4 flex-none text-gold-500" />
                  <span>{w}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </Container>
  </section>

  <section class="surface-ink-raised py-section">
    <Container width="wide" class="flex flex-col items-center gap-6 text-center" data-reveal>
      <h2 class="max-w-3xl font-display text-[clamp(2rem,1.5rem+2.2vw,3.5rem)] font-medium leading-[1.05] tracking-[-0.015em] text-paper">
        Start Your Learning Journey
      </h2>
      <p class="max-w-xl text-base leading-relaxed text-paper/65 sm:text-lg">
        Whether you're taking your first steps in trading or refining existing skills, we're here
        to support your journey with structured education, practical guidance, and a commitment to
        long-term growth.
      </p>
      <div class="mt-2 flex flex-col gap-3 sm:flex-row">
        <Button href="/courses/" size="lg" arrow>Explore Our Courses</Button>
        <Button href="/join/consultation/" size="lg" variant="secondary">Book a Free 1-Hour Consultation</Button>
      </div>
    </Container>
  </section>
</BaseLayout>
