---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Container from "../components/ui/Container.astro";
import RiskDisclaimer from "../components/ui/RiskDisclaimer.astro";
import PartnerLogo from "../components/ui/PartnerLogo.astro";
import { partners, partnerDisclosure } from "../data/site";

// The marquee needs the list twice: the track translates a full -100% and the
// duplicate is what occupies the gap it leaves, so the loop reads as continuous
// rather than snapping back to the start.
const marqueeNames = [...partners, ...partners];
---

<BaseLayout
  title="Partnerships"
  description="The brokers, prop firms and platforms Money Door FX Academy's desk actually uses — listed with full referral disclosure so you can evaluate each one yourself."
>
  <PageHero
    eyebrow="Partnerships"
    title="Tools the Desk Actually Uses"
    subtitle="These are the brokers, prop firms and platforms we work with day to day. Every link below is a referral link, and we say so on each one — verify any firm's regulatory standing in your own country before you deposit."
  />

  {/* Motion lives here, on non-interactive wordmarks, rather than on the CTAs
      below. A referral button that slides away is a button that doesn't get
      clicked, and auto-moving interactive content also fails WCAG 2.2.2. */}
  <section class="surface-ink overflow-hidden py-[clamp(2rem,4vw,3.5rem)]">
    <div class="marquee" aria-hidden="true">
      {
        [0, 1].map(() => (
          <div class="marquee__track">
            {marqueeNames.map((p) => (
              <span class="flex flex-none items-center gap-[clamp(1.5rem,4vw,4rem)]">
                <span class="font-display text-[clamp(1.25rem,1rem+1.2vw,2.25rem)] font-medium whitespace-nowrap text-paper/35">
                  {p.name}
                </span>
                <span class="h-1 w-1 flex-none rounded-full bg-gold-500/50" />
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </section>

  {/* Full-width alternating bands, separated by a hairline gradient rule
      rather than card borders — a grid of equal cards is exactly what makes a
      page like this read as templated. */}
  <section class="surface-ink">
    {
      partners.map((p, i) => (
        <article class="partner-band" data-reveal>
          <Container width="wide">
            <div
              class:list={[
                "grid items-center gap-x-[clamp(2rem,6vw,6rem)] gap-y-8 py-[clamp(3.5rem,7vw,6rem)] lg:grid-cols-[1fr_1fr]",
              ]}
            >
              {/* Order flips on alternating rows at lg; on mobile everything
                  stacks in source order so the name always precedes its copy. */}
              <div class:list={[i % 2 === 1 && "lg:order-2"]}>
                {/* block, so the logo drops onto its own line rather than
                    sitting inline beside the category label. */}
                <span class="eyebrow block text-gold-500">{p.category}</span>
                <PartnerLogo name={p.name} slug={p.slug} class="mt-6 block" />
                <h2 class="mt-5 font-display text-[clamp(2rem,1.5rem+2.2vw,3.5rem)] font-medium leading-[1.02] tracking-[-0.015em] text-paper">
                  {p.name}
                </h2>
              </div>

              <div class:list={["flex flex-col gap-7", i % 2 === 1 && "lg:order-1"]}>
                <p class="max-w-xl text-base leading-relaxed text-paper/65 sm:text-lg">
                  {p.blurb}
                </p>

                <ul class="flex flex-wrap gap-2">
                  {p.pills.map((label) => (
                    <li class="pill">{label}</li>
                  ))}
                </ul>

                <div class="flex flex-col gap-3">
                  {/* rel="sponsored" marks this as paid placement to search
                      engines; noopener/noreferrer close the tab-nabbing hole
                      that target="_blank" otherwise opens. */}
                  <a
                    href={p.href}
                    target="_blank"
                    rel="sponsored noopener noreferrer"
                    data-partner={p.name}
                    class="partner-cta btn-shine group inline-flex w-fit items-center gap-3 rounded-full border border-gold-500 px-8 py-4 font-heading text-xs font-semibold uppercase tracking-[0.18em] text-gold-400 transition-colors duration-300 hover:bg-gold-500 hover:text-ink-950"
                  >
                    Visit {p.name}
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 16 16"
                      fill="none"
                      class="transition-transform duration-500 group-hover:translate-x-1"
                      aria-hidden="true"
                    >
                      <path
                        d="M4 12 12 4M5.5 4H12v6.5"
                        stroke="currentColor"
                        stroke-width="1.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    <span class="sr-only">(opens in a new tab)</span>
                  </a>

                  {/* FTC guidance requires the disclosure to sit with the link
                      itself, not in a page footer. Most affiliate terms void
                      the payout without it. */}
                  <p class="text-xs leading-relaxed text-paper/45">{partnerDisclosure}</p>
                </div>
              </div>
            </div>
          </Container>
        </article>
      ))
    }
  </section>

  <section class="surface-ink-raised py-section">
    <Container width="wide" class="flex flex-col gap-8" data-reveal>
      <h2 class="max-w-3xl font-display text-5xl font-medium leading-[1.05] tracking-[-0.015em] text-paper">
        Before You Sign Up Anywhere
      </h2>
      <div class="grid gap-x-[clamp(2rem,5vw,5rem)] md:grid-cols-2">
        {
          [
            "We are an education provider. Listing a firm here is not an endorsement of its financial soundness, nor advice that it suits your circumstances.",
            "Check the firm's regulatory status with your own country's regulator before depositing. Rules on offshore brokers differ sharply by jurisdiction.",
            "Read the fee schedule and withdrawal terms in full — spreads, commissions, swap charges and payout conditions all affect what you actually keep.",
            "Never deposit money you cannot afford to lose. Every firm on this page provides access to leveraged products that can lose money rapidly.",
          ].map((t, i) => (
            <div class="edit-row group py-[clamp(1.5rem,3vw,2.25rem)]">
              <div class="flex items-baseline gap-6">
                <span class="section-index flex-none text-gold-500">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <p class="max-w-md text-sm leading-relaxed text-paper/70 transition-colors duration-500 group-hover:text-paper">
                  {t}
                </p>
              </div>
            </div>
          ))
        }
      </div>
      <RiskDisclaimer />
    </Container>
  </section>
</BaseLayout>

<script>
  // Referral-click tracking. Fires `partner_click` with the partner name so the
  // owner can see which links actually convert rather than guessing.
  //
  // Deliberately provider-agnostic: it pushes to whichever of dataLayer /
  // gtag / plausible happens to be present and silently does nothing if none
  // are. No analytics vendor is installed on the site yet, so hard-wiring one
  // here would just throw on every click.
  function initPartnerTracking() {
    document.querySelectorAll<HTMLAnchorElement>(".partner-cta").forEach((el) => {
      if (el.dataset.tracked) return;
      el.dataset.tracked = "1";

      el.addEventListener("click", () => {
        const partner = el.dataset.partner || "unknown";
        const w = window as any;
        try {
          if (Array.isArray(w.dataLayer)) w.dataLayer.push({ event: "partner_click", partner });
          if (typeof w.gtag === "function") w.gtag("event", "partner_click", { partner });
          if (typeof w.plausible === "function") w.plausible("partner_click", { props: { partner } });
        } catch {
          /* tracking must never block the outbound navigation */
        }
      });
    });
  }

  initPartnerTracking();
  document.addEventListener("astro:page-load", initPartnerTracking);
</script>
