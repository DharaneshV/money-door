---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon.astro";
import trainerPortrait from "../assets/team/venkatesh-m-portrait.jpg";

const credentials = [
  "18+ Years of Trading Experience",
  "Professional Gold (XAUUSD) & Forex Trader",
  "Trained 2,500+ Students",
  "Creator of the PR & PC Trading Methodology",
  "Expert in Risk Management & Trading Psychology",
  "Live Market Mentor",
];

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Venkatesh M",
  jobTitle: "Chief Trainer",
  worksFor: { "@type": "EducationalOrganization", name: "Money Door FX Academy" },
  knowsAbout: ["Gold Trading", "Forex Trading", "Risk Management", "Trading Psychology"],
};
---

<BaseLayout
  title="Meet the Chief Trainer"
  description="Venkatesh M, Chief Trainer of Money Door FX Academy — 18+ years of trading experience, creator of the PR & PC trading methodology, trained 2,500+ students."
  schema={personSchema}
>
  <section class="border-b border-paper/12 bg-ink-950 py-section">
    <Container class="grid items-center gap-x-12 gap-y-10 lg:grid-cols-2">
      <div
        class="group mx-auto w-full max-w-xl overflow-hidden  border border-paper/12 lg:max-w-none"
        data-reveal
      >
        <Image
          src={trainerPortrait}
          alt="Venkatesh M, Chief Trainer of Money Door FX Academy, speaking at Forex Expo Dubai 2023"
          width={700}
          height={541}
          sizes="(min-width: 1024px) 45vw, (min-width: 640px) 80vw, 92vw"
          class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
        />
      </div>
      <div class="flex flex-col gap-4" data-reveal>
        <span class="font-heading text-xs font-semibold uppercase tracking-[0.25em] text-gold-500">
          Meet Your Chief Trainer
        </span>
        <h1 class="text-4xl font-bold sm:text-5xl">Venkatesh M</h1>
        <p class="font-heading text-lg font-semibold text-gold-400">
          Chief Trainer, Money Door FX Academy
        </p>
        <p class="text-base leading-relaxed text-paper/70">
          With over 18 years of trading experience across Forex, Commodities, Equities, and
          financial markets, Venkatesh has helped thousands of aspiring traders understand market
          structure, improve discipline, and develop practical trading skills.
        </p>
        <p class="text-base leading-relaxed text-paper/70">
          His teaching philosophy focuses on simplifying complex market concepts into structured,
          easy-to-follow learning that students can confidently apply in real market conditions.
        </p>
        <div class="flex flex-col gap-3 pt-2 sm:flex-row">
          <Button href="/what-we-teach/" arrow>Explore Courses</Button>
          <Button href="/join/" variant="secondary">Book Free Consultation</Button>
        </div>
      </div>
    </Container>
  </section>

  <section class="surface-ink-raised py-section">
    <Container class="flex flex-col gap-10">
      <h2 class="text-center text-2xl font-bold sm:text-3xl" data-reveal>Credentials &amp; Experience</h2>
      <div class="mx-auto grid max-w-4xl gap-5 sm:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
        {
          credentials.map((c) => (
            <div class="card-lift flex items-start gap-3  border border-paper/12 bg-ink-950 p-5 hover:border-gold-500/40">
              <Icon name="check-circle" class="mt-0.5 h-5 w-5 flex-none text-gold-500" />
              <span class="text-sm text-paper/80">{c}</span>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <section class="surface-gold py-section">
    <Container class="mx-auto max-w-3xl text-center" data-reveal>
      <Icon name="message-circle" class="mx-auto mb-4 h-10 w-10 text-gold-600" />
      <blockquote class="font-heading text-2xl font-semibold leading-snug text-paper sm:text-3xl">
        "Our goal is not just to teach trading — but to develop disciplined, consistent, and
        independent traders."
      </blockquote>
      <p class="mt-4 text-sm font-medium text-paper/55">— Venkatesh M, Chief Trainer</p>
    </Container>
  </section>

  <section class="surface-ink py-section">
    <Container class="flex flex-col gap-6 text-center" data-reveal>
      <h2 class="text-2xl font-bold sm:text-3xl">The PR &amp; PC Methodology</h2>
      <p class="mx-auto max-w-2xl text-base leading-relaxed text-paper/70">
        Venkatesh developed the Point of Reversal (PR) and Point of Continuation (PC) framework —
        the structured, rule-based approach to reading Gold and Forex price action that sits at
        the core of the MDC2 and MDC3 programs. Rather than relying on signals or guesswork, PR
        &amp; PC give students a repeatable process for identifying and managing trading
        opportunities.
      </p>
      <div>
        <Button href="/gold-trading/" variant="secondary" arrow>Learn About Our Strategies</Button>
      </div>
    </Container>
  </section>
</BaseLayout>
