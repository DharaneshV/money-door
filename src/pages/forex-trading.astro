---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Container from "../components/ui/Container.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import RiskDisclaimer from "../components/ui/RiskDisclaimer.astro";
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon.astro";

const pairs = [
  { pair: "EUR/USD", note: "The world's most traded currency pair — a common starting point for structure and trend reading." },
  { pair: "GBP/USD", note: "Known for sharper intraday moves, useful for practicing volatility-aware risk sizing." },
  { pair: "USD/JPY", note: "Often reacts strongly to macro and rate-driven catalysts." },
  { pair: "XAU/USD", note: "Gold, priced in US Dollars — our primary specialization, taught alongside the majors." },
];
---

<BaseLayout
  title="Forex Trading Education"
  description="Structured Forex trading education from Money Door FX Academy — major currency pairs, market structure, and the same disciplined risk management taught across every program."
>
  <PageHero
    eyebrow="Forex Trading"
    title="Forex Trading Education"
    subtitle="The same structured, rule-based approach we teach for Gold — applied to the major currency pairs."
  />

  <section class="surface-gold py-section">
    <Container width="wide">
      <div class="grid items-start gap-x-[clamp(2rem,6vw,6rem)] gap-y-10 lg:grid-cols-[1fr_1fr]">
        <div data-reveal>
          <SectionHeading
            eyebrow="The Approach"
            index="01"
            title="A Shared Foundation"
            align="left"
          />
        </div>
        <p
          class="max-w-xl text-base leading-relaxed text-paper/70 sm:text-lg lg:pt-4"
          data-reveal
        >
          Forex and Gold are read using the same underlying skills: market structure, price
          action, and disciplined risk control. Students who complete MDC1 and MDC2 apply Money
          Door's PR (Point of Reversal) and PC (Point of Continuation) framework across major
          currency pairs, not just Gold — building a versatile, repeatable process rather than a
          single market-specific trick.
        </p>
      </div>
    </Container>
  </section>

  <section class="surface-ink py-section">
    <Container width="wide" class="flex flex-col gap-[clamp(3rem,6vw,5rem)]">
      <div data-reveal>
        <SectionHeading
          eyebrow="What You'll Study"
          index="02"
          title="Major Pairs We Cover"
          align="left"
        />
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
        {
          pairs.map((p) => (
            <div class="surface-card card-lift flex flex-col gap-2 p-6">
              <span class="icon-pop flex h-10 w-10 items-center justify-center rounded-full bg-gold-500/10 text-gold-500">
                <Icon name="chart-bar" class="h-5 w-5" />
              </span>
              <h3 class="font-heading text-lg font-bold text-paper">{p.pair}</h3>
              <p class="text-sm text-paper/60">{p.note}</p>
            </div>
          ))
        }
      </div>
      <RiskDisclaimer />
    </Container>
  </section>

  <section class="surface-ink-raised py-section">
    <Container width="wide" class="flex flex-col items-center gap-6 text-center" data-reveal>
      <h2 class="max-w-3xl font-display text-5xl font-medium leading-[1.05] tracking-[-0.015em] text-paper">
        Start With the Fundamentals
      </h2>
      <p class="max-w-xl text-base leading-relaxed text-paper/65 sm:text-lg">
        MDC1 — Foundation Trader is a free, one-week introduction to Forex &amp; Gold market
        basics, platform setup, and risk management fundamentals.
      </p>
      <div class="flex flex-col gap-3 sm:flex-row">
        <Button href="/courses/mdc1/" arrow>Start with MDC1 (Free)</Button>
        <Button href="/join/" variant="secondary">Book Free Consultation</Button>
      </div>
    </Container>
  </section>
</BaseLayout>
