---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Container from "../components/ui/Container.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import RiskDisclaimer from "../components/ui/RiskDisclaimer.astro";
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon.astro";

const checklist = [
  "Verify the track record independently — don't rely on screenshots alone.",
  "Understand the strategy's risk per trade and historical drawdown, not just its headline returns.",
  "Check fee structures — performance fees, subscription costs, and spreads all affect real returns.",
  "Never allocate capital you can't afford to lose, no matter how strong a track record looks.",
  "Past performance of any trader or strategy does not guarantee future results.",
];
---

<BaseLayout
  title="Copy Trading Education"
  description="Understand how copy trading works, what to evaluate before following any strategy, and how to think about the risks — from Money Door FX Academy."
>
  <PageHero
    eyebrow="Copy Trading"
    title="Copy Trading Education"
    subtitle="We teach you how copy trading works and what to evaluate before following any strategy — we don't operate a signal or copy-trading service ourselves."
  />

  <section class="bg-paper py-section">
    <Container class="mx-auto flex max-w-3xl flex-col gap-4 text-center">
      <h2 class="font-heading text-3xl font-bold text-ink-950">What Is Copy Trading?</h2>
      <p class="text-base leading-relaxed text-ink-700">
        Copy trading lets one trader's positions be automatically mirrored into another person's
        account, typically through a broker's platform. It's often marketed as a passive way to
        participate in the markets — but every copied trade still carries full market risk, and
        the person copying is still responsible for the outcome, whether the strategy performs
        well or poorly.
      </p>
    </Container>
  </section>

  <section class="bg-ink-950 py-section">
    <Container class="flex flex-col gap-10">
      <SectionHeading eyebrow="Before You Copy Anyone" title="What to Evaluate" />
      <div class="mx-auto flex max-w-2xl flex-col gap-4">
        {
          checklist.map((c) => (
            <div class="flex items-start gap-3  border border-paper/12 bg-ink-900 p-4">
              <Icon name="shield-check" class="mt-0.5 h-5 w-5 flex-none text-gold-500" />
              <span class="text-sm text-paper/80">{c}</span>
            </div>
          ))
        }
      </div>
      <RiskDisclaimer />
    </Container>
  </section>

  <section class="bg-ink-900 py-section">
    <Container class="flex flex-col items-center gap-6 text-center">
      <h2 class="font-heading text-3xl font-bold sm:text-4xl">Learn to Trade Independently Instead</h2>
      <p class="max-w-xl text-base text-paper/70">
        Our core belief: independent, disciplined traders make better long-term decisions than
        those relying on someone else's positions. Our structured courses teach you to analyze
        the market and manage risk yourself.
      </p>
      <div class="flex flex-col gap-3 sm:flex-row">
        <Button href="/courses/" arrow>Explore Courses</Button>
        <Button href="/contact/" variant="secondary">Book Free Consultation</Button>
      </div>
    </Container>
  </section>
</BaseLayout>
