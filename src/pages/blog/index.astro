---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import BlogPostCard from "../../components/cards/BlogPostCard.astro";

const entries = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

// Two columns on the grid below, so eight posts read as a 2x4 board. Three
// columns made each tile too narrow for a real headline and pushed the
// description down to two words per line.
//
// Reading time from the actual body, at 200 wpm — a widely used average for
// adult non-fiction. Computed here rather than authored per post so it can
// never go stale when a post is edited.
const posts = entries.map((post) => ({
  ...post,
  readingMinutes: Math.max(1, Math.round(post.body.split(/\s+/).filter(Boolean).length / 200)),
}));
---

<BaseLayout
  title="Blog — Market Insights & Trading Education"
  description="Educational articles on Gold and Forex trading from Money Door FX Academy — risk management, trading psychology, market structure, and beginner guides."
>
  <PageHero
    eyebrow="Latest Market Insights"
    title="Trading Education Blog"
    subtitle="Practical, educational articles on how markets work and how disciplined traders approach them."
  />

  <section class="surface-ink py-section">
    <Container>
      {
        posts.length > 0 ? (
          <div class="grid gap-[clamp(1rem,2vw,1.75rem)] md:grid-cols-2" data-reveal-stagger>
            {posts.map((post) => (
              <BlogPostCard {...post.data} slug={post.id} readingMinutes={post.readingMinutes} />
            ))}
          </div>
        ) : (
          <p class="text-center text-paper/60">New articles are coming soon.</p>
        )
      }
    </Container>
  </section>
</BaseLayout>
