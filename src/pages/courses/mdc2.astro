---
import { getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import Button from "../../components/ui/Button.astro";
import Icon from "../../components/ui/Icon.astro";
import RiskDisclaimer from "../../components/ui/RiskDisclaimer.astro";
import CurriculumGrid from "../../components/sections/CurriculumGrid.astro";
import StrategyModelGrid from "../../components/sections/StrategyModelGrid.astro";
import IncludedList from "../../components/sections/IncludedList.astro";
import CourseOffer from "../../components/sections/CourseOffer.astro";
import { formatPrice } from "../../lib/pricing";

const program = await getEntry("programs", "mdc2");
if (!program) throw new Error("MDC2 program entry not found");
const {
  Content } = await render(program); const {   name,
  tagline,
  duration,
  price,
  currency,
  idealForList,
  highlights,
  outcome,
  curriculum,
  strategyModels,
  included,
  listPrice,
  priceLabel,
  bonuses,
  buildsOn,
} = program.data;
const priceDisplay = formatPrice(price, currency);

// Offers/price is deliberately omitted: schema.org expects ISO-4217 currency codes
// and USDT is not one, so declaring it would produce invalid markup.
const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  name: `MDC2 — ${name}`,
  description: tagline,
  provider: {
    "@type": "EducationalOrganization",
    name: "Money Door FX Academy",
    sameAs: "https://moneydoorfxacademy.com",
  },
  educationalLevel: "Intermediate",
};
---

<BaseLayout
  title={`MDC2 — ${name}`}
  description={`MDC2 — ${name}: Money Door FX Academy's core ${duration.toLowerCase()} program teaching the DPR, DPC, EPR, EPC, GPR & GPC trading models. ${tagline}.`}
  schema={courseSchema}
>
  <PageHero eyebrow={`MDC2 · ${priceDisplay} · ${duration}`} title={name} subtitle={tagline} />

  {/* Fee, standing discount and included benefits. Replaces the old single
      price strip, which had room for one number and none of the offer. */}
  <section class="surface-gold py-[clamp(2.5rem,5vw,4rem)]">
    <Container width="wide">
      <CourseOffer
        code="MDC2"
        price={price}
        listPrice={listPrice}
        currency={currency}
        priceLabel={priceLabel}
        bonuses={bonuses}
      />
    </Container>
  </section>

  <section class="surface-ink py-section">
    <Container width="wide">
      <div class="grid items-start gap-x-[clamp(2rem,6vw,6rem)] gap-y-10 lg:grid-cols-[1fr_1fr]">
        <div data-reveal>
          <SectionHeading
            eyebrow="About This Program"
            index="01"
            title="Learn the Professional Strategy"
            align="left"
          />
          <div class="prose-content mt-8 flex max-w-xl flex-col gap-4 text-base leading-relaxed text-paper/70">
            <Content />
          </div>
        </div>

        <div class="flex flex-col gap-6" data-reveal>
          <div class="surface-card p-[clamp(1.5rem,2.5vw,2rem)]">
            <h3 class="eyebrow text-gold-500">What You'll Learn</h3>
            <ul class="mt-4 flex flex-col gap-3">
              {
                highlights.map((h: string) => (
                  <li class="flex items-start gap-2 text-sm text-paper/80">
                    <Icon name="check" class="mt-0.5 h-4 w-4 flex-none text-gold-500" />
                    <span>{h}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="surface-card-warm p-[clamp(1.5rem,2.5vw,2rem)]">
            <h3 class="eyebrow text-gold-400">Outcome</h3>
            <p class="mt-3 text-sm leading-relaxed text-paper/80">{outcome}</p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  {
    strategyModels && (
      <section class="surface-gold py-section">
        <Container width="wide" class="flex flex-col gap-[clamp(2.5rem,5vw,4rem)]">
          <SectionHeading
            eyebrow="Exclusive Money Door Strategies"
            index="02"
            title="PR & PC"
            subtitle="The six models that sit under PR & PC. EMA 24, ATR 24, W.D. Gann 45° angle analysis, advanced price action, Smart Money Concepts and ICT concepts work together to validate each of them."
            align="left"
          />
          <StrategyModelGrid models={strategyModels} />
        </Container>
      </section>
    )
  }

  {
    curriculum && (
      <section class="surface-ink py-section">
        <Container width="wide" class="flex flex-col gap-[clamp(2.5rem,5vw,4rem)]">
          <SectionHeading eyebrow="Technical Mastery" index="03" title="Beyond PR & PC" align="left" />
          {buildsOn && (
            <div class="builds-on">
              <span class="builds-on__tick" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
                  <path d="m5 12.5 4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2.4"
                    stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <span><strong>{buildsOn}</strong> is included, then this program goes further:</span>
            </div>
          )}
          <CurriculumGrid sections={curriculum} />
          <RiskDisclaimer />
        </Container>
      </section>
    )
  }

  <section class="surface-ink-raised py-section">
    <Container width="wide" class="grid gap-x-[clamp(2rem,6vw,6rem)] gap-y-12 lg:grid-cols-[1fr_1fr]">
      {
        included && (
          <div data-reveal>
            <SectionHeading eyebrow="Exclusive Bonuses" index="04" title="What's Included" align="left" />
            <div class="mt-8">
              <IncludedList items={included} />
            </div>
          </div>
        )
      }

      {
        idealForList && (
          <div data-reveal>
            <span class="eyebrow text-gold-500">Best For</span>
            <ul class="mt-6 flex flex-col gap-3">
              {idealForList.map((label) => (
                <li class="flex items-start gap-2.5 text-base text-paper/80">
                  <Icon name="check-circle" class="mt-0.5 h-5 w-5 flex-none text-gold-500" />
                  <span>{label}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </Container>
  </section>

  <section class="surface-ink py-section">
    <Container width="wide" class="flex flex-col items-center gap-4 text-center" data-reveal>
      <h2 class="font-display text-[clamp(1.75rem,1.4rem+1.5vw,2.5rem)] font-medium text-paper">
        Ready to go further?
      </h2>
      <p class="max-w-lg text-base text-paper/70">
        Students preparing for funded-account evaluations or long-term independent trading move
        on to MDC3 — Elite Master Trader.
      </p>
      <Button href="/courses/mdc3/" arrow>View MDC3 — Elite Master Trader</Button>
    </Container>
  </section>
</BaseLayout>
