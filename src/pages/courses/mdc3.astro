---
import { getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import Icon from "../../components/ui/Icon.astro";
import RiskDisclaimer from "../../components/ui/RiskDisclaimer.astro";

const program = await getEntry("programs", "mdc3");
if (!program) throw new Error("MDC3 program entry not found");
const { Content } = await render(program);
const { name, tagline, duration, price, currency, idealFor, highlights, outcome } = program.data;
const priceDisplay = `${currency} ${price.toLocaleString("en-US")}`;

// Offers/price is deliberately omitted: schema.org expects ISO-4217 currency codes
// and USDT is not one, so declaring it would produce invalid markup.
const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  name: `MDC3 — ${name}`,
  description: tagline,
  provider: {
    "@type": "EducationalOrganization",
    name: "Money Door FX Academy",
    sameAs: "https://moneydoorfxacademy.com",
  },
  educationalLevel: "Advanced",
};
---

<BaseLayout
  title={`MDC3 — ${name}`}
  description={`MDC3 — ${name}: Money Door FX Academy's ${duration.toLowerCase()} one-to-one mentorship program. ${tagline}.`}
  schema={courseSchema}
>
  <section class="border-b border-paper/12 bg-ink-950 py-section">
    <Container class="flex flex-col items-center gap-4 text-center" data-reveal>
      <span class="font-heading text-xs font-semibold uppercase tracking-[0.25em] text-gold-500">MDC3</span>
      <h1 class="max-w-2xl font-heading text-4xl font-bold sm:text-5xl">{name}</h1>
      <p class="max-w-xl text-lg text-paper/70">{tagline}</p>
      <div class="mt-2 flex items-baseline gap-2">
        <span class="font-heading text-4xl font-bold text-gold-400">{priceDisplay}</span>
        <span class="text-paper/50">/ {duration}</span>
      </div>
      <div class="flex flex-col gap-3 pt-2 sm:flex-row">
        <Button href="/contact/" size="lg" arrow>Book Free Consultation</Button>
        <Button href="/courses/" size="lg" variant="secondary">Compare All Programs</Button>
      </div>
    </Container>
  </section>

  <section class="bg-ink-900 py-section">
    <Container class="grid gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2" data-reveal>
        <h2 class="font-heading text-2xl font-bold text-paper">About This Program</h2>
        <div class="prose-content mt-4 flex flex-col gap-4 text-base leading-relaxed text-paper/70">
          <Content />
        </div>
        <div class="mt-8  border border-paper/12 bg-ink-950 p-6">
          <p class="text-sm font-semibold text-paper">Ideal for</p>
          <p class="mt-1 text-sm text-paper/60">{idealFor}</p>
        </div>
      </div>
      <div class="flex flex-col gap-4" data-reveal>
        <div class=" border border-paper/12 bg-ink-950 p-6">
          <h3 class="font-heading text-sm font-semibold uppercase tracking-wide text-gold-500">
            What You'll Learn
          </h3>
          <ul class="mt-4 flex flex-col gap-3">
            {
              highlights.map((h: string) => (
                <li class="flex items-start gap-2 text-sm text-paper/80">
                  <Icon name="check" class="mt-0.5 h-4 w-4 flex-none text-gold-500" />
                  <span>{h}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class=" border border-gold-500/30 bg-gold-500/5 p-6">
          <h3 class="font-heading text-sm font-semibold uppercase tracking-wide text-gold-500">Outcome</h3>
          <p class="mt-3 text-sm leading-relaxed text-paper/75">{outcome}</p>
        </div>
      </div>
    </Container>
  </section>

  <section class="bg-ink-950 py-section">
    <Container class="flex flex-col gap-8">
      <RiskDisclaimer />
      <div class="flex flex-col items-center gap-4 text-center">
        <h2 class="font-heading text-2xl font-bold sm:text-3xl">Not sure if MDC3 is right for you yet?</h2>
        <p class="max-w-lg text-base text-paper/70">
          Book a free consultation and we'll help you assess whether to start here or build up
          through MDC1 and MDC2 first.
        </p>
        <Button href="/contact/" arrow>Book Free Consultation</Button>
      </div>
    </Container>
  </section>
</BaseLayout>
