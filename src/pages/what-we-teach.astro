    ],
  },
  {
    n: "12",
    title: "Trading Journal & Performance Review",
    icon: "book-open",
    items: [
      "Maintain a trading journal",
      "Record trade setups",
      "Evaluate risk",
      "Review mistakes",
      "Track performance metrics",
      "Improve decision making",
      "Build consistency over time",
    ],
  },
  {
    n: "13",
    title: "Trading Platforms & Tools",
    icon: "wallet",
    items: [
      "MetaTrader 4 (MT4)",
      "MetaTrader 5 (MT5)",
      "TradingView",
      "Platform navigation",
      "Order types",
      "Chart customization",
      "Indicators",
      "Alerts",
      "Templates",
      "Watchlists",
      "Trade execution",
      "Trade history",
    ],
  },
  {
    n: "14",
    title: "Trading Plan Development",
    icon: "route",
    items: [
      "Trading goals",
      "Daily routine",
      "Entry rules",
      "Exit rules",
      "Risk rules",
      "Capital allocation",
      "Performance targets",
      "Review process",
    ],
  },
  {
    n: "15",
    title: "One-to-One Mentorship (MDC3)",
    icon: "graduation-cap",
    items: [
      "Individual progress reviews",
      "Strategy clarification",
      "Trade evaluations",
      "Performance feedback",
      "Risk management guidance",
      "Personalized improvement plans",
    ],
  },
  {
    n: "16",
    title: "Continuous Learning & Community Support",
    icon: "message-circle",
    items: [
      "Weekly live sessions",
      "Market discussions",
      "Educational updates",
      "Trading community",
      "Strategy reviews",
      "Q&A sessions",
      "Ongoing learning resources",
    ],
  },
];

// A flat list of equally-weighted topics has no shape; themed groups do.
// Grouping is
// presentation only — every topic above appears exactly once below, and the
// check at the end of this block fails the build if one is ever dropped or
// duplicated while editing.
const byNumber = new Map(topics.map((t) => [t.n, t]));
const pick = (...ns: string[]) =>
  ns.map((n) => {
    const t = byNumber.get(n);
    if (!t) throw new Error(`what-we-teach: no topic "${n}"`);
    return t;
  });

const groups: Group[] = [
  {
    label: "The Markets",
    blurb: "The instruments we specialise in, and how each one actually behaves.",
    topics: pick("01", "02"),
  },
  {
    label: "Reading the Chart",
    blurb:
      "The analysis layer — how price is interpreted, and the proprietary models that interpretation feeds.",
    topics: pick("03", "04", "11"),
  },
  {
    label: "Execution & Risk",
    blurb:
      "Turning analysis into placed trades, sized properly, on a platform you know well.",
    topics: pick("05", "06", "13", "14", "12"),
  },
  {
    label: "Capital & Accounts",
    blurb:
      "The routes to trading larger capital — evaluations, copy trading, and managed-account structures.",
    topics: pick("07", "08", "09"),
  },
  {
    label: "Mindset & Support",
    blurb: "The parts that decide whether any of the above survives contact with a real market.",
    topics: pick("10", "15", "16"),
  },
];

// Build-time guard: grouping is hand-maintained, and a topic silently dropped
// from the page is exactly the kind of omission nobody notices in review.
const grouped = groups.flatMap((g) => g.topics.map((t) => t.n));
if (grouped.length !== topics.length || new Set(grouped).size !== topics.length) {
  throw new Error(
    `what-we-teach: grouped ${grouped.length} topics (${new Set(grouped).size} unique) ` +
      `but there are ${topics.length}. Every topic must appear in exactly one group.`
  );
}

// Display numbers are derived from the order topics are actually rendered in,
// not the order they happen to be authored in above.
//
// The numbers used to be hand-written on each topic and the grouping was added
// later, so the page counted 01 02 | 03 04 11 | 05 06 13 14 12 | 07 08 09 |
// 10 15 16 — visibly scrambled, and out of sequence even inside a single group.
// Deriving them means regrouping or adding a topic renumbers the page for free.
// Safe to mutate: the guard above has just proved each topic appears exactly
// once, and the `pick()` lookups by original number have all resolved.
let seq = 0;
for (const group of groups) {
  for (const topic of group.topics) {
    topic.n = String(++seq).padStart(2, "0");
  }
}

const whyChooseUs = [
  "18+ years of financial market experience",
  "Structured learning path (MDC1 → MDC2 → MDC3)",
  "Beginner to advanced curriculum",
  "Live market education",
  "Practical, rule-based trading methods",
  "Personalized mentorship",
  "Strong focus on risk management",
  "Professional trading discipline",
];
const programs = (await getCollection("programs")).sort((a, b) => a.data.order - b.data.order);

---

<BaseLayout
  title="What We Teach"
  description="A complete curriculum overview from Money Door FX Academy — Gold and Forex trading, technical analysis, our proprietary PR & PC strategy framework, risk management, and more, taught across MDC1, MDC2 and MDC3."
>
  <PageHero
    eyebrow="What We Teach"
    title="Master the Global Financial Markets"
    subtitle="Structured trading education designed to help aspiring traders understand how the financial markets work — technical knowledge, practical market analysis, disciplined risk management, and live market learning, whether you're a beginner or an experienced trader."
  />

  <section class="surface-gold py-section">
    <Container width="wide" class="max-w-3xl" data-reveal>
      <p class="text-base leading-relaxed text-paper/75 sm:text-lg">
        At Money Door FX Academy, we provide structured trading education designed to help
        aspiring traders understand how the financial markets work. Our training combines
        technical knowledge, practical market analysis, disciplined risk management, and live
        market learning.
      </p>
      <p class="mt-4 text-base leading-relaxed text-paper/75 sm:text-lg">
        Whether you are a beginner or an experienced trader, our curriculum is designed to build
        confidence through education, practice, and continuous learning — taught progressively
        through MDC1, MDC2 and MDC3.
      </p>
    </Container>
  </section>

  {/* Headline deliberately avoids counting the topics. A fixed number reads
      as a ceiling ("only 16 things") rather than as depth, and it would need
      updating every time the curriculum grows. */}
  <section class="surface-ink py-section">
    <Container width="wide" class="flex flex-col gap-[clamp(2.5rem,5vw,4rem)]">
      <SectionHeading
        eyebrow="Full Curriculum"
        title="What You'll Learn"
        subtitle="Open any topic to see exactly what's covered inside it."
        align="left"
      />
      <CurriculumAccordion groups={groups} />
    </Container>
  </section>

  {/* Prop-firm / funded-account training, pulled out of the topic list
      into its own band. It's the outcome many students are actually here for,
      and it carries terms that shouldn't be reduced to a bullet. */}
  <section class="surface-ink py-section">
    <Container width="wide">
      <div class="grid items-start gap-x-[clamp(2rem,6vw,6rem)] gap-y-10 lg:grid-cols-[1fr_1fr]">
        <div data-reveal>
          <SectionHeading
            eyebrow="Funded Accounts"
            title="Prop Firm & Funded Account Training"
            align="left"
          />
          <p class="mt-8 max-w-xl text-base leading-relaxed text-paper/70">
            Proprietary trading firms let traders demonstrate skill through a paid evaluation,
            then trade firm capital. Most candidates fail on the risk rules — maximum daily loss,
            maximum drawdown, minimum trading days — rather than on the profit target. We prepare
            students for that reality, phase by phase, inside MDC3.
          </p>
          <p class="mt-4 max-w-xl text-sm leading-relaxed text-paper/55">
            We are an education provider. We do not operate a prop firm, provide funding
            ourselves, or guarantee that any student will pass an evaluation.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <Button href="/funded-account-training/" arrow>Funded account training</Button>
            <Button href="/partnerships/" variant="secondary">See our prop firm partners</Button>
          </div>
        </div>

        <div class="flex flex-col gap-5" data-reveal>
          <div class="surface-card p-[clamp(1.5rem,2.5vw,2rem)]">
            <h3 class="eyebrow text-gold-500">What Evaluation Prep Covers</h3>
            <ul class="mt-4 grid gap-2.5 sm:grid-cols-2">
              {
                [
                  "Phase 1 & Phase 2 evaluations",
                  "Drawdown rules",
                  "Daily loss limits",
                  "Consistency rules",
                  "Risk scaling",
                  "Challenge planning",
                  "Trading journal discipline",
                  "Account management practices",
                ].map((item) => (
                  <li class="flex items-start gap-2.5 text-sm leading-relaxed text-paper/70">
                    <Icon name="check" class="mt-0.5 h-4 w-4 flex-none text-gold-500" />
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          {/* Same wording as the course pages — never "FREE $X account". */}
          <div class="surface-card-warm p-[clamp(1.5rem,2.5vw,2rem)]">
            <h3 class="eyebrow text-gold-400">Sponsored Evaluation Account</h3>
            <p class="mt-3 text-sm leading-relaxed text-paper/75">
              Eligible MDC2 and MDC3 students receive a sponsored prop firm evaluation account,
              subject to academy terms and partner availability.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  {/* The curriculum above answers "what is taught"; this answers "what does it
      cost and what comes with it" without sending the reader to another page. */}
  <section class="surface-ink-raised py-section">
    <Container width="wide" class="flex flex-col gap-[clamp(2rem,4vw,3rem)]">
      <SectionHeading
        eyebrow="Fees & Benefits"
        title="Quick Course Comparison"
        subtitle="All three programs currently carry a 50% discount, and each includes the $100 Money Door Copy Trading Strategy account fee at no charge."
        align="left"
      />
      <CourseComparison programs={programs} />
    </Container>
  </section>

  <section class="surface-gold py-section">
    <Container width="wide" class="flex flex-col gap-[clamp(2.5rem,5vw,4rem)]">
      <SectionHeading
        eyebrow="Why Money Door"
        title="Why Learn With Money Door FX Academy?"
        align="left"
      />
      <ul class="grid gap-x-[clamp(2rem,5vw,4rem)] gap-y-4 md:grid-cols-2" data-reveal-stagger>
        {
          whyChooseUs.map((point) => (
            <li class="flex items-start gap-3 text-base leading-relaxed text-paper/85">
              <Icon name="check-circle" class="mt-0.5 h-5 w-5 flex-none text-gold-500" />
              <span>{point}</span>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

  <section class="surface-ink-raised py-section">
    <Container width="wide" class="flex flex-col gap-8">
      <RiskDisclaimer variant="full" />
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <h2 class="font-display text-[clamp(1.75rem,1.4rem+1.5vw,2.5rem)] font-medium text-paper">
          Ready to start learning?
        </h2>
        <p class="max-w-lg text-base text-paper/70">
          MDC1 — Foundation Trader takes one month and is $100 with the current 50% offer. It's the place every Money Door
          student starts.
        </p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <Button href="/courses/mdc1/" arrow>Start with MDC1 — $100</Button>
          <Button href="/join/consultation/" variant="secondary">Book a Free 1-Hour Consultation</Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
