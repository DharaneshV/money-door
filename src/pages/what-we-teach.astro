---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Container from "../components/ui/Container.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Icon from "../components/ui/Icon.astro";
import Button from "../components/ui/Button.astro";
import RiskDisclaimer from "../components/ui/RiskDisclaimer.astro";
import CurriculumAccordion from "../components/sections/CurriculumAccordion.astro";
import CourseComparison from "../components/sections/CourseComparison.astro";
import { getCollection } from "astro:content";
import type { Topic, Group } from "../components/sections/CurriculumAccordion.astro";

// Full curriculum overview across all three MDC programs. Kept as a page-local
// array (not a content collection) — this is one page, not a repeated entity
