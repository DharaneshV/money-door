---

<BaseLayout
  title="Join Now"
  description="Register with Money Door FX Academy — tell us about yourself and we'll help you find the right starting point, or reach us directly on WhatsApp, phone or email."
>
  <PageHero
    eyebrow="Join Now"
    title="Start Your Trading Education"
    subtitle="Register below and we'll be in touch personally about the right program for you. Registration is free, opens no trading account, and involves no payment."
  />

  <section class="surface-ink py-section">
    <Container width="wide" class="grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <div id="register" class="surface-card p-[clamp(1.5rem,3vw,2.75rem)]">
          <h2 class="font-display text-[clamp(1.5rem,1.2rem+1.2vw,2.25rem)] font-medium leading-tight text-paper">
            Join Money Door FX Academy
          </h2>
          <p class="mt-3 max-w-md text-sm leading-relaxed text-paper/60">
            Two short steps. Tell us a bit about yourself and we'll help you find the right
            starting point.
          </p>
          <div class="mt-8">
            <RegisterForm />
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-6">
        <div class=" surface-card p-6">
          <h3 class="font-heading text-lg font-bold text-paper">Contact Details</h3>
          <div class="mt-4 flex flex-col gap-4">
            <a href={`tel:+${contact.primaryPhoneE164}`} class="flex items-start gap-3 text-sm text-paper/75 hover:text-gold-300">
              <Icon name="phone" class="mt-0.5 h-5 w-5 flex-none text-gold-500" />
              <span>
                {contact.primaryPhoneDisplay}
                <br />
                {contact.secondaryPhoneDisplay}
              </span>
            </a>
            <a href={`mailto:${contact.email}`} class="flex items-start gap-3 text-sm text-paper/75 hover:text-gold-300">
              <Icon name="mail" class="mt-0.5 h-5 w-5 flex-none text-gold-500" />
              <span>{contact.email}</span>
            </a>
            <div class="flex items-start gap-3 text-sm text-paper/75">
              <Icon name="map-pin" class="mt-0.5 h-5 w-5 flex-none text-gold-500" />
              <span>{contact.addressLine}</span>
            </div>
          </div>
        </div>

        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="card-lift flex items-center gap-3  border border-[#25D366]/30 bg-[#25D366]/10 p-6 hover:border-[#25D366]/60 hover:bg-[#25D366]/15"
        >
          <span class="icon-pop flex h-11 w-11 flex-none items-center justify-center rounded-full bg-[#25D366] text-white">
            <Icon name="message-circle" class="h-5 w-5" />
          </span>
          <span>
            <span class="block font-heading text-sm font-bold text-paper">Chat on WhatsApp</span>
            <span class="block text-xs text-paper/60">Usually replies within a day</span>
          </span>
        </a>

        <a
          href={whatsappChannelUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="card-lift flex items-center gap-3  border border-gold-500/30 bg-gold-500/5 p-6 hover:border-gold-500/60 hover:bg-gold-500/10"
        >
          <span class="icon-pop flex h-11 w-11 flex-none items-center justify-center rounded-full bg-gold-500 text-ink-950">
            <Icon name="trending-up" class="h-5 w-5" />
          </span>
          <span>
            <span class="block font-heading text-sm font-bold text-paper">Join Our WhatsApp Channel</span>
            <span class="block text-xs text-paper/60">Market updates & academy announcements</span>
          </span>
        </a>

        {
          socials.some((s) => s.url) && (
            <div class=" surface-card p-6">
              <h3 class="font-heading text-lg font-bold text-paper">Follow Us</h3>
              <div class="mt-4 flex gap-3">
                {socials
                  .filter((s) => s.url)
                  .map((s) => (
                    <a
                      href={s.url as string}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={s.name}
                      class="flex h-10 w-10 items-center justify-center rounded-full border border-paper/12 text-paper/70 hover:border-gold-500 hover:text-gold-400"
                    >
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d={socialIcon[s.name]} />
                      </svg>
                    </a>
                  ))}
              </div>
            </div>
          )
        }
      </div>
    </Container>
  </section>
</BaseLayout>
