---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Container from "../components/ui/Container.astro";
import RegisterForm from "../components/forms/RegisterForm.astro";
import JoinAside from "../components/sections/JoinAside.astro";

---

<BaseLayout
  title="Join Now"
  description="Register with Money Door FX Academy — tell us about yourself and we'll help you find the right starting point, or reach us directly on WhatsApp, phone or email."
>
  <PageHero
    eyebrow="Join Now"
    title="Start Your Trading Education"
    subtitle="Register below and we'll be in touch personally about the right program for you. Registration is free, opens no trading account, and involves no payment."
  />

  <section class="surface-ink py-section">
    <Container width="wide" class="grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <div id="register" class="surface-card p-[clamp(1.5rem,3vw,2.75rem)]">
          <h2 class="font-display text-[clamp(1.5rem,1.2rem+1.2vw,2.25rem)] font-medium leading-tight text-paper">
            Join Money Door FX Academy
          </h2>
          <p class="mt-3 max-w-md text-sm leading-relaxed text-paper/60">
            Two short steps. Tell us a bit about yourself and we'll help you find the right
            starting point.
          </p>
          <div class="mt-8">
            <RegisterForm />
          </div>
        </div>
      </div>

      <JoinAside />
    </Container>
  </section>
</BaseLayout>
