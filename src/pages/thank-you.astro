---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon.astro";
---

<BaseLayout title="Thank You" description="Thank you for reaching out to Money Door FX Academy." noindex>
  <section class="flex min-h-[70vh] items-center justify-center bg-ink-950 py-20">
    <Container class="mx-auto flex max-w-lg flex-col items-center gap-5 text-center">
      <span class="flex h-16 w-16 items-center justify-center rounded-full bg-gold-500/10 text-gold-500">
        <Icon name="check-circle" class="h-8 w-8" />
      </span>
      <h1 class="font-heading text-3xl font-bold sm:text-4xl">Thank You</h1>
      <p class="text-base text-paper/70">
        We've received your message and will get back to you shortly. In the meantime, feel free
        to explore our courses or chat with us on WhatsApp.
      </p>
      <div class="flex flex-col gap-3 pt-2 sm:flex-row">
        <Button href="/courses/" arrow>Explore Courses</Button>
        <Button href="/" variant="secondary">Back to Home</Button>
      </div>
    </Container>
  </section>
</BaseLayout>
