# Copy to `.env` for local dev, and set the same values in Vercel's
# Project Settings → Environment Variables for production.
#
# `.env` is gitignored. Never commit real keys, and never prefix a secret with
# PUBLIC_ — Astro inlines PUBLIC_* into the client bundle where anyone can read it.
#
# Nothing here is required for the site to build or for the form to render.
# With these unset, /api/register still validates, still blocks bots, and still
# writes each registration to the server log — it just can't email or store to a
# sheet. See docs/REGISTRATIONS.md for the full setup.

# ---- Email (Resend) -------------------------------------------------------
# https://resend.com → API Keys. Server-side only.
RESEND_API_KEY=

# Must be an address on a domain VERIFIED in Resend, or mail lands in spam.
# Use a real, monitored mailbox — not noreply@.
MAIL_FROM="Money Door FX Academy <hello@yourdomain.com>"

# Where the internal "new registration" notification goes.
OWNER_EMAIL=moneydoor@gmail.com

# Reply-to on the welcome email. Defaults to OWNER_EMAIL when unset.
REPLY_TO=

# ---- Registration storage -------------------------------------------------
# Any endpoint that accepts a JSON POST. Two options:
#   Formspree — https://formspree.io/f/mqpzjvyd  (stores AND emails you; needs
#     no sending domain, so it works before Resend is set up)
#   Google Apps Script — appends a row to a Sheet (see docs/REGISTRATIONS.md)
# Until this is set, records are only written to the platform log.
REGISTRATIONS_WEBHOOK_URL=

# ---- Spam protection (Cloudflare Turnstile) -------------------------------
# https://dash.cloudflare.com → Turnstile. The site key is public by design;
# the secret key must stay server-side.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
